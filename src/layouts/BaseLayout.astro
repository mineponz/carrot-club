---
import {
  SITE_URL,
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  UNOFFICIAL_NOTICE,
  CLUB_PERMISSION_NOTICE,
  CONTACT_FORM_URL,
  DOCUMENT_TITLE,
  ALLOW_INDEXING,
} from '../consts';

interface Props {
  /** ページ固有のタイトル。トップページでは省略する */
  title?: string;
  description?: string;
  /**
   * ヘッダーとtitleに出す説明。既定は最新年度（ルート）向け。
   * 過去年度ページ（`/2025/`）はその年の文言を渡す。
   */
  tagline?: string;
  /** パンくずの中間項目（トップとページ自身は自動で付く） */
  breadcrumb?: { label: string; href: string }[];
  /**
   * パンくず最終項目の表示名。既定は `title`。
   * 個別ページのように title を血統込みで長くしている場合、パンくずには馬名だけ出す。
   */
  breadcrumbLabel?: string;
  /**
   * フッターの「馬一覧へ戻る」の遷移先。既定は最新年度（ルート）。
   * 過去年度ページ（`/2025/`）は自分自身のパスを渡し、最新年度に飛ばされないようにする。
   */
  homeHref?: string;
  /**
   * フッターの広告枠を出すか。既定は出す。
   * トップページ（`/`）は本人の指示で広告を止めているので `false` を渡す。
   */
  showAds?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  tagline = SITE_TAGLINE,
  breadcrumb = [],
  breadcrumbLabel,
  homeHref = '/',
  showAds = true,
} = Astro.props;

// トップは「サイト名｜内容」、下層は「ページ名 | サイト名」。
// 公式と誤認されないよう、タブ・検索結果・SNSカードに出る名前には必ず【非公式】を付ける。
const fullTitle = title ? `${title} | ${DOCUMENT_TITLE}` : `${DOCUMENT_TITLE}｜${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

// クラブの利用許可が下りるまでは noindex（src/consts.ts の ALLOW_INDEXING で切り替える）
const robotsContent = ALLOW_INDEXING ? 'index,follow,max-image-preview:large' : 'noindex,follow';

// OGP画像は public/og-v2.png（1200x630）を絶対URLで参照する。
// 中身は本人のデザイン画像を scripts/generate-og-wide.mjs で横長に組み直したもの。
// サイズを変えたら下の og:image:width / height も直すこと。
//
// **画像を作り替えたらファイル名も必ず変える**（og-v2 → og-v3 …）。X やSNSは画像URL単位で
// キャッシュするため、同じURLのまま中身だけ差し替えても古いカードが出続ける。
// ページURLに ?1 を付けても画像URLは変わらないので効かない。
const ogImage = new URL('/og-v2.png', SITE_URL).href;
const ogImageAlt = `${DOCUMENT_TITLE}｜${tagline}`;

// パンくずの構造化データ。トップ → 中間 → 現在ページ
const crumbs = [
  { label: 'ホーム', href: '/' },
  ...breadcrumb,
  ...(title ? [{ label: breadcrumbLabel ?? title, href: Astro.url.pathname }] : []),
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, SITE_URL).href,
  })),
};

// 構造化データの name も【非公式】付きにする（検索結果に出る名前と食い違わせない）
const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: DOCUMENT_TITLE,
  alternateName: SITE_TAGLINE,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  inLanguage: 'ja',
};

// 実在しない評価・レビュー・利用者数は書かない（aggregateRating等は入れない）。
// 完全無料なので offers は price 0 とする。
const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: DOCUMENT_TITLE,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  browserRequirements: 'JavaScriptが有効なモダンブラウザ',
  inLanguage: 'ja',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'JPY',
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={DOCUMENT_TITLE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HV39111Z5T" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HV39111Z5T');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <p class="brand-line">
        <span class="unofficial-badge">非公式</span>
        <a href="/" class="wordmark">{SITE_TITLE}</a>
      </p>
      <p class="tagline">{tagline}</p>
      <p class="header-permission">{CLUB_PERMISSION_NOTICE}</p>
      <p class="header-notice">{UNOFFICIAL_NOTICE}</p>
    </header>

    {crumbs.length > 1 && (
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i === crumbs.length - 1 ? (
                <span aria-current="page">{c.label}</span>
              ) : (
                <a href={c.href}>{c.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="unofficial">{UNOFFICIAL_NOTICE}</p>
      <p>
        あなたの評価はこの端末のブラウザ内（localStorage）に保存されます。このうち
        <strong>A〜Eの印だけ</strong>を、会員全体の傾向（「みんな」列）を集計するために
        端末ごとの匿名IDとあわせて送信します。<strong>メモ・お気に入り・消は送信しません。</strong>
      </p>
      <p class="permission">{CLUB_PERMISSION_NOTICE}</p>
      <p class="contact">
        ご意見・不具合の報告は
        <a href={CONTACT_FORM_URL} target="_blank" rel="noopener noreferrer">
          お問い合わせフォーム（Googleフォーム）
        </a>
        へどうぞ。
      </p>
      <p class="meta">
        <a href={homeHref}>馬一覧へ戻る</a>
      </p>
      {showAds && (
        <>
          <div class="ad-slot ad-slot-sp">
            <!-- admax -->
            <script is:inline src="https://adm.shinobi.jp/s/8209f8c1f0b6861adf36d20d24ddf5b3"></script>
            <!-- admax -->
          </div>
          <div class="ad-slot ad-slot-pc">
            <!-- admax -->
            <script is:inline src="https://adm.shinobi.jp/s/e63321a780d5a46c4027a2812076c695"></script>
            <!-- admax -->
          </div>
        </>
      )}
    </footer>

    <style is:global>
      :root {
        --bg: #fbfaf7;
        --surface: #ffffff;
        --border: #ddd8cd;
        --text: #23201c;
        --muted: #6b6558;
        --accent: #b5651d;
        --accent-weak: #f5e9dc;
        --danger: #9d2f24;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        --sans: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN",
          "Noto Sans JP", "Yu Gothic", sans-serif;

        /* 評価A〜Eの色。パワプロの能力ランク配色を意識し、最高評価Aをピンクにして
           ピンク→オレンジ→黄→緑→グレーで下るグラデーションにしている
           （Eに向かうほど彩度を落として「特に無し」感を出す）。 */
        --rating-a-bg: #fbd7ea;
        --rating-a-fg: #8a1155;
        --rating-b-bg: #fbdccb;
        --rating-b-fg: #7a3210;
        --rating-c-bg: #faecc4;
        --rating-c-fg: #5a4611;
        --rating-d-bg: #dbe9cf;
        --rating-d-fg: #33501d;
        --rating-e-bg: #e4e2dd;
        --rating-e-fg: #55524c;

        /* 他会員の評価分布（「みんな」列・個別ページ）の棒グラフ用。A〜Eと同じ色相のまま、
           細い棒でも隣の段と見分けが付く明度に振ってある（上の背景色は淡すぎて、
           数ピクセル幅の帯にすると全部同じ色に見える）。
           ライト・ダークどちらの背景に対しても3:1以上のコントラストが出る明度を選んでいるので、
           ダークテーマ側の上書きは持たない。 */
        --rating-a-bar: #d1417f;
        --rating-b-bar: #c26a28;
        --rating-c-bar: #a98a1f;
        --rating-d-bar: #5f8f3e;
        --rating-e-bar: #8a877f;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17181a;
          --surface: #1f2124;
          --border: #34373c;
          --text: #e8e6e1;
          --muted: #9b978f;
          --accent: #e0a45c;
          --accent-weak: #2b241c;
          --danger: #e08278;

          /* ダークでは同じ色相のまま明度を反転させる（背景は沈ませ、文字を明るく） */
          --rating-a-bg: #4a1f38;
          --rating-a-fg: #f5a8cf;
          --rating-b-bg: #47281a;
          --rating-b-fg: #f0b98e;
          --rating-c-bg: #3d351d;
          --rating-c-fg: #dfcb93;
          --rating-d-bg: #2a3a1f;
          --rating-d-fg: #b9d9a0;
          --rating-e-bg: #33322e;
          --rating-e-fg: #cfccc5;
        }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.75;
        -webkit-text-size-adjust: 100%;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        background: var(--surface);
        padding: 0.5rem 0.75rem;
        border: 2px solid var(--accent);
        border-radius: 4px;
      }

      .site-header,
      .breadcrumb,
      main,
      .site-footer {
        max-width: 64rem;
        margin-inline: auto;
        padding-inline: 1.25rem;
      }

      .site-header {
        padding-top: 2.5rem;
        padding-bottom: 1.25rem;
      }

      /* ワードマークは日本語になったので等幅ではなく本文フォントを使う */
      .brand-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        flex-wrap: wrap;
      }
      .wordmark {
        font-family: var(--sans);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text);
        text-decoration: none;
      }
      .wordmark:hover { color: var(--accent); }

      /* クラブ公式と誤認されないよう、サイト名の直前に常に出す */
      .unofficial-badge {
        flex-shrink: 0;
        background: var(--danger);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
      }

      /* ダークテーマの --danger は明るいサーモンなので、白文字だとコントラストが
         2.3:1 程度しか出ずWCAG AA(4.5:1)を満たさない。暗い文字色に反転させる。 */
      @media (prefers-color-scheme: dark) {
        .unofficial-badge { color: #17181a; }
      }

      .tagline {
        margin: 0.15rem 0 0;
        color: var(--muted);
        font-size: 0.875rem;
      }

      .header-permission {
        margin: 0.6rem 0 0;
        font-size: 0.8125rem;
        line-height: 1.6;
        color: var(--text);
        background: var(--accent-weak);
        border-left: 3px solid var(--accent);
        padding: 0.5rem 0.75rem;
        border-radius: 0 4px 4px 0;
      }

      .header-notice {
        margin: 0.6rem 0 0;
        font-size: 0.8125rem;
        line-height: 1.6;
        color: var(--text);
        background: var(--accent-weak);
        border-left: 3px solid var(--danger);
        padding: 0.5rem 0.75rem;
        border-radius: 0 4px 4px 0;
      }

      .breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.8125rem;
        color: var(--muted);
      }
      .breadcrumb li + li::before {
        content: "/";
        margin-right: 0.4rem;
        color: var(--border);
      }
      .breadcrumb a { color: var(--muted); }

      main { padding-block: 1.5rem 3rem; }

      h1 {
        font-size: 1.75rem;
        line-height: 1.35;
        letter-spacing: -0.01em;
        margin: 0.5rem 0 0.75rem;
      }
      h2 {
        font-size: 1.15rem;
        margin-top: 2.5rem;
        margin-bottom: 0.5rem;
      }

      a { color: var(--accent); }

      code, kbd, pre { font-family: var(--mono); font-size: 0.9em; }

      code:not(pre code) {
        background: var(--accent-weak);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }

      .site-footer {
        border-top: 1px solid var(--border);
        padding-block: 1.5rem 3rem;
        color: var(--muted);
        font-size: 0.8125rem;
      }
      .site-footer p { margin: 0 0 0.5rem; }
      .site-footer .unofficial { color: var(--text); font-weight: 600; }
      .site-footer .meta { margin: 0; }
      .site-footer .contact a { color: inherit; }

      /* 忍者AdMaxはPC/SPで別の広告枠コードが発行されるため、画面幅で出し分ける。
         どちらもページ最下部（フッター内）に置く。 */
      .ad-slot { margin-top: 1rem; }
      .ad-slot-pc { display: none; }
      @media (min-width: 48rem) {
        .ad-slot-sp { display: none; }
        .ad-slot-pc { display: block; }
      }

      /* 評価セレクトの色分け（スプレッドシートの条件付き書式のイメージ）。
         表のマークアップは horse-row.ts が年度ページ共通で生成するので、ページ側の
         <style> に置くと年度ぶんだけ同じCSSが増える。ここに1つだけ置いて共有する。
         未評価（data-rating="")は既定の見た目のまま＝色を付けない。
         一覧側は `#horse-table .rating-select` に地の色指定があるので、それに勝つよう id 付きで書く。
         個別ページ（`#eval-panel`）にも同じ色を当てるため並記する。コンポーネント側のスコープ付き
         スタイルに勝つ必要があるので、こちらは id セレクタで詳細度を上げている。 */
      #horse-table .rating-select[data-rating='A'],
      #eval-panel .rating-select[data-rating='A'] { background: var(--rating-a-bg); color: var(--rating-a-fg); }
      #horse-table .rating-select[data-rating='B'],
      #eval-panel .rating-select[data-rating='B'] { background: var(--rating-b-bg); color: var(--rating-b-fg); }
      #horse-table .rating-select[data-rating='C'],
      #eval-panel .rating-select[data-rating='C'] { background: var(--rating-c-bg); color: var(--rating-c-fg); }
      #horse-table .rating-select[data-rating='D'],
      #eval-panel .rating-select[data-rating='D'] { background: var(--rating-d-bg); color: var(--rating-d-fg); }
      #horse-table .rating-select[data-rating='E'],
      #eval-panel .rating-select[data-rating='E'] { background: var(--rating-e-bg); color: var(--rating-e-fg); }
      #horse-table .rating-select:not([data-rating='']),
      #eval-panel .rating-select:not([data-rating='']) {
        font-weight: 700;
        border-color: currentColor;
      }

      /* 他会員の評価分布（src/lib/peer-eval.ts が生成するマークアップ）。
         一覧の「みんな」列は innerHTML で描き直されるためスコープ付きスタイルが効かない。
         個別ページの「他の会員の評価」欄とも見た目を揃えたいので、両方ここに置く。
         強調は「淡い塗り」だけに寄せ、枠線・影は足さない（自分の評価セルと同じ扱い）。 */
      /* 棒と人数は一体で読むものなので、間隔は狭く取る（余白でグルーピングを示す） */
      .peer-eval {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }
      .peer-bar {
        display: inline-flex;
        width: 3.5rem;
        height: 0.5rem;
        border-radius: 999px;
        overflow: hidden;
        background: var(--border);
        flex: none;
      }
      .peer-seg { display: block; }
      .peer-seg[data-rating='A'] { background: var(--rating-a-bar); }
      .peer-seg[data-rating='B'] { background: var(--rating-b-bar); }
      .peer-seg[data-rating='C'] { background: var(--rating-c-bar); }
      .peer-seg[data-rating='D'] { background: var(--rating-d-bar); }
      .peer-seg[data-rating='E'] { background: var(--rating-e-bar); }
      .peer-total {
        color: var(--muted);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
      }
      /* 「まだ0票」「読み込み中」は情報が無い状態なので、色を薄くするのではなく
         背景に近い色まで後退させて、票がある行だけが目に入るようにする */
      .peer-empty,
      .peer-loading { color: var(--border); }

      /* 個別ページ用のA〜E内訳 */
      .peer-breakdown {
        display: grid;
        gap: 0.25rem;
        max-width: 24rem;
        margin-top: 0.5rem;
      }
      .peer-row {
        display: grid;
        grid-template-columns: 1.5rem 1fr 3.5rem;
        align-items: center;
        gap: 0.5rem;
      }
      .peer-key {
        text-align: center;
        font-weight: 700;
        font-size: 0.8125rem;
        border-radius: 4px;
      }
      .peer-key[data-rating='A'] { background: var(--rating-a-bg); color: var(--rating-a-fg); }
      .peer-key[data-rating='B'] { background: var(--rating-b-bg); color: var(--rating-b-fg); }
      .peer-key[data-rating='C'] { background: var(--rating-c-bg); color: var(--rating-c-fg); }
      .peer-key[data-rating='D'] { background: var(--rating-d-bg); color: var(--rating-d-fg); }
      .peer-key[data-rating='E'] { background: var(--rating-e-bg); color: var(--rating-e-fg); }
      .peer-track {
        height: 0.5rem;
        border-radius: 999px;
        overflow: hidden;
        background: var(--border);
      }
      .peer-fill { display: block; height: 100%; }
      .peer-fill[data-rating='A'] { background: var(--rating-a-bar); }
      .peer-fill[data-rating='B'] { background: var(--rating-b-bar); }
      .peer-fill[data-rating='C'] { background: var(--rating-c-bar); }
      .peer-fill[data-rating='D'] { background: var(--rating-d-bar); }
      .peer-fill[data-rating='E'] { background: var(--rating-e-bar); }
      .peer-count {
        text-align: right;
        font-size: 0.8125rem;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .peer-total-note,
      .peer-none {
        color: var(--muted);
        font-size: 0.8125rem;
      }

      /* 棒グラフは aria-hidden なので、同じ内容をテキストでも置いている（読み上げ用） */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>
  </body>
</html>
