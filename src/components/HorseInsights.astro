---
/**
 * 出資馬の個別ページの「データで見る○○」節。分析記事の傾向をその馬の数字に当てはめた項目を並べる
 * （項目は `src/lib/horse-insights.ts` が作る。ここは見た目だけ）。
 *
 * 数字を先に大きく、位置づけと根拠記事を右に。区切りは余白と文字の太さで付け、枠線や左縁の帯は使わない
 * （面は塗りだけ・design playbook 最優先ルール）。
 */
import type { HorseInsight } from '../lib/horse-insights.ts';

interface Props {
  horseName: string;
  /** 分析記事の母集団（「2017〜2025年募集の818頭」）。 */
  poolLabel: string;
  insights: HorseInsight[];
}
const { horseName, poolLabel, insights } = Astro.props;
---

{insights.length > 0 && (
  <section class="insights" aria-labelledby="insights-heading">
    <h2 id="insights-heading">データで見る{horseName}</h2>
    <p class="insights-lead">{poolLabel}を調べた分析記事の傾向に、この馬の数字を当てはめました。</p>
    <ul class="insights-list">
      {insights.map((i) => (
        <li data-insight={i.key}>
          <div class="fig">
            <p class="fig-value">{i.figure}</p>
            <p class="fig-label">{i.figureLabel}</p>
            {i.figureNote && <p class="fig-note">{i.figureNote}</p>}
          </div>
          <div class="txt">
            <p class="body">{i.body}</p>
            {i.article && (
              <p class="src">
                <a href={i.article.href}>{i.article.title} →</a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .insights-lead { margin: 0 0 1rem; color: var(--muted); font-size: 0.875rem; line-height: 1.7; }
  .insights-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .insights-list li {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 1rem;
    background: var(--card);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  .fig, .txt { min-width: 0; }
  .fig p, .txt p { margin: 0; }
  .fig-value { font-size: 1.5rem; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  .fig-label { margin-top: 0.15rem; font-size: 0.8125rem; color: var(--muted); }
  .fig-note { margin-top: 0.15rem; font-size: 0.75rem; color: var(--muted); }
  .body { font-size: 0.9375rem; line-height: 1.8; }
  .src { margin-top: 0.4rem; font-size: 0.8125rem; line-height: 1.6; }
  @media (max-width: 640px) {
    .insights-list li { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
