---
/**
 * 分析記事の目次（h2だけを拾う）。
 *
 * 分析記事は縦に長く、上から順に読まないと何が書いてあるか分からない状態だと
 * 途中で離脱されやすい。先に見出しを一覧で見せて、読みたい節へ飛べるようにする。
 *
 * ## 見出しを引数で受け取らない理由
 * 記事ごとに見出しの配列を書かせると、本文のh2を直したときに片方だけ古くなる
 * （`GradeWinnerTable.astro` の「行の作りは1箇所」と同じ話）。ここでは**描画後のDOMから
 * h2を読んで組み立てる**ので、記事側は `<ArticleToc />` を1行置くだけでよく、
 * 見出しを増減しても勝手に追従する。今後の記事にもそのまま使える。
 *
 * ## no-JS / SEO
 * 目次は本文ではなく案内なので、JSが動かない環境では出さない（`hidden`のまま）。
 * 本文のh2自体は常にHTMLに出ているので、検索エンジンから見た中身は変わらない。
 * 一覧の絞り込みUIを初期`hidden`にしているのと同じ方針。
 *
 * ## アンカーID
 * h2に`id`があればそれを使い、無ければ`section-1`から振る。日本語をIDにするとURLが
 * パーセントエンコードで読みづらくなるため、連番にしている。
 *
 * 固定ヘッダーに見出しが潜らないよう、h2へ`scroll-margin-top`を効かせている。
 */
interface Props {
  /** 目次の見出し。既定は「目次」。 */
  label?: string;
}
const { label = '目次' } = Astro.props;
---

<nav class="toc" aria-labelledby="toc-heading" hidden>
  <p class="toc-heading" id="toc-heading">{label}</p>
  <ol class="toc-list"></ol>
</nav>

<script>
  // 記事本文のh2から目次を組み立てる。h2が2つ未満なら目次の意味が無いので出さない。
  const nav = document.querySelector<HTMLElement>('.toc');
  const list = nav?.querySelector('.toc-list');
  const article = document.querySelector('article');
  if (nav && list && article) {
    const headings = Array.from(article.querySelectorAll('h2'));
    if (headings.length >= 2) {
      headings.forEach((h, i) => {
        if (!h.id) h.id = `section-${i + 1}`;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent?.trim() ?? '';
        li.appendChild(a);
        list.appendChild(li);
      });
      nav.hidden = false;
    }
  }
</script>

<style>
  .toc {
    margin: 1.5rem 0;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .toc-heading {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
  }
  .toc-list {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.9375rem;
  }
  .toc-list li + li {
    margin-top: 0.35rem;
  }
  .toc-list a {
    text-decoration: none;
  }
  .toc-list a:hover,
  .toc-list a:focus-visible {
    text-decoration: underline;
  }
</style>

<style is:global>
  /* 固定ヘッダーの下に見出しが潜らないようにする（目次から飛んだとき用） */
  article h2 {
    scroll-margin-top: 5rem;
  }
</style>
