---
/**
 * 1頭ぶんの個別ページ本体。2026年版（`/2026/horses/{id}/`）と2025年版（`/2025/horses/{id}/`）で共有する。
 *
 * 年度ごとの違いは props（募集年・一覧のURL）だけに閉じ込めている。ページ側にマークアップを
 * コピーすると、年度が増えるたびに同じ修正を2か所に入れることになるため。
 *
 * 評価（A〜E・お気に入り・消・メモ）は一覧ページと**同じlocalStorageキー**
 * （`storageKeyForYear(募集年)`）を読み書きするので、一覧↔個別ページを行き来しても保持される。
 * クライアント側スクリプトはpropsを直接参照できないので、必要な値は data 属性で受け渡す。
 */
import {
  findHorseNeighbors,
  formatMeasurementRank,
  measurementRank,
  sortHorses,
  type Horse,
  type MeasurementKey,
} from '../lib/horses.ts';
import {
  damNameOf,
  formatBirthDateLong,
  googleSearchUrl,
  horsePhotoUrl,
  type RecruitYear,
} from '../lib/horse-meta.ts';
import HorseNav from './HorseNav.astro';
// メモ欄の上限はサーバー側の検証と同じ値（一覧の horse-row.ts と揃える）
import { MAX_MEMO_LENGTH } from '../lib/evaluation-api.ts';
import {
  loadDamRoster,
  loadRecruitsWithResults,
  RACE_RESULTS_FETCHED_AT,
} from '../lib/analysis-data.ts';
import {
  findSiblingRecruits,
  formatResultsAsOf,
  formatSiblingRecord,
  netkeibaHorseId,
} from '../lib/sibling-recruits.ts';
import {
  buildSiblingRoster,
  formatSiblingOwner,
  indexMeasurements,
  hasNonCarrotSibling,
  type RosterMeasurement,
} from '../lib/sibling-roster.ts';
import { horses2026 } from '../data/horses2026.ts';
import { TOUR_WEIGHT_AS_OF, TOUR_WEIGHT_BY_ID } from '../data/tourWeight2026.ts';
import { ENTRY_VOTE_SNAPSHOTS } from '../data/entryVotes2026.ts';
import { LOTTERY_STATUS_SNAPSHOTS } from '../data/lotteryStatus2026.ts';
import { lotteryLabel, lotteryStatusRows } from '../lib/lottery-status.ts';
import { formatDiff } from '../lib/tour-weight-row.ts';
import { formatManYen } from '../lib/chart-math.ts';

interface Props {
  horse: Horse;
  recruitYear: RecruitYear;
  /** その年度の一覧ページ（`/` または `/2025/`） */
  listHref: string;
  /**
   * その年度の全頭。前後の馬・ジャンプ用プルダウン・測尺の順位（母集団＝同じ募集年の全頭）に使う。
   * 年度をまたいで混ぜないこと（No.は年ごとに1から振り直され、測尺の比較対象も年で閉じている）。
   */
  allHorses: Horse[];
  /** その年度の個別ページの接頭辞（`/2026/horses/` または `/2025/horses/`） */
  detailBasePath: string;
}

const { horse, recruitYear, listHref, allHorses, detailBasePath } = Astro.props;
const dam = damNameOf(horse);

/**
 * 馬送り（前の馬・次の馬・プルダウン）。一覧に戻らず隣の馬を見られるようにするためのもの
 * （本人の要望・2026-08-26）。並びは一覧の既定と同じNo.昇順。
 */
const sortedHorses = sortHorses(allHorses, 'id', 'asc');
const { prev: prevHorse, next: nextHorse } = findHorseNeighbors(allHorses, horse.id);

/**
 * 測尺の値に「同じ募集年の全頭中で何位か」を添える。大きい方が1位・同値は同順位。
 * 数字だけでは大きいのか小さいのか読み取れない（体高158cmが平均的なのか大柄なのかは
 * その年の分布次第）ため、順位を並べて出す。
 */
const rankNote = (key: MeasurementKey) =>
  formatMeasurementRank(measurementRank(allHorses, key, horse[key]));

/**
 * 同じ母の産駒（きょうだい）の表。
 *
 * 2026-08-30に**キャロット以外のきょうだいも並べる**ようにした（本人の要望）。それまでは
 * キャロット募集馬だけ（`findSiblingRecruits()`）で、サンデー・シルク・個人馬主に出た産駒が
 * 丸ごと抜けていた。ロスターは母の産駒一覧から作った `analysis/data/dam-siblings.json`。
 *
 * ★測尺（体高・馬体重・胸囲・管囲）はクラブが募集時に公表する数字なので、**キャロット募集馬に
 * しか入らない**。表では「—」になるが、取りこぼしに見えるので必ず注記を出す（本人指定）。
 *
 * 測尺の供給元は年度で分かれている: 2017〜2025年募集は `analysis/data/recruits.json`、
 * 2026年募集は `src/data/horses2026.ts`。両方を `RosterMeasurement` に均してから渡す
 * （2025年のページから見た1歳下の弟妹＝2026年募集馬にも測尺を出すため）。
 */
const recruitPool = loadRecruitsWithResults();
const siblingRecruits = findSiblingRecruits(horse, recruitYear, recruitPool);
const poolYears = [...new Set(recruitPool.map((r) => r.recruitYear))].sort((a, b) => a - b);
const measurementSources: RosterMeasurement[] = [
  ...recruitPool.map((r) => ({
    netkeibaUrl: r.netkeibaUrl,
    recruitYear: r.recruitYear,
    no: r.no,
    name: r.realName,
    height: r.height,
    chestGirth: r.chestGirth,
    caretGirth: r.caretGirth,
    weight: r.weight,
  })),
  ...horses2026.map((h) => ({
    netkeibaUrl: h.netkeibaUrl,
    recruitYear: 2026 as const,
    no: h.id,
    // 2026年募集馬はまだ競走馬登録前なので実名は無い（産駒一覧側の「〇〇の2025」を使う）
    name: null,
    height: h.height,
    chestGirth: h.chestGirth,
    caretGirth: h.caretGirth,
    weight: h.weight,
  })),
];
/**
 * 母の産駒ロスターは母のnetkeiba馬IDで引く。`src/data/horses2025.ts` には母のURLの列が無い
 * （2026年募集ぶんにしかない）ので、無ければ分析用データ側の同じ馬から引き直す。
 * これを入れるまで2025年のページだけキャロット以外のきょうだいが1頭も出なかった。
 */
const selfHorseId = netkeibaHorseId(horse.netkeibaUrl);
const selfInPool = selfHorseId
  ? recruitPool.find((r) => netkeibaHorseId(r.netkeibaUrl) === selfHorseId)
  : undefined;
const damRosterId = netkeibaHorseId(horse.damUrl) ?? netkeibaHorseId(selfInPool?.damUrl);
const damRoster = damRosterId ? loadDamRoster().get(damRosterId) : undefined;
const siblingRows = buildSiblingRoster({
  self: horse,
  selfRecruitYear: recruitYear,
  foals: damRoster?.foals ?? [],
  carrotSiblings: siblingRecruits,
  measurements: indexMeasurements(measurementSources),
});
// 測尺を持っているのはこの年以降のキャロット募集馬だけ（それ以前は分析用データが無い）
const measurableFromYear = poolYears.length > 0 ? poolYears[0] : recruitYear;
const resultsAsOf = formatResultsAsOf(RACE_RESULTS_FETCHED_AT);
// きょうだいの中で一番稼いでいる馬だけ太字にする（本人希望・2026-08-23）。獲得賞金が取れて
// いない馬しかいない場合は誰も強調しない（0円と未取得を混同しないよう、nullは比較から除く）。
// 本馬（まだ走っていない）は比較に入れない。
const topEarnerIndex = siblingRows.reduce((best, row, i) => {
  if (row.isSelf || row.totalPrizeManYen == null) return best;
  const bestPrize = best < 0 ? -1 : (siblingRows[best].totalPrizeManYen ?? -1);
  return row.totalPrizeManYen > bestPrize ? i : best;
}, -1);
// 父が「—」になる馬（産駒一覧に父の列が無かった等）がいるときだけ理由を注記する
const hasUnknownSire = siblingRows.some((row) => !row.sire);
const showNonCarrotNote = hasNonCarrotSibling(siblingRows);
// 古すぎて測尺のデータが無いキャロット馬（2017年より前の募集）がいるときだけ、その断りを出す
const hasOldCarrotSibling = siblingRows.some(
  (row) => row.club === 'carrot' && !row.isSelf && row.height == null
);
/** 誕生日は年まで出す（きょうだいは生年がばらばらで、MM/DDだけでは何歳か分からない）。 */
const formatRowBirthDate = (birthDate: string | null, birthYear: number) =>
  birthDate ? birthDate.replaceAll('-', '/') : `${birthYear}年`;

/**
 * 馬体写真はクラブ公式サイトの命名規則が2026年募集ぶんでしか実アクセス確認できていないため、
 * 2026年募集ページにのみ出す（詳細は horsePhotoUrl のコメント参照）。
 */
const photoUrl = recruitYear === 2026 ? horsePhotoUrl(horse) : null;

/**
 * ツアー後馬体重（クラブ公式PDF・`src/data/tourWeight2026.ts`）。今のところ2026年募集にしか
 * 情報源が無いので、それ以外の年度では出さない。No.62のようにPDF側が未計測の馬もいる。
 */
const tourWeight = recruitYear === 2026 ? (TOUR_WEIGHT_BY_ID[horse.id] ?? null) : null;
const tourWeightDiff = tourWeight === null ? null : tourWeight - horse.weight;

/**
 * 募集申込票数の中間発表（クラブ公式・`src/data/entryVotes2026.ts`）。2026年募集にしか
 * 情報源が無く、かつクラブは票数が多い馬だけを掲載するので、その馬が掲載された回の分だけ
 * facts 行になる（未掲載・未発表なら0行）。全体を並べた表は `/2026/votes/`。
 */
const entryVoteFacts =
  recruitYear === 2026
    ? ENTRY_VOTE_SNAPSHOTS.flatMap((snap) => {
        const entry = snap.byId[horse.id];
        if (!entry) return [];
        // 母優先より最優先を重視する指標なので先に出す（votes.astro の表示順と揃える）
        const breakdown = [
          entry.topPriority != null ? `最優 ${entry.topPriority}` : null,
          entry.damPriority != null ? `母優 ${entry.damPriority}` : null,
        ].filter((s): s is string => s !== null);
        return [
          {
            term: `申込票数（${snap.asOf}・${snap.label}）`,
            value: `${entry.total}票`,
            note: breakdown.length > 0 ? `（${breakdown.join('・')}）` : undefined,
          },
        ];
      })
    : [];

/**
 * 抽選ステータス（クラブ公式「抽選ランク発表」・`src/data/lotteryStatus2026.ts`）。2026年募集にしか
 * 情報源が無い。母馬優先枠の対象馬は「抽選ステータス（母馬優先）」「抽選ステータス（通常枠）」の
 * 2行、対象外は「抽選ステータス」の1行にする（本人合意・2026-09-05）。残り口数が分かっていれば
 * 追加で1行足す。全頭を並べた表は `/2026/lottery/`。
 */
const lotteryFacts: { term: string; value: string }[] =
  recruitYear === 2026
    ? (() => {
        const [row] = lotteryStatusRows([horse], LOTTERY_STATUS_SNAPSHOTS);
        const labelOf = (frame: (typeof row)['normal']) =>
          frame === null ? '発表待ち' : lotteryLabel(frame).text;
        const rows = row.hasDamPriority
          ? [
              { term: '抽選ステータス（母馬優先）', value: labelOf(row.damPriority) },
              { term: '抽選ステータス（通常枠）', value: labelOf(row.normal) },
            ]
          : [{ term: '抽選ステータス', value: labelOf(row.normal) }];
        if (row.remainingShares !== null) {
          rows.push({ term: '残り口数', value: `${row.remainingShares}口` });
        }
        return rows;
      })()
    : [];

/**
 * 定義リストに出す項目。値が無いものは出さない（空欄の行を並べても情報にならない）。
 * `note` は値に添える補足（測尺の順位）。値そのものより弱く見せたいので別に持つ。
 */
const facts: { term: string; value: string; note?: string }[] = [
  { term: '性別', value: horse.sex },
  { term: '父', value: horse.sire },
  { term: '母', value: dam },
  { term: '母父', value: horse.broodmareSire },
  { term: '母齢', value: `${horse.damAge}` },
  { term: '産次', value: `${horse.damParity}番仔` },
  { term: '誕生日', value: formatBirthDateLong(horse.birthDate) },
  { term: '厩舎', value: horse.stable },
  { term: '一口価格', value: `${horse.pricePerShare}万円` },
  { term: '体高', value: `${horse.height}cm`, note: rankNote('height') },
  { term: '胸囲', value: `${horse.chestGirth}cm`, note: rankNote('chestGirth') },
  { term: '管囲', value: `${horse.caretGirth}cm`, note: rankNote('caretGirth') },
  { term: '馬体重（募集時）', value: `${horse.weight}kg`, note: rankNote('weight') },
  ...(recruitYear === 2026
    ? [
        {
          term: 'ツアー後馬体重',
          value: tourWeight === null ? '未計測' : `${tourWeight}kg`,
          note: tourWeight === null ? undefined : `（${TOUR_WEIGHT_AS_OF}）`,
        },
        {
          term: '募集時からの増減',
          value: tourWeightDiff === null ? '未計測' : `${formatDiff(tourWeightDiff)}kg`,
        },
      ]
    : []),
  ...entryVoteFacts,
  { term: '兄弟', value: horse.sibling },
  { term: '母優先', value: horse.damPriority ? '対象' : '対象外' },
  ...lotteryFacts,
];
---

<article class="horse-detail">
  <p class="back-link"><a href={listHref}>← {recruitYear}年募集馬の一覧へ戻る</a></p>
  <HorseNav
    horse={horse}
    sortedHorses={sortedHorses}
    prev={prevHorse}
    next={nextHorse}
    detailBasePath={detailBasePath}
    recruitYear={recruitYear}
  />

  <h1>{horse.name}</h1>
  <p class="lead">
    キャロットクラブ{recruitYear}年募集馬（募集番号{horse.id}）。父{horse.sire}・母{dam}（母父{
      horse.broodmareSire
    }）。
  </p>

  {
    photoUrl && (
      /* 写真が未掲載の馬もいるので、読み込み失敗時はfigureごと隠す（このサイトはCSP未導入なので
         onerror属性が素直に使える）。 */
      <figure class="horse-photo">
        <img src={photoUrl} alt={`${horse.name}の馬体写真`} loading="eager" referrerpolicy="no-referrer" onerror="this.closest('figure').hidden = true" />
        <figcaption>キャロットクラブ公式サイトの馬体写真</figcaption>
      </figure>
    )
  }

  <dl class="fact-list">
    {
      facts.map((f) => (
        <div class="fact">
          <dt>{f.term}</dt>
          <dd>
            {f.value || '—'}
            {f.note && <span class="fact-note">{f.note}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  {
    recruitYear === 2026 && (
      <p class="note tour-weight-link">
        全頭の募集時馬体重とツアー後馬体重の比較は<a href="/2026/tour-weight/">こちら</a>。
      </p>
    )
  }
  {
    recruitYear === 2026 && (
      <p class="note votes-link">
        全頭の募集申込票数（中間発表）の一覧は<a href="/2026/votes/">こちら</a>。
      </p>
    )
  }
  {
    recruitYear === 2026 && (
      <p class="note lottery-link">
        全頭の抽選ステータスの一覧は<a href="/2026/lottery/">こちら</a>。
      </p>
    )
  }

  {
    horse.surgery && (
      <section class="surgery-note">
        <h2>手術・既往</h2>
        {/* クラブ公式の記載をそのまま出す。改行は行として保つ */}
        {horse.surgery.split('\n').map((line) => (
          <p>{line}</p>
        ))}
      </section>
    )
  }

  {
    siblingRows.length > 1 && (
      <section class="sibling-recruits">
        <h2>きょうだい</h2>
        <p class="note">
          netkeibaの母{dam}の産駒一覧をもとにした、同じ母の産駒（きょうだい）です。
          キャロット以外のクラブ・個人馬主に出た産駒も並べています。生年の新しい順。
          表の中の「本馬」の行が{horse.name}自身です。
          通算成績・獲得賞金（中央+地方）は{resultsAsOf ? `${resultsAsOf}時点` : '取得時点'}のものです。
        </p>
        <div class="table-scroll">
          <table class="sibling-table">
            <thead>
              <tr>
                <th>馬名</th>
                <th>父</th>
                <th>牡牝</th>
                <th>誕生日</th>
                <th>体高</th>
                <th>馬体重</th>
                <th>胸囲</th>
                <th>管囲</th>
                <th>通算成績</th>
                <th>獲得賞金</th>
                <th>所属</th>
              </tr>
            </thead>
            <tbody>
              {siblingRows.map((row, i) => {
                const record = formatSiblingRecord(row);
                return (
                  <tr class:list={[{ 'top-earner': i === topEarnerIndex, self: row.isSelf }]}>
                    <td>
                      {/* 自身の行（「本馬」）は今見ているページなのでリンクにしない。
                          きょうだいはサイト内の個別ページではなくnetkeibaへ飛ばす
                          （キャロット以外の馬はサイト内にページが無く、行によって飛び先が
                          変わると分かりにくいため。本人指定・2026-08-30）。 */}
                      {!row.isSelf && row.netkeibaUrl ? (
                        <a href={row.netkeibaUrl} target="_blank" rel="noopener">
                          {row.name}
                        </a>
                      ) : (
                        row.name
                      )}
                    </td>
                    <td>{row.sire || '—'}</td>
                    <td>{row.sex || '—'}</td>
                    <td>{formatRowBirthDate(row.birthDate, row.birthYear)}</td>
                    <td>{row.height == null ? '—' : `${row.height}cm`}</td>
                    <td>{row.weight == null ? '—' : `${row.weight}kg`}</td>
                    <td>{row.chestGirth == null ? '—' : `${row.chestGirth}cm`}</td>
                    <td>{row.caretGirth == null ? '—' : `${row.caretGirth}cm`}</td>
                    <td>{record ?? '—'}</td>
                    <td>{row.totalPrizeManYen == null ? '—' : `${formatManYen(row.totalPrizeManYen)}万円`}</td>
                    <td>{formatSiblingOwner(row)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {/* 測尺の空欄は取りこぼしではなく「そもそも公表が無い」ことを必ず説明する（本人指定） */}
        <p class="table-note">
          測尺（体高・馬体重・胸囲・管囲）は<strong>キャロットが募集時に公表した値</strong>なので、
          キャロット募集馬の行にだけ入ります。
          {showNonCarrotNote && '他クラブ・個人馬主の馬は公表が無いため「—」です。'}
          {hasOldCarrotSibling &&
            `キャロット募集馬でも${measurableFromYear}年より前に募集された馬は手元にデータが無く「—」です。`}
        </p>
        {topEarnerIndex >= 0 && <p class="table-note">太字はきょうだいの中で獲得賞金が最も多い馬。</p>}
        {hasUnknownSire && (
          <p class="table-note">父が「—」の馬は、netkeibaの産駒一覧にも個体ページにも父を確認できなかった馬です。</p>
        )}
      </section>
    )
  }

  <h2>この馬を調べる</h2>
  <ul class="external-links">
    <li>
      <a href={horse.netkeibaUrl} target="_blank" rel="noopener">netkeibaで{horse.name}を見る</a>
    </li>
    {
      horse.damUrl && (
        <li>
          <a href={horse.damUrl} target="_blank" rel="noopener">
            netkeibaで母{dam}を見る（産駒成績）
          </a>
        </li>
      )
    }
    <li>
      <a href={horse.xSearchUrl} target="_blank" rel="noopener">Xで「{dam}」を検索する</a>
    </li>
    {/* 検索語は募集馬名そのまま（「ハープスターの25」）。本人指定・2026-08-31 */}
    <li>
      <a href={googleSearchUrl(horse.name)} target="_blank" rel="noopener">
        Googleで「{horse.name}」を検索する
      </a>
    </li>
  </ul>

  <h2>自分の評価</h2>
  <p class="note">
    入力した内容はこの端末のブラウザ内（localStorage）に保存され、一覧ページと共有されます。
    あわせて、端末を移っても引き継げるように匿名の同期IDに紐づけて控えを保存します
    （<a href={listHref}>一覧ページ</a>の「評価を別の端末に引き継ぐ」から扱えます）。
    ほかの会員に公開されることはありません。
  </p>
  <div class="eval-panel" id="eval-panel" data-horse-id={horse.id} data-recruit-year={recruitYear}>
    <label class="eval-item">
      評価
      <select class="rating-select" id="detail-rating" data-rating="">
        <option value="">-</option>
        <option value="A">A</option>
        <option value="B">B</option>
        <option value="C">C</option>
        <option value="D">D</option>
        <option value="E">E</option>
      </select>
    </label>
    <button type="button" class="favorite-btn" id="detail-favorite" aria-pressed="false" title="お気に入り">
      ★ お気に入り
    </button>
    <label class="eval-item checkbox">
      <input type="checkbox" id="detail-skip" /> 消（検討から外す）
    </label>
    <label class="eval-item memo">
      メモ
      {/* 改行して書きたい（本人の指示・2026-08-23）ので1行のinputではなくtextareaにする。
          保存先・上限は一覧のメモ欄と同じ（改行ぶんも maxlength に含まれる）。 */}
      <textarea class="memo-input" id="detail-memo" rows="3" placeholder="メモ" maxlength={MAX_MEMO_LENGTH}></textarea>
    </label>
  </div>

  <p class="back-link bottom"><a href={listHref}>← {recruitYear}年募集馬の一覧へ戻る</a></p>
  {/* 読み終えた位置からそのまま次の馬へ行けるよう、下にも同じ馬送りを置く */}
  <HorseNav
    horse={horse}
    sortedHorses={sortedHorses}
    prev={prevHorse}
    next={nextHorse}
    detailBasePath={detailBasePath}
    recruitYear={recruitYear}
  />
</article>

