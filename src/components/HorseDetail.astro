---
/**
 * 1頭ぶんの個別ページ本体。2026年版（`/horses/{id}/`）と2025年版（`/2025/horses/{id}/`）で共有する。
 *
 * 年度ごとの違いは props（募集年・一覧のURL）だけに閉じ込めている。ページ側にマークアップを
 * コピーすると、年度が増えるたびに同じ修正を2か所に入れることになるため。
 *
 * 評価（A〜E・お気に入り・消・メモ）は一覧ページと**同じlocalStorageキー**
 * （`storageKeyForYear(募集年)`）を読み書きするので、一覧↔個別ページを行き来しても保持される。
 * クライアント側スクリプトはpropsを直接参照できないので、必要な値は data 属性で受け渡す。
 */
import type { Horse } from '../lib/horses.ts';
import { damNameOf, formatBirthDateLong, horsePhotoUrl, type RecruitYear } from '../lib/horse-meta.ts';
// メモ欄の上限はサーバー側の検証と同じ値（一覧の horse-row.ts と揃える）
import { MAX_MEMO_LENGTH } from '../lib/evaluation-api.ts';
import { loadRecruitsWithResults, RACE_RESULTS_FETCHED_AT } from '../lib/analysis-data.ts';
import {
  buildMeasurementRows,
  findSiblingRecruits,
  formatResultsAsOf,
  formatSiblingRecord,
  siblingDetailHref,
} from '../lib/sibling-recruits.ts';
import { formatManYen } from '../lib/chart-math.ts';

interface Props {
  horse: Horse;
  recruitYear: RecruitYear;
  /** その年度の一覧ページ（`/` または `/2025/`） */
  listHref: string;
}

const { horse, recruitYear, listHref } = Astro.props;
const dam = damNameOf(horse);

/**
 * 同じ母の産駒で、過去にキャロットで募集された馬（＝クラブ内の兄姉）。
 * 兄姉が同じクラブにいれば、募集時の測尺とその後の成績を同じ物差しで見比べられる。
 * 突き合わせ元は分析用の `analysis/data/`（年範囲は年によって増えるため、ハードコードせず
 * 下の`recruitPool`から動的に出す。2026-08-23、2017〜2020年募集分の追加で
 * 「2021〜2025年募集ぶん」という本文の決め打ちが古くなっていたことが判明した）。
 */
const recruitPool = loadRecruitsWithResults();
const siblingRecruits = findSiblingRecruits(horse, recruitYear, recruitPool);
const poolYears = [...new Set(recruitPool.map((r) => r.recruitYear))].sort((a, b) => a - b);
const poolYearRangeLabel =
  poolYears.length > 0 ? `${poolYears[0]}〜${poolYears[poolYears.length - 1]}年` : '';
const resultsAsOf = formatResultsAsOf(RACE_RESULTS_FETCHED_AT);
// 兄姉の中で一番稼いでいる馬だけ太字にする（本人希望・2026-08-23）。獲得賞金が取れていない
// 馬しかいない場合は誰も強調しない（0円と未取得を混同しないよう、nullは比較から除く）。
// No.は年をまたぐと重複しうるので、キーは「募集年-No.」の組で持つ。
const siblingKey = (s: { recruitYear: number; no: string }) => `${s.recruitYear}-${s.no}`;
const topSiblingPrize = Math.max(
  -1,
  ...siblingRecruits.map((s) => s.totalPrizeManYen).filter((v): v is number => v != null)
);
const topSiblingKey =
  topSiblingPrize >= 0
    ? siblingKey(siblingRecruits.find((s) => s.totalPrizeManYen === topSiblingPrize)!)
    : undefined;
/**
 * 表にはその馬自身も1行目として並べる（本人希望・2026-08-23）。上の定義リストと兄姉の表を
 * 目で往復しなくても、同じ列で測尺の大小を追えるようにするため。自身はまだ走っていないので
 * 成績・賞金は空で、`topSiblingKey`（賞金最多）の判定にも入らない。
 */
const measurementRows = buildMeasurementRows(horse, recruitYear, siblingRecruits);
// ごく一部（2017〜2020年募集分のうちnetkeiba個体ページを特定できなかった3頭）は父が
// 取れていない。「—」だけ出ていると取りこぼしに見えるので、そういう兄姉がいるときだけ
// 理由を注記する（2026-08-23、netkeibaの血統表ページから追加取得して345/348頭は埋めた）。
const hasUnknownSire = measurementRows.some((row) => !row.sire);

/**
 * 馬体写真はクラブ公式サイトの命名規則が2026年募集ぶんでしか実アクセス確認できていないため、
 * 2026年募集ページにのみ出す（詳細は horsePhotoUrl のコメント参照）。
 */
const photoUrl = recruitYear === 2026 ? horsePhotoUrl(horse) : null;

/** 定義リストに出す項目。値が無いものは出さない（空欄の行を並べても情報にならない）。 */
const facts: { term: string; value: string }[] = [
  { term: '性別', value: horse.sex },
  { term: '父', value: horse.sire },
  { term: '母', value: dam },
  { term: '母父', value: horse.broodmareSire },
  { term: '母齢', value: `${horse.damAge}` },
  { term: '産次', value: `${horse.damParity}番仔` },
  { term: '誕生日', value: formatBirthDateLong(horse.birthDate) },
  { term: '厩舎', value: horse.stable },
  { term: '一口価格', value: `${horse.pricePerShare}万円` },
  { term: '体高', value: `${horse.height}cm` },
  { term: '胸囲', value: `${horse.chestGirth}cm` },
  { term: '管囲', value: `${horse.caretGirth}cm` },
  { term: '馬体重', value: `${horse.weight}kg` },
  { term: '兄弟', value: horse.sibling },
  { term: '母優先', value: horse.damPriority ? '対象' : '対象外' },
];
---

<article class="horse-detail">
  <p class="back-link"><a href={listHref}>← {recruitYear}年募集馬の一覧へ戻る</a></p>

  <h1>{horse.name}</h1>
  <p class="lead">
    キャロットクラブ{recruitYear}年募集馬（募集番号{horse.id}）。父{horse.sire}・母{dam}（母父{
      horse.broodmareSire
    }）。
  </p>

  {
    photoUrl && (
      /* 写真が未掲載の馬もいるので、読み込み失敗時はfigureごと隠す（このサイトはCSP未導入なので
         onerror属性が素直に使える）。 */
      <figure class="horse-photo">
        <img src={photoUrl} alt={`${horse.name}の馬体写真`} loading="eager" referrerpolicy="no-referrer" onerror="this.closest('figure').hidden = true" />
        <figcaption>キャロットクラブ公式サイトの馬体写真</figcaption>
      </figure>
    )
  }

  <dl class="fact-list">
    {
      facts.map((f) => (
        <div class="fact">
          <dt>{f.term}</dt>
          <dd>{f.value || '—'}</dd>
        </div>
      ))
    }
  </dl>

  {
    horse.surgery && (
      <section class="surgery-note">
        <h2>手術・既往</h2>
        {/* クラブ公式の記載をそのまま出す。改行は行として保つ */}
        {horse.surgery.split('\n').map((line) => (
          <p>{line}</p>
        ))}
      </section>
    )
  }

  {
    siblingRecruits.length > 0 && (
      <section class="sibling-recruits">
        <h2>キャロットにいる兄姉</h2>
        <p class="note">
          同じ母の産駒で、過去にキャロットクラブで募集された馬です。募集時の測尺と、
          {resultsAsOf ? `${resultsAsOf}時点` : '取得時点'}の通算成績・獲得賞金（中央+地方）を出しています。
          突き合わせているのは{poolYearRangeLabel}募集ぶんなので、それ以前に募集された兄姉は出ません。
          1行目の「本馬」が{horse.name}自身で、兄姉と同じ列に並べて測尺を見比べられるようにしています。
        </p>
        <div class="table-scroll">
          <table class="sibling-table">
            <thead>
              <tr>
                <th>馬名</th>
                <th>父</th>
                <th>体高</th>
                <th>胸囲</th>
                <th>管囲</th>
                <th>馬体重</th>
                <th>通算成績</th>
                <th>獲得賞金</th>
                <th>募集年</th>
              </tr>
            </thead>
            <tbody>
              {measurementRows.map((row) => {
                const href = row.isSelf ? null : siblingDetailHref(row);
                const record = formatSiblingRecord(row);
                const isTop = siblingKey(row) === topSiblingKey;
                return (
                  <tr class:list={[{ 'top-earner': isTop, self: row.isSelf }]}>
                    <td>
                      {/* 自身の行（「本馬」）は今見ているページなのでリンクにしない */}
                      {href ? (
                        <a href={href}>{row.name}</a>
                      ) : !row.isSelf && row.netkeibaUrl ? (
                        <a href={row.netkeibaUrl} target="_blank" rel="noopener">
                          {row.name}
                        </a>
                      ) : (
                        row.name
                      )}
                    </td>
                    <td>{row.sire || '—'}</td>
                    <td>{row.height == null ? '—' : `${row.height}cm`}</td>
                    <td>{row.chestGirth == null ? '—' : `${row.chestGirth}cm`}</td>
                    <td>{row.caretGirth == null ? '—' : `${row.caretGirth}cm`}</td>
                    <td>{row.weight == null ? '—' : `${row.weight}kg`}</td>
                    <td>{record ?? '—'}</td>
                    <td>{row.totalPrizeManYen == null ? '—' : `${formatManYen(row.totalPrizeManYen)}万円`}</td>
                    {/* 募集年は見比べる主役ではない（測尺と成績のほう）ので右端に置く（本人希望） */}
                    <td>{row.recruitYear}年 No.{row.no}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {topSiblingKey && <p class="table-note">太字は兄姉の中で獲得賞金が最も多い馬。</p>}
        {hasUnknownSire && (
          <p class="table-note">父が「—」の兄姉は、募集当時の一覧にも個体ページにも父を確認できなかった馬です。</p>
        )}
      </section>
    )
  }

  <h2>この馬を調べる</h2>
  <ul class="external-links">
    <li>
      <a href={horse.netkeibaUrl} target="_blank" rel="noopener">netkeibaで{horse.name}を見る</a>
    </li>
    {
      horse.damUrl && (
        <li>
          <a href={horse.damUrl} target="_blank" rel="noopener">
            netkeibaで母{dam}を見る（産駒成績）
          </a>
        </li>
      )
    }
    <li>
      <a href={horse.xSearchUrl} target="_blank" rel="noopener">Xで「{dam}」を検索する</a>
    </li>
  </ul>

  <h2>自分の評価</h2>
  <p class="note">
    入力した内容はこの端末のブラウザ内（localStorage）に保存され、一覧ページと共有されます。
    あわせて、端末を移っても引き継げるように匿名の同期IDに紐づけて控えを保存します
    （<a href={listHref}>一覧ページ</a>の「評価を別の端末に引き継ぐ」から扱えます）。
    ほかの会員に公開されることはありません。
  </p>
  <div class="eval-panel" id="eval-panel" data-horse-id={horse.id} data-recruit-year={recruitYear}>
    <label class="eval-item">
      評価
      <select class="rating-select" id="detail-rating" data-rating="">
        <option value="">-</option>
        <option value="A">A</option>
        <option value="B">B</option>
        <option value="C">C</option>
        <option value="D">D</option>
        <option value="E">E</option>
      </select>
    </label>
    <button type="button" class="favorite-btn" id="detail-favorite" aria-pressed="false" title="お気に入り">
      ★ お気に入り
    </button>
    <label class="eval-item checkbox">
      <input type="checkbox" id="detail-skip" /> 消（検討から外す）
    </label>
    <label class="eval-item memo">
      メモ
      {/* 改行して書きたい（本人の指示・2026-08-23）ので1行のinputではなくtextareaにする。
          保存先・上限は一覧のメモ欄と同じ（改行ぶんも maxlength に含まれる）。 */}
      <textarea class="memo-input" id="detail-memo" rows="3" placeholder="メモ" maxlength={MAX_MEMO_LENGTH}></textarea>
    </label>
  </div>

  <p class="back-link bottom"><a href={listHref}>← {recruitYear}年募集馬の一覧へ戻る</a></p>
</article>

<style>
  .back-link {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }
  .back-link.bottom {
    margin-top: 2.5rem;
  }
  .lead {
    color: var(--muted);
    margin-top: 0;
  }
  .note {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .horse-photo {
    margin: 1rem 0 0;
  }
  .horse-photo img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .horse-photo figcaption {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* 1項目1行の縦積みだと縦に間延びするので、狭い画面でも2列以上に並ぶグリッドにする */
  .fact-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.75rem 1rem;
    margin: 1.5rem 0 0;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .fact dt {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .fact dd {
    margin: 0.1rem 0 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .surgery-note p {
    margin: 0 0 0.25rem;
    color: var(--danger);
  }

  .sibling-recruits .note {
    margin-bottom: 0.75rem;
  }
  /* どの兄姉がどんな測尺で走っているか一覧で見比べたい、という本人希望で表形式にした
     （2026-08-23、カード形式から変更）。横に長いので狭い画面ではスクロールさせる。 */
  .table-scroll {
    overflow-x: auto;
    margin: 0.5rem 0;
  }
  table.sibling-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  table.sibling-table th,
  table.sibling-table td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  table.sibling-table th {
    color: var(--muted);
    font-weight: 600;
  }
  /* 横スクロールしても「どの馬の行か」を見失わないよう、馬名の列だけ左端に固定する
     （一覧の表と同じ扱い。本人希望・2026-08-23）。固定列は背景を塗らないと、下を流れる
     列が透けて重なって見える。境目は罫線だと表の他の線と紛れるので弱い影にする。 */
  table.sibling-table th:first-child,
  table.sibling-table td:first-child {
    position: sticky;
    left: 0;
    /* 表はページ背景の上に直接置いているので、固定列も同じ --bg で塗る
       （--surface だと馬名列だけ白く浮いて別の表に見える） */
    background: var(--bg);
    z-index: 1;
    box-shadow: 6px 0 5px -5px rgb(0 0 0 / 0.28);
  }
  /* その馬自身の行。兄姉の中に埋もれないよう色を敷く。固定列のセルも同じ色にしないと
     （既定の --surface のままだと）左端だけ色が切れて別の行に見える。 */
  table.sibling-table tr.self td,
  table.sibling-table tr.self td:first-child {
    background: var(--accent-weak);
    font-weight: 700;
  }
  /* 兄姉の中で獲得賞金が最も多い1頭だけ強調する（本人希望） */
  table.sibling-table tr.top-earner td {
    font-weight: 700;
  }
  .table-note {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .external-links {
    padding-left: 1.1rem;
  }
  .external-links li {
    margin-bottom: 0.35rem;
  }

  .eval-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    font-size: 0.875rem;
  }
  .eval-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--muted);
  }
  .eval-item.checkbox {
    flex-direction: row;
    align-items: center;
    gap: 0.35rem;
  }
  .eval-item.memo {
    flex: 1 1 16rem;
  }
  .eval-panel .rating-select,
  .eval-panel .memo-input {
    font: inherit;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
  }
  .eval-panel .memo-input {
    width: 100%;
    /* 横に伸ばされるとパネルの他の項目が押し出されるので、伸ばせるのは縦だけにする */
    resize: vertical;
  }
  .eval-panel .favorite-btn {
    font: inherit;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    color: var(--muted);
  }
  .eval-panel .favorite-btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 700;
  }
</style>

<script>
  import {
    loadEvaluations,
    saveEvaluations,
    getEvaluation,
    updateEvaluation,
    storageKeyForYear,
    type Evaluation,
    type EvaluationMap,
  } from '../lib/evaluations.ts';
  import { queueEvaluationSync } from '../lib/evaluation-client.ts';

  // 年度・馬IDはビルド時にしか分からないので data 属性経由で受け取る
  const panel = document.getElementById('eval-panel') as HTMLElement;
  const horseId = panel.dataset.horseId!;
  const recruitYear = Number(panel.dataset.recruitYear);
  const storageKey = storageKeyForYear(recruitYear);

  const rating = document.getElementById('detail-rating') as HTMLSelectElement;
  const favorite = document.getElementById('detail-favorite') as HTMLButtonElement;
  const skip = document.getElementById('detail-skip') as HTMLInputElement;
  // メモは改行できるよう textarea（value の読み書きは input と同じ）
  const memo = document.getElementById('detail-memo') as HTMLTextAreaElement;

  let evaluations: EvaluationMap = loadEvaluations(window.localStorage, storageKey);

  // 保存済みの内容を初期表示に反映する（一覧で付けた評価がここでも見える）
  const current = getEvaluation(evaluations, horseId);
  rating.value = current.rating ?? '';
  rating.dataset.rating = current.rating ?? '';
  favorite.setAttribute('aria-pressed', String(current.favorite));
  skip.checked = current.skip;
  memo.value = current.memo;

  /** localStorage（正本）に保存し、同じ内容を端末間同期へ回す（一覧ページと同じ扱い） */
  function persist(patch: Partial<Evaluation>) {
    evaluations = updateEvaluation(evaluations, horseId, patch);
    saveEvaluations(window.localStorage, storageKey, evaluations);
    queueEvaluationSync(recruitYear, horseId, getEvaluation(evaluations, horseId));
  }

  rating.addEventListener('change', () => {
    // 背景色はCSSの [data-rating] で当てているので属性も更新する（一覧側と同じ扱い）
    rating.dataset.rating = rating.value;
    const value = rating.value ? (rating.value as Evaluation['rating']) : null;
    persist({ rating: value });
  });
  favorite.addEventListener('click', () => {
    const pressed = favorite.getAttribute('aria-pressed') === 'true';
    favorite.setAttribute('aria-pressed', String(!pressed));
    persist({ favorite: !pressed });
  });
  skip.addEventListener('change', () => persist({ skip: skip.checked }));
  // メモは blur を待たず入力のたびに保存する（一覧側と同じ理由: 離脱で失われないように）
  memo.addEventListener('input', () => persist({ memo: memo.value }));
</script>
