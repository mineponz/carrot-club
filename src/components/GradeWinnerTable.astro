---
/**
 * 分析記事の「重賞を勝った馬」の表。
 *
 * 2017〜2020年募集分を足して対象が818頭になり、重賞馬も44頭まで増えたため、記事側では
 * 上位ぶんだけ出して残りを折りたたむ（表がスマホで画面数ぶんの長さになっていた・2026-08-23）。
 * その2つは同じ形の表なので、行の作りはここに1つだけ置く ―― 呼び出し側に2回書くと、
 * 列を足したときに片方だけ直して表がずれる。
 *
 * 誕生月・馬体重列は誕生月記事（birth-month.astro）のために追加（2026-08-24）。胸囲列は
 * 胸囲記事（chest-girth.astro）のために追加（2026-08-25）。他の記事（height.astro・
 * dam-age.astro・birth-month.astro）にも同じ表を使っているので、そちらにも自動的に反映される。
 *
 * 回収率列（＝獲得賞金合計 ÷ 募集総額）は`showRoi`がtrueの時だけ出す（既定false）。
 * この比率は賞金の額面ベースで、管理費・維持費・引退時の売却額を差し引いた実際の会員配当額
 * ではなく規模感の目安に過ぎず、その注記は胸囲記事の本文にしか無いため、注記の無い他記事に
 * まで数字だけ出ると出資リターンと誤読されうる（reviewerサブエージェントの指摘・2026-08-25）。
 * 胸囲記事だけが`showRoi`を渡す。
 *
 * 産次列（＝母の何番目の仔か）も同じ理由で`showParity`がtrueの時だけ出す（既定false）。
 * 「3番仔」という数字だけが注記なしに他記事へ出ると、空胎年を挟んでいても連産でも同じ
 * 数え方をしている点が伝わらない。産次記事（birth-order.astro）だけが`showParity`を渡す。
 *
 * 管囲列も同じ扱いで`showCaretGirth`がtrueの時だけ出す（既定false）。管囲は牡と牝で1cm近く
 * 違う指標（管囲記事）で、その注記が無い他記事に数字だけ出ると馬同士を直接比べられる
 * 数値だと誤読されうる。管囲記事（caret-girth.astro）だけが渡す。
 *
 * 厩舎列（＝現在の担当調教師と所属）も同じ扱いで`showStable`がtrueの時だけ出す（既定false）。
 * 調教師の個人名が注記なしに8記事の表へ並ぶと「この調教師なら走る/走らない」という読み方を
 * 招く。厩舎記事（stable-leading.astro）はその点を本文でことわっているので渡してよいが、
 * **既定オンにしないこと**（他記事の表にも黙って個人名が出る）。
 *
 * グループ列（＝その馬が記事内のどの分類に入るか）も同じ扱いで、`groupFor`を渡した記事に
 * だけ出る（既定undefined＝列なし）。「大きい/小さい」のような分類の定義は記事ごとに
 * 違うので、判定そのものは呼び出し側の関数に任せる。誕生月記事（birth-month.astro）だけが渡す。
 */
import type { RecruitWithResult } from '../lib/analysis-data.ts';
import { formatManYen } from '../lib/chart-math.ts';

interface Props {
  rows: RecruitWithResult[];
  showRoi?: boolean;
  showParity?: boolean;
  showCaretGirth?: boolean;
  showStable?: boolean;
  /** 渡すと「グループ」列が増え、各行にこの関数の戻り値が入る。 */
  groupFor?: (h: RecruitWithResult) => string;
  /** グループ列の見出し。`groupFor`を渡したときだけ使う。 */
  groupLabel?: string;
}

const {
  rows,
  showRoi = false,
  showParity = false,
  showCaretGirth = false,
  showStable = false,
  groupFor,
  groupLabel = 'グループ',
} = Astro.props;

/** 厩舎欄の表示（"堀宣行（美浦）"）。所属が取れていなければ名前だけ。 */
function stableLabel(h: RecruitWithResult): string {
  if (!h.finalTrainer) return '—';
  return h.trainerAffiliation ? `${h.finalTrainer}（${h.trainerAffiliation}）` : h.finalTrainer;
}
---

<div class="table-scroll">
  <table class="grade-winners">
    <thead>
      <tr>
        <th>馬名</th>
        {showStable && <th>厩舎</th>}
        {groupFor && <th>{groupLabel}</th>}
        <th>募集年</th>
        <th>誕生月</th>
        <th>体高</th>
        <th>胸囲</th>
        {showCaretGirth && <th>管囲</th>}
        <th>馬体重</th>
        <th>母齢</th>
        {showParity && <th>産次</th>}
        <th>一口価格</th>
        <th>主な勝鞍</th>
        <th>通算成績</th>
        <th>獲得賞金合計</th>
        {showRoi && <th>回収率</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((h) => (
          <tr>
            <td>{h.displayName}</td>
            {showStable && <td>{stableLabel(h)}</td>}
            {groupFor && <td class="group-cell">{groupFor(h)}</td>}
            <td>{h.recruitYear}年</td>
            <td>{h.birthDate ? `${Number(h.birthDate.split('-')[1])}月` : '—'}</td>
            <td>{h.height}cm</td>
            <td>{h.chestGirth !== null ? `${h.chestGirth}cm` : '—'}</td>
            {showCaretGirth && <td>{h.caretGirth !== null ? `${h.caretGirth}cm` : '—'}</td>}
            <td>{h.weight !== null ? `${h.weight}kg` : '—'}</td>
            <td>{h.damAge !== null ? `${h.damAge}歳` : '—'}</td>
            {showParity && (
              <td>
                {h.damParity !== null
                  ? `${h.damParity}番仔${h.damGapBeforeYears !== null && h.damGapBeforeYears >= 2 ? '（空胎明け）' : ''}`
                  : '—'}
              </td>
            )}
            <td>{h.pricePerShare !== null ? `${h.pricePerShare}万円` : '—'}</td>
            <td>{h.gradeWins.join('、')}</td>
            <td>
              {h.starts}戦{h.wins}勝
            </td>
            <td>{formatManYen(h.totalPrizeManYen)}万円</td>
            {showRoi && (
              <td>
                {h.offeringTotalManYen !== null && h.offeringTotalManYen > 0
                  ? `${Math.round((h.totalPrizeManYen / h.offeringTotalManYen) * 100)}%`
                  : '—'}
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
    margin: 1rem 0;
  }
  table.grade-winners {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  table.grade-winners th,
  table.grade-winners td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  table.grade-winners th {
    color: var(--muted);
    font-weight: 600;
  }
  table.grade-winners .group-cell {
    font-weight: 600;
  }
</style>
