---
/**
 * 分析記事の「重賞を勝った馬」の表。
 *
 * 2017〜2020年募集分を足して対象が818頭になり、重賞馬も44頭まで増えたため、記事側では
 * 上位ぶんだけ出して残りを折りたたむ（表がスマホで画面数ぶんの長さになっていた・2026-08-23）。
 * その2つは同じ形の表なので、行の作りはここに1つだけ置く ―― 呼び出し側に2回書くと、
 * 列を足したときに片方だけ直して表がずれる。
 *
 * 誕生月・馬体重列は誕生月記事（birth-month.astro）のために追加（2026-08-24）。胸囲列は
 * 胸囲記事（chest-girth.astro）のために追加（2026-08-25）。他の記事（height.astro・
 * dam-age.astro・birth-month.astro）にも同じ表を使っているので、そちらにも自動的に反映される。
 *
 * 回収率列（＝獲得賞金合計÷一口価格）は`showRoi`がtrueの時だけ出す（既定false）。
 * この倍率は実際の会員配当額ではなく規模感の目安に過ぎず、その注記は胸囲記事の本文にしか
 * 無いため、注記の無い他記事にまで数字だけ出ると出資リターンと誤読されうる
 * （reviewerサブエージェントの指摘・2026-08-25）。胸囲記事だけが`showRoi`を渡す。
 */
import type { RecruitWithResult } from '../lib/analysis-data.ts';
import { formatManYen } from '../lib/chart-math.ts';

interface Props {
  rows: RecruitWithResult[];
  showRoi?: boolean;
}

const { rows, showRoi = false } = Astro.props;
---

<div class="table-scroll">
  <table class="grade-winners">
    <thead>
      <tr>
        <th>馬名</th>
        <th>募集年</th>
        <th>誕生月</th>
        <th>体高</th>
        <th>胸囲</th>
        <th>馬体重</th>
        <th>母齢</th>
        <th>一口価格</th>
        <th>主な勝鞍</th>
        <th>通算成績</th>
        <th>獲得賞金合計</th>
        {showRoi && <th>回収率</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((h) => (
          <tr>
            <td>{h.displayName}</td>
            <td>{h.recruitYear}年</td>
            <td>{h.birthDate ? `${Number(h.birthDate.split('-')[1])}月` : '—'}</td>
            <td>{h.height}cm</td>
            <td>{h.chestGirth !== null ? `${h.chestGirth}cm` : '—'}</td>
            <td>{h.weight !== null ? `${h.weight}kg` : '—'}</td>
            <td>{h.damAge !== null ? `${h.damAge}歳` : '—'}</td>
            <td>{h.pricePerShare !== null ? `${h.pricePerShare}万円` : '—'}</td>
            <td>{h.gradeWins.join('、')}</td>
            <td>
              {h.starts}戦{h.wins}勝
            </td>
            <td>{formatManYen(h.totalPrizeManYen)}万円</td>
            {showRoi && (
              <td>
                {h.pricePerShare !== null && h.pricePerShare > 0
                  ? `${Math.round(h.totalPrizeManYen / h.pricePerShare)}倍`
                  : '—'}
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
    margin: 1rem 0;
  }
  table.grade-winners {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  table.grade-winners th,
  table.grade-winners td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  table.grade-winners th {
    color: var(--muted);
    font-weight: 600;
  }
</style>
