---
interface Tile {
  label: string;
  value: string;
  note?: string;
}
interface Props {
  tiles: Tile[];
  /** 小さめに出す。本文の主役ではなく脇に添える場所（出資馬ページ）向け。 */
  compact?: boolean;
}
const { tiles, compact = false } = Astro.props;
---

<ul class={`stat-tiles${compact ? ' is-compact' : ''}`}>
  {tiles.map((t) => (
    <li>
      <p class="stat-value">{t.value}</p>
      <p class="stat-label">{t.label}</p>
      {t.note && <p class="stat-note">{t.note}</p>}
    </li>
  ))}
</ul>

<style>
  .stat-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
  }
  .stat-tiles.is-compact {
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .stat-tiles.is-compact li { padding: 0.55rem 0.7rem; }
  .stat-tiles.is-compact .stat-value { font-size: 1.15rem; }
  .stat-tiles.is-compact .stat-label,
  .stat-tiles.is-compact .stat-note { font-size: 0.75rem; }
  .stat-tiles li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  .stat-value {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .stat-label {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .stat-note {
    margin: 0.3rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
