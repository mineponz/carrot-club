---
/**
 * 縦棒（カラム）チャート。1系列の量の比較（体高階級ごとの平均賞金、等）専用。
 * dataviz playbook準拠: 棒は角丸4px・上限24px幅、値はキャップ上に直接ラベル、
 * ホバー/フォーカスで詳細ツールチップ（本文の共有スクリプトが `.viz-hit[data-tip]` を拾う）。
 */
interface Bar {
  label: string;
  value: number;
  displayValue: string;
  n?: number;
  /**
   * 軸ラベルの下に小さく出す補足（例: "全60頭・重賞馬7頭"）。
   * 平均の母数（`n`）と母集団の頭数が違う時に、取り違えないよう併記する用。
   */
  note?: string;
}

interface Props {
  title: string;
  bars: Bar[];
  /** ツールチップの値の行ラベル（例: "平均中央獲得賞金" "頭数"） */
  valueLabel: string;
  /** ツールチップで `n` に付ける行ラベル。平均の母数が母集団と違うグラフでは言い換える */
  nLabel?: string;
  /** `note` を出すグラフで、ツールチップに付ける行ラベル */
  noteLabel?: string;
  height?: number;
  /**
   * 強調する棒のindex。分布の中で特定の1頭がどこにいるかを示すヒストグラム用。
   * 指定すると、その棒だけ通常色・他は淡色になり、値ラベルも強調した棒にだけ出る
   * （階級が10個以上あるヒストグラムで全部に数字を振ると読めなくなるため）。
   */
  highlightIndex?: number;
  /** 強調した棒に添える短い注記（例: "スイートリディア"）。`highlightIndex` と併用する。 */
  highlightLabel?: string;
  /**
   * 軸ラベルを何本おきに出すか（既定1＝全部）。ヒストグラムのように階級が10個以上あるグラフでは
   * 2以上にして間引く。既存の分析記事は階級5個前後なので既定のままで影響しない。
   */
  labelEvery?: number;
  /**
   * 縦軸の上限を明示する。2枚のグラフ（牡だけ／牝だけ、等）を並べて高さを見比べさせたい時に、
   * 両方へ同じ値を渡して物差しを揃える（既定はグラフごとに自前の最大値から決めるので、
   * 別々の物差しになり「牝の方が高く見える」ような誤読が起きる）。
   */
  axisMax?: number;
}

const {
  title,
  bars,
  valueLabel,
  nLabel = '頭数',
  noteLabel = '内訳',
  height = 260,
  axisMax,
  highlightIndex,
  highlightLabel,
  labelEvery = 1,
} = Astro.props;

const hasHighlight = highlightIndex !== undefined;

const width = 640;
const marginTop = 24;
// note を出す時は軸ラベルの下にもう1行入るぶん下余白を広げる
const hasNotes = bars.some((b) => b.note);
const marginBottom = hasNotes ? 56 : 40;
// 強調ラベル（"スイートリディア ▼"）を棒の上に出すぶん、上余白を広げる
const topPad = hasHighlight && highlightLabel ? 18 : 0;
const marginLeft = 8;
const marginRight = 8;
const plotWidth = width - marginLeft - marginRight;
const plotHeight = height - marginTop - marginBottom - topPad;

const maxValue = Math.max(1, ...bars.map((b) => b.value));
// axisMax を渡された時もデータがそれを超えていたら棒が枠外に伸びてしまうので、実データの最大値で下支えする。
const niceMax = Math.ceil(Math.max(maxValue, axisMax ?? 0) / 10) * 10 || 1;

const barGap = 10;
const barWidth = Math.min(56, plotWidth / bars.length - barGap);
const step = plotWidth / bars.length;

function yFor(value: number) {
  return marginTop + topPad + plotHeight * (1 - value / niceMax);
}

const gridLines = [0, 0.25, 0.5, 0.75, 1].map((t) => ({
  y: marginTop + topPad + plotHeight * (1 - t),
  value: Math.round(niceMax * t),
}));
---

<div class="viz-root">
  <p class="viz-title">{title}</p>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title} class="viz-svg">
    {gridLines.map((g) => (
      <line x1={marginLeft} x2={width - marginRight} y1={g.y} y2={g.y} class="viz-grid" />
    ))}
    {bars.map((bar, i) => {
      const cx = marginLeft + step * i + step / 2;
      const x = cx - barWidth / 2;
      const y = yFor(bar.value);
      const barHeight = marginTop + topPad + plotHeight - y;
      const isHighlighted = hasHighlight && i === highlightIndex;
      // 強調指定がある時は、その棒以外の値ラベルを出さない（数字だらけにしない）
      const showValue = !hasHighlight || isHighlighted;
      const rows: [string, string][] = [[valueLabel, bar.displayValue]];
      if (bar.n !== undefined) rows.push([nLabel, `${bar.n}頭`]);
      if (bar.note) rows.push([noteLabel, bar.note]);
      const tip = JSON.stringify({ title: bar.label, rows });
      return (
        <g>
          <rect
            class={`viz-hit viz-bar${hasHighlight && !isHighlighted ? ' viz-bar-dim' : ''}`}
            x={x}
            y={y}
            width={barWidth}
            height={Math.max(0, barHeight)}
            rx="4"
            ry="4"
            tabindex="0"
            data-tip={tip}
          />
          {showValue && (
            <text x={cx} y={y - 8} class="viz-bar-label" text-anchor="middle">
              {bar.displayValue}
            </text>
          )}
          {isHighlighted && highlightLabel && (
            <text x={cx} y={y - 24} class="viz-highlight-label" text-anchor="middle">
              {highlightLabel} ▼
            </text>
          )}
          {i % labelEvery === 0 && (
            <text x={cx} y={height - marginBottom + 18} class="viz-axis-label" text-anchor="middle">
              {bar.label}
            </text>
          )}
          {bar.note && (
            <text x={cx} y={height - marginBottom + 33} class="viz-axis-note" text-anchor="middle">
              {bar.note}
            </text>
          )}
        </g>
      );
    })}
    <line
      x1={marginLeft}
      x2={width - marginRight}
      y1={marginTop + topPad + plotHeight}
      y2={marginTop + topPad + plotHeight}
      class="viz-baseline"
    />
  </svg>
  <p class="visually-hidden">
    {title}: {bars
      .map(
        (b) =>
          `${b.label} ${valueLabel} ${b.displayValue}` +
          (b.n !== undefined ? `（${nLabel}${b.n}頭）` : '') +
          (b.note ? `（${b.note}）` : '')
      )
      .join('、 ')}
  </p>
</div>

<style>
  .viz-root {
    --series-1: #2a78d6;
    --series-1-dark: #3987e5;
    position: relative;
    margin: 1.25rem 0;
  }
  @media (prefers-color-scheme: dark) {
    .viz-root { --series-1: var(--series-1-dark); }
  }
  .viz-title {
    margin: 0 0 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text);
  }
  .viz-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .viz-grid { stroke: var(--border); stroke-width: 1; }
  .viz-baseline { stroke: var(--muted); stroke-width: 1; }
  .viz-bar {
    fill: var(--series-1);
    cursor: pointer;
    transition: opacity 0.1s ease;
  }
  .viz-bar:hover,
  .viz-bar:focus-visible {
    opacity: 0.75;
    outline: none;
  }
  /* 強調していない棒。色相は変えず不透明度だけ落として、強調した1本を前に出す。
     color-mix(... var(--surface)) だとトークンが解決できず宣言ごと無効になり、
     淡色化が効かなかった（2026-09-06）。SVGでは fill-opacity が確実。 */
  .viz-bar-dim { fill-opacity: 0.3; }
  .viz-bar-dim:hover,
  .viz-bar-dim:focus-visible { fill-opacity: 0.55; }
  .viz-highlight-label {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--series-1);
  }
  .viz-bar-label {
    font-size: 12px;
    font-weight: 600;
    fill: var(--text);
  }
  .viz-axis-label {
    font-size: 11px;
    fill: var(--muted);
  }
  /* 軸ラベルの補足。スマホでは階級が5つ並ぶと窮屈なので軸ラベルより一段小さくする */
  .viz-axis-note {
    font-size: 9.5px;
    fill: var(--muted);
  }
  /*
   * 読み上げ用テキストを画面上は隠す。BaseLayout.astro等にも同名クラスがあるが、Astroの
   * scoped CSSはファイルをまたいで効かないため、ここに定義が無いと下の<p>がそのまま
   * 素のテキストで表示されてしまう（2026-08-23、体高階級別グラフで発覚。本人指摘）。
   */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
