---
/**
 * 出資馬の個別ページ（`/my-horses/<馬>/`）。
 *
 * 中身は本人の指定（2026-09-09）で4点:
 *  父・母・母父 / 競走成績 / 馬体重の推移（放牧・育成・レース） / 募集時の測尺
 *
 * 読み物（`/my-horses/article/<馬>/`）とはURLを分けてある。ここはデータのページで、
 * 記事は別。記事がある馬だけ相互リンクする。
 *
 * ## 馬体重の出どころが2つある
 * 育成・放牧中の体重はクラブの近況（`my-horse-training-weights.json`）、レース当日の体重は
 * netkeibaの競走成績（`my-horse-races.json`）。輸送で絞れるぶんレース当日は軽く出るので、
 * 1本の線でつながず線と点に分けている（`WeightTimeline.astro`）。
 *
 * ## 成績はファンド在籍中のみ
 * 地方移籍した馬は解散後も走るが、出資者と関係が切れているので表にも集計にも入れない。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeightTimeline from '../../components/charts/WeightTimeline.astro';
import ChartTooltip from '../../components/charts/ChartTooltip.astro';
import StatTiles from '../../components/charts/StatTiles.astro';
import {
  loadMyHorses,
  STATUS_LABEL,
  MY_HORSES_FETCHED_AT,
  recruitPhotoUrl,
  loadRecruitPhotos,
  loadOwnPhotos,
  ownPhotoUrl,
} from '../../lib/my-horses.ts';
import { loadRecruitsWithResults } from '../../lib/analysis-data.ts';
import { formatPrizeJa } from '../../lib/chart-math.ts';
import trainingJson from '../../../analysis/data/my-horse-training-weights.json';

export async function getStaticPaths() {
  const { loadMyHorses: load } = await import('../../lib/my-horses.ts');
  return load().map((h) => ({ params: { slug: h.slug }, props: { slug: h.slug } }));
}

const { slug } = Astro.props as { slug: string };
const horse = loadMyHorses().find((h) => h.slug === slug)!;

/**
 * 測尺の出どころは2つある。通常募集は募集カタログ（`recruits.json`・1歳8月）、
 * 追加募集はクラブの近況の初回コメント（2歳春）。計測時期が違うので見出しも分ける。
 */
const recruit = loadRecruitsWithResults().find(
  (r) => r.recruitYear === horse.recruitYear && r.no === horse.no,
);
const measuredAt = horse.measuredAt ?? null;
const photo = loadRecruitPhotos()[slug] ?? null;
// 自分で撮った写真はレース単位でまとめる（同じレースで複数枚あるため）。
const ownPhotos = loadOwnPhotos()[slug] ?? [];
const ownByRace = [...new Map(
  ownPhotos.map((p) => [p.date, ownPhotos.filter((q) => q.date === p.date)]),
).entries()].map(([date, items]) => ({ date, items, race: items[0] }));

const training = (
  (trainingJson as { horses: Record<string, { points: { date: string; weightKg: number; place: string }[] }> })
    .horses[slug]?.points ?? []
).map((p) => ({ date: p.date, weightKg: p.weightKg, label: p.place }));

const inFund = horse.races.filter((r) => r.inFund);
const raceWeights = inFund
  .filter((r) => r.bodyWeight && r.date)
  .map((r) => ({
    date: r.date!.replace(/\//g, '-'),
    weightKg: r.bodyWeight!,
    label: r.raceName,
    diff: r.bodyWeightDiff,
    finish: r.finish,
  }));

const wins = inFund.filter((r) => r.finish === 1).length;
const measures = [
  { label: '馬体重', value: horse.weight, unit: 'kg' },
  { label: '体高', value: horse.height ?? recruit?.height ?? null, unit: 'cm' },
  { label: '胸囲', value: horse.chestGirth ?? recruit?.chestGirth ?? null, unit: 'cm' },
  { label: '管囲', value: horse.caretGirth ?? recruit?.caretGirth ?? null, unit: 'cm' },
];

/** 着順の4段階。テンプレートで `<=` を書くと Astro が `<` をタグ開始と誤読するのでここで判定する。 */
function finishTier(finish: number | string | null): string {
  if (typeof finish !== 'number') return 'out';
  if (finish === 1) return '1';
  if (finish < 4) return '23';
  if (finish < 6) return '45';
  return 'out';
}

/** JRAの慣例に合わせたグレードの段階。GI/JpnI→1, GII→2, GIII→3, OP・Lは色なし。 */
function gradeClass(g: string | null): string {
  if (!g) return '';
  const m = g.match(/^(?:G|Jpn)(I{1,3})$/);
  return m ? `grade-${m[1].length}` : 'grade-op';
}

const WRITTEN = new Set(['sweet-lydia']);
const asOf = new Date(MY_HORSES_FETCHED_AT).toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const description = `【非公式】${horse.name}（${horse.recruitYear}年募集${horse.no}番・父${horse.sire}）の競走成績と馬体重の推移。育成中とレース当日の馬体重を1枚のグラフにまとめています。`;
---

<BaseLayout
  title={horse.name}
  description={description}
  breadcrumb={[{ label: '管理人みねらるの出資馬', href: '/my-horses/' }]}
  breadcrumbLabel={horse.name}
>
  <h1 class="horse-title">
    {horse.name}
    <span class={`badge badge-${horse.status}`}>{STATUS_LABEL[horse.status]}</span>
  </h1>
  {/* PCでは写真の右に情報を寄せて、写真の横にできる空きを埋める（本人指摘・2026-09-09）。
      狭い画面では1列に落ちる。 */}
  <div class="horse-head">
    <div class="horse-head-photo">
    {photo && (
      /* 読み込めなければ figure ごと隠す（このサイトはCSP未導入なので onerror 属性が使える）。 */
      <figure class="horse-photo">
        <img
          src={recruitPhotoUrl(slug)}
          alt={`${horse.name}の募集時の馬体写真`}
          loading="eager"
          referrerpolicy="no-referrer"
          onerror="this.closest('figure').hidden = true"
        />
        <figcaption>
          募集時（{photo.date.replace(/-/g, '/')}・{photo.place}）の馬体写真。
          キャロットクラブより許可をもらって転載しています。
        </figcaption>
      </figure>
    )}
    {ownByRace.length > 0 && (
      <p class="gallery-link">
        <a href="#gallery">
          レースで撮った写真 {ownPhotos.length}枚を見る <span aria-hidden="true">↓</span>
        </a>
      </p>
    )}
    </div>

    <div class="horse-head-info">
      <p class="pedigree">
        父 <strong>{horse.sire}</strong><br />
        母 <strong>{horse.damName}</strong>
        <span class="bms">（母父 {horse.broodmareSire}）</span>
      </p>
      <p class="recruit-line">
        {horse.recruitYear}年募集{horse.no}番{horse.supplementary ? '（追加募集）' : ''}
        {horse.offeringTotalManYen ? ` ・ 募集総額 ${formatPrizeJa(horse.offeringTotalManYen)}` : ''}
        {horse.status !== 'active' && horse.fundEndedAt
          ? ` ・ ${horse.status === 'retired' ? '引退' : 'ファンド解散'} ${horse.fundEndedAt.replace(/-/g, '/')}`
          : ''}
        {horse.retiredReason ? `（${horse.retiredReason}）` : ''}
      </p>

      <StatTiles
        compact
        tiles={[
          { label: '成績', value: inFund.length ? `${inFund.length}戦${wins}勝` : '未出走' },
          { label: '獲得賞金', value: formatPrizeJa(horse.ownerPrizeManYen) },
          {
            label: '回収率',
            value: horse.recoveryRatePct === null ? '—' : `${horse.recoveryRatePct}%`,
            note: horse.offeringTotalManYen ? `募集 ${formatPrizeJa(horse.offeringTotalManYen)}` : undefined,
          },
        ]}
      />

      <table class="measure-table">
        <tbody>
          <tr>{measures.map((m) => <th scope="col">{m.label}</th>)}</tr>
          <tr>{measures.map((m) => <td>{m.value === null ? '—' : `${m.value}${m.unit}`}</td>)}</tr>
        </tbody>
      </table>
      <p class="measure-note">
        {measuredAt
          ? `募集時の測尺（${measuredAt.replace(/-/g, '/')}・追加募集のためカタログではなく近況より。通常募集の1歳8月とは時期が違います）`
          : '募集時の測尺（1歳8月）'}
      </p>
    </div>
  </div>

  <h2>競走成績</h2>
  {inFund.length ? (
    <div class="race-table-wrap">
      <table class="race-table">
        <thead>
          <tr>
            <th>レース</th><th>距離</th><th>馬場</th>
            <th>頭数</th><th>人気</th><th>着順</th><th>騎手</th><th>斤量</th>
            <th>タイム</th><th>上り</th><th>馬体重</th><th>賞金</th>
          </tr>
        </thead>
        <tbody>
          {inFund.map((r) => {
            const tier = finishTier(r.finish);
            return (
            <tr class={`row-${tier}`}>
              <td class="race-cell">
                <span class="race-meta">{r.date}　{r.venue}{r.raceNumber}R</span>
                <span class="race-title">
                  {r.raceName}
                  {r.grade && <span class={`grade ${gradeClass(r.grade)}`}>{r.grade}</span>}
                </span>
              </td>
              <td class="nowrap sub" data-label="距離">{r.course}</td>
              <td class="nowrap sub" data-label="馬場">{r.condition}</td>
              <td class="num sub" data-label="頭数">{r.headcount}</td>
              <td class="num sub" data-label="人気">{r.popularity}</td>
              <td class="num finish-cell"><span class={`finish finish-${tier}`}>{r.finish}</span></td>
              <td class="nowrap" data-label="騎手">{r.jockey}</td>
              <td class="num sub" data-label="斤量">{r.carriedWeight}</td>
              <td class="nowrap time" data-label="タイム">{r.time}</td>
              {/* 上りは 37 ではなく 37.0 と桁を揃える（本人指摘・2026-09-09）。 */}
              <td class="num" data-label="上り">{r.last3f === null ? '—' : r.last3f.toFixed(1)}</td>
              <td class="nowrap sub" data-label="馬体重">{r.bodyWeight ? `${r.bodyWeight}(${r.bodyWeightDiff! > 0 ? '+' : ''}${r.bodyWeightDiff})` : '—'}</td>
              <td class="num" data-label="賞金">{r.prizeManYen ? `${r.prizeManYen.toLocaleString()}万` : '—'}</td>
            </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="note">まだ出走していません。</p>
  )}

  <h2>馬体重の推移</h2>
  {training.length || raceWeights.length ? (
    <>
      <WeightTimeline
        title={`${horse.name}の馬体重`}
        training={training}
        races={raceWeights}
      />
      <p class="note">レース当日は輸送で絞れるぶん、育成中より軽く出ます。</p>
    </>
  ) : (
    <p class="note">記録がありません。</p>
  )}

  {ownByRace.length > 0 && (
    <>
      <h2 id="gallery">ギャラリー</h2>
      {ownByRace.map((g) => (
        <section class="own-group">
          <p class="own-caption">
            {g.date.replace(/-/g, '/')}　{g.race.venue}　{g.race.raceName}
            {g.race.grade && <span class={`grade ${gradeClass(g.race.grade)}`}>{g.race.grade}</span>}
            <span class="own-finish">{g.race.finish}着</span>
          </p>
          <div class="own-grid">
            {g.items.map((p) => (
              <img
                src={ownPhotoUrl(slug, p.file)}
                alt={`${horse.name} ${g.race.raceName}`}
                width={p.width ?? undefined}
                height={p.height ?? undefined}
                loading="lazy"
              />
            ))}
          </div>
        </section>
      ))}
    </>
  )}

  {WRITTEN.has(horse.slug) && (
    <p class="article-link">
      <a href={`/my-horses/article/${horse.slug}/`}>この馬について書いたもの →</a>
    </p>
  )}

  <p class="asof">成績は{asOf}時点。</p>
  <ChartTooltip />
</BaseLayout>

<style>
  .horse-title { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .badge {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .badge-active { background: var(--info-weak); color: var(--info); }
  .badge-retired,
  .badge-transferred { background: var(--accent-weak); color: var(--muted); }
  .horse-head {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 720px) {
    .horse-head { grid-template-columns: 1fr; gap: 0.75rem; }
  }
  /* 写真とギャラリー導線で1列。ここを div でまとめないと導線がグリッドの3つ目の子になり、
     右列に入るはずの血統・成績・測尺が写真の下へ落ちる（2026-09-10に発生）。 */
  .horse-head-photo { min-width: 0; }
  .horse-head-info { min-width: 0; }
  /* 写真の真下に置いて、上から読み始めた人がギャラリーの存在に気づけるようにする。 */
  .gallery-link { margin: 0.5rem 0 0; font-size: 0.875rem; font-weight: 700; }
  /* アンカーで飛んだとき見出しがヘッダーに隠れないよう余白を取る */
  #gallery { scroll-margin-top: 1rem; }
  .horse-photo { margin: 0; }
  .horse-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .horse-photo figcaption {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .pedigree { font-size: 1.05rem; margin: 0 0 0.2rem; line-height: 1.6; }
  .pedigree .bms { color: var(--muted); font-size: 0.875rem; }
  .recruit-line { color: var(--muted); font-size: 0.8125rem; margin: 0 0 0.5rem; }
  .measure-note { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.75rem; line-height: 1.6; }
  .measure-table { border-collapse: collapse; margin: 0.75rem 0 0; width: 100%; }
  .measure-table th,
  .measure-table td {
    border: 1px solid var(--border);
    padding: 0.35rem 0.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .measure-table th { background: var(--surface); font-size: 0.8125rem; color: var(--muted); }
  .measure-table td { font-weight: 600; }
  .note { color: var(--muted); font-size: 0.875rem; line-height: 1.7; }
  .own-group { margin: 1.25rem 0 1.75rem; }
  .own-caption { margin: 0 0 0.5rem; font-size: 0.9375rem; font-weight: 600; }
  .own-finish { margin-left: 0.5rem; color: var(--muted); font-weight: 400; font-size: 0.875rem; }
  /* 同じレースの複数枚を横に並べる。1枚だけのときは大きくなりすぎないよう上限を付ける。 */
  .own-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.6rem;
  }
  .own-grid img {
    display: block;
    width: 100%;
    max-width: 28rem;
    height: auto;
    border-radius: 8px;
  }
  /* 募集時の写真も同じ理由で寸法が要るが、外部ホストのため取得できない。
     縦横比を先に決めて場所を確保する。 */
  .race-table-wrap { overflow-x: auto; margin: 1rem 0; }
  .race-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  .race-table th,
  .race-table td { padding: 0.4rem 0.55rem; border-bottom: 1px solid var(--border); text-align: left; }
  .race-table thead th { background: var(--surface); white-space: nowrap; }
  .race-table .nowrap { white-space: nowrap; }
  /* netkeibaの個体ページと同じで、脇の条件（日付・開催・距離・馬場・頭数・人気・斤量・馬体重）は
     一段落として、レース名・着順・タイムを前に出す。 */
  .race-table .sub { color: var(--muted); font-size: 0.75rem; }
  /* SPで14列は横スクロールしないと何も読めないので、日付・開催・レース名を1セルに畳む
     （本人指摘・2026-09-10）。1行目に日付と開催を小さく、2行目にレース名を主役として置く。 */
  .race-cell { min-width: 11rem; }
  /*
   * SPでは12列でも768px必要で横スクロールが400px近く出る（本人指摘・2026-09-10）。
   * 640px以下ではテーブルをやめて1走=1ブロックのカードにする。
   * 見出し行は消し、各セルは `data-label` を前置きして意味が分かるようにする。
   * レース名は行頭に、着順は右上に固定して、まず「どのレースで何着」が読めるようにする。
   */
  @media (max-width: 640px) {
    .race-table-wrap { overflow-x: visible; }
    .race-table { font-size: 0.8125rem; }
    .race-table thead { display: none; }
    .race-table tbody tr {
      display: block;
      position: relative;
      padding: 0.6rem 3.2rem 0.6rem 0;
      border-bottom: 1px solid var(--border);
    }
    /* inline だと「騎手 西村淳也」が行末で分断される。inline-block + nowrap で
       ラベルと値を1かたまりにして、かたまり単位で折り返させる。 */
    .race-table tbody td {
      display: inline-block;
      padding: 0;
      border: none;
      white-space: nowrap;
      margin-right: 0.7rem;
    }
    .race-table tbody td:not(.race-cell):not(.finish-cell)::before {
      content: attr(data-label) " ";
      color: var(--muted);
      font-size: 0.6875rem;
    }
    .race-table .race-cell { display: block; min-width: 0; margin-bottom: 0.15rem; white-space: normal; }
    .race-table .finish-cell {
      position: absolute;
      top: 0.6rem;
      right: 0;
      text-align: right;
    }
    .race-table .sub { font-size: 0.75rem; }
  }
  .race-cell .race-meta {
    display: block;
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.4;
  }
  .race-cell .race-title {
    display: block;
    font-weight: 600;
    line-height: 1.4;
  }
  .race-table .time { font-variant-numeric: tabular-nums; font-weight: 600; }
  .race-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  /* 着順は表の中でいちばん探される列なので、数字だけでなくバッジにして段階を付ける。
     グラフ（WeightTimeline）と同じ4段階: 1着 / 2〜3着 / 4〜5着（掲示板）/ 6着以下。
     色だけに頼らず、塗り・枠・太さでも差を付けている。 */
  .finish {
    display: inline-block;
    min-width: 2.1em;
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .finish-1 { background: var(--info); color: #fff; font-weight: 800; }
  .finish-23 { background: var(--info-weak); color: var(--info); font-weight: 700; }
  .finish-45 { border: 1px solid var(--border); color: var(--text); font-weight: 600; }
  .finish-out { color: var(--muted); }
  /* 好走した行そのものも薄く持ち上げて、流し読みで拾えるようにする */
  tr.row-1 { background: var(--info-weak); }
  /* 行全体を太字にすると騎手名まで太くなって列ごとに太さが揺れる（本人指摘・2026-09-10）。
     強調はレース名・着順・タイムに限り、行は薄い地色だけで示す。 */
  tr.row-23 { background: color-mix(in srgb, var(--info-weak) 45%, transparent); }
  tr.row-out td { color: var(--muted); }
  /*
   * グレードの色はJRAの慣例に合わせる（G1=青 / G2=赤 / G3=緑）。JpnI〜III も同じ。
   * netkeibaの表記はローマ数字なので `I` の数で段階を判定する。
   * 白文字のコントラストは light で 7.03 / 6.52 / 5.37、dark は濃い文字に反転して
   * 6.92 / 6.28 / 8.00（いずれも4.5以上）。OP・L は色を持たせず枠線だけ。
   */
  .grade {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
  }
  .grade-1 { background: #1258a8; color: #fff; }
  .grade-2 { background: #b32626; color: #fff; }
  .grade-3 { background: #157a48; color: #fff; }
  .grade-op { border: 1px solid var(--border); color: var(--muted); }
  @media (prefers-color-scheme: dark) {
    .grade-1 { background: #5aa3e8; color: #12140f; }
    .grade-2 { background: #e8736f; color: #12140f; }
    .grade-3 { background: #4fbe89; color: #12140f; }
  }
  .article-link { margin-top: 1.5rem; font-weight: 700; }
  .asof { color: var(--muted); font-size: 0.8125rem; }
</style>
