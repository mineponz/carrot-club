---
/**
 * 募集馬一覧（トップページ）。
 *
 * 表の行はビルド時とブラウザ側の両方で `horseRowHtml()` から作る。ビルド時に
 * 全頭を埋め込んでおかないと、サーバーが返すHTMLに馬のデータが1件も含まれず
 * （クローラーには「読み込み中…」しか見えず）検索に載らない。
 * ブラウザ側は読み込み後に localStorage の評価を反映して同じ関数で描き直す。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, UNOFFICIAL_NOTICE } from '../consts.ts';
import { horses2026 } from '../data/horses2026.ts';
import { sortHorses, uniqueValues, UNRATED, type SortKey } from '../lib/horses.ts';
import { DEFAULT_EVALUATION } from '../lib/evaluations.ts';
// A〜Eの並びはAPI側の定義を唯一の出所にする（ここで別の配列を作ると表・集計とずれる）
import { RATINGS } from '../lib/evaluation-api.ts';
import { COLUMNS, horseRowHtml } from '../lib/horse-row.ts';

// フィルタの選択肢はビルド時に確定できるのでサーバー側で作る
const sires = uniqueValues(horses2026, 'sire');
const stables = uniqueValues(horses2026, 'stable');

// COLUMNS は `as const` なので、そのままだと sortKey / align を持たない要素との
// union になって参照できない。ここで緩い型に受け直す。
const columns: readonly { label: string; sortKey?: SortKey; align?: string }[] = COLUMNS;

// 初期表示はクライアント側の既定（id昇順）と揃える。評価は端末ごとの値なので
// 初期HTMLでは未評価（DEFAULT_EVALUATION）で描き、読み込み後に上書きする。
const initialRowsHtml = sortHorses(horses2026, 'id', 'asc')
  .map((horse) => horseRowHtml(horse, DEFAULT_EVALUATION))
  .join('\n');

const total = horses2026.length;

// 以下の数値はすべて src/data/horses2026.ts を集計した実測値。
const damPriorityCount = horses2026.filter((h) => h.damPriority).length;
const surgeryCount = horses2026.filter((h) => h.surgery !== '').length;
// 手術・既往は年によって情報源が無い（2026年募集はクラブの公開リストにもnetkeibaにも記載が無く全頭空）。
// 1件も無い年に「手術・既往ありを除く」フィルタを出すと押しても何も起きない死んだUIになるので、
// データがある年だけ出す。
const hasSurgeryData = surgeryCount > 0;
const noSiblingCount = horses2026.filter((h) => h.sibling === '').length;
const maleCount = horses2026.filter((h) => h.sex === '牡').length;
const femaleCount = horses2026.filter((h) => h.sex === '牝').length;
const sireKinds = uniqueValues(horses2026, 'sire').length;
const bmsKinds = uniqueValues(horses2026, 'broodmareSire').length;
const stableKinds = stables.length;

function range(key: 'height' | 'chestGirth' | 'caretGirth' | 'weight' | 'pricePerShare') {
  const values = horses2026.map((h) => h[key]).sort((a, b) => a - b);
  const sum = values.reduce((a, b) => a + b, 0);
  return {
    min: values[0],
    max: values[values.length - 1],
    avg: Math.round((sum / values.length) * 10) / 10,
    median: values[Math.floor(values.length / 2)],
  };
}

const heightRange = range('height');
const chestRange = range('chestGirth');
const caretRange = range('caretGirth');
const weightRange = range('weight');
const priceRange = range('pricePerShare');

const measurements = [
  {
    term: '体高',
    unit: 'cm',
    meaning: '地面から き甲（首の付け根の盛り上がり）までの高さ。馬の背丈にあたる。',
    stat: heightRange,
  },
  {
    term: '胸囲',
    unit: 'cm',
    meaning: 'き甲の後ろで胴回りを一周した長さ。胴の太さの目安。',
    stat: chestRange,
  },
  {
    term: '管囲',
    unit: 'cm',
    meaning: '前脚の管（前膝から球節までの部分）を一周した長さ。脚元の太さの目安。',
    stat: caretRange,
  },
  {
    term: '馬体重',
    unit: 'kg',
    meaning: '計測時点の体重。',
    stat: weightRange,
  },
];

// FAQは「画面に見えている文言」と JSON-LD を完全に一致させる必要があるため、
// 必ずこの配列だけを唯一の出所にして両方を描画する（不一致はガイドライン違反）。
const faqs = [
  {
    q: '入力した評価やメモはどこに保存されますか？',
    a: '評価（A〜E）・お気に入り・消・メモは、お使いの端末のブラウザ内（localStorage）に保存されます。このうちA〜Eの印だけは、「みんな」列に出す全体の傾向を集計するために、端末ごとにランダムに作られる匿名ID（会員番号や氏名とは結び付きません）とあわせて送信します。メモ・お気に入り・消は送信せず、この端末の中だけに残ります。同じブラウザで開き直せば復元されますが、別の端末やブラウザ、プライベートウィンドウとは共有されず、ブラウザの保存データを消すと評価も消えます。',
  },
  {
    q: '「みんな」列は何ですか？',
    a: 'このツールを使っている人がその馬に付けたA〜Eの印を集計したものです。棒の色がA〜Eの内訳、右の数字が評価した人数を表します。誰がどの評価を付けたかは記録していません（端末ごとの匿名IDで、同じ人が同じ馬に二重に入らないようにしているだけです）。まだ誰も評価していない馬は「−」と表示されます。',
  },
  {
    q: 'このサイトはキャロットクラブの公式サイトですか？',
    a: `${UNOFFICIAL_NOTICE} 掲載しているのは募集馬リストの客観データを並べ替え・絞り込みできる形に整理したものだけで、出資の判断は必ずクラブ公式の情報でご確認ください。`,
  },
  {
    q: '「母優先」とは何ですか？',
    a: `その馬の母（繁殖牝馬）に出資している会員に優先枠がある、というクラブの制度上の区分です。この一覧では該当する馬の「母優」列に◯を付けており、2026年募集馬では${total}頭中${damPriorityCount}頭が該当します。「母優先のみ」にチェックを入れると該当馬だけに絞り込めます。`,
  },
  {
    q: 'このツールに独自の評価やおすすめは載っていますか？',
    a: `載っていません。掲載しているのは馬名・性別・父・母父・母齢・誕生日・厩舎・一口価格・体高・胸囲・管囲・馬体重・兄弟・母優先${hasSurgeryData ? '・手術や既往の記載' : ''}といった客観データのみで、点数付けや順位付けは一切していません。評価は利用者自身が入力します。`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout description={SITE_DESCRIPTION} showAds={false}>
  <h1>2026年募集馬 一覧（{total}頭）</h1>
  <p class="lead">
    キャロットクラブ2026年募集馬{total}頭を、血統・測尺・一口価格・厩舎で並べ替え、絞り込みできる
    非公式の選定支援ツールです。評価・お気に入り・消・メモはこの端末のブラウザ内（localStorage）に
    保存され、再読み込みしても残ります。A〜Eの印だけは匿名で集計し、「みんな」列に
    他の利用者の評価の分かれ方として表示します（メモ・お気に入り・消は送信しません）。
  </p>
  <!-- 非公式である旨は BaseLayout のヘッダーで全ページに常時表示しているため、ここには重ねない -->
  <p class="year-switch">
    昨年の募集馬を見たい場合は <a href="/2025/">2025年募集馬の一覧はこちら</a>
    （評価は年ごとに別々に保存されます）。
  </p>


  <div class="filters">
    <label>
      馬名
      <input type="text" id="filter-name" placeholder="部分一致" />
    </label>
    <label>
      父
      <select id="filter-sire">
        <option value="">すべて</option>
        {sires.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>
    <label>
      母父
      <input type="text" id="filter-bms" placeholder="部分一致" />
    </label>
    <label>
      厩舎
      <select id="filter-stable">
        <option value="">すべて</option>
        {stables.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>
    <label>
      性別
      <select id="filter-sex">
        <option value="">すべて</option>
        <option value="牡">牡</option>
        <option value="牝">牝</option>
        <option value="セ">セ</option>
      </select>
    </label>
    <label>
      一口 (万円)
      <span class="range">
        <input type="number" id="filter-price-min" placeholder="下限" />
        〜
        <input type="number" id="filter-price-max" placeholder="上限" />
      </span>
    </label>
    <label>
      体高 (cm)
      <span class="range">
        <input type="number" id="filter-height-min" placeholder="下限" />
        〜
        <input type="number" id="filter-height-max" placeholder="上限" />
      </span>
    </label>
    <label>
      管囲 (cm)
      <span class="range">
        <input type="number" id="filter-caret-min" step="0.1" placeholder="下限" />
        〜
        <input type="number" id="filter-caret-max" step="0.1" placeholder="上限" />
      </span>
    </label>
    <label>
      馬体重 (kg)
      <span class="range">
        <input type="number" id="filter-weight-min" placeholder="下限" />
        〜
        <input type="number" id="filter-weight-max" placeholder="上限" />
      </span>
    </label>

    <!--
      自分が付けたA〜Eでの絞り込み。複数選べて、選んだもののどれかが付いていれば残る（OR）。
      印の色は表の評価セレクトと同じ --rating-*-bg を使う（同じAが別の色に見えると迷う）。
      1つも選んでいない状態が既定＝全頭表示なので、「未選択なら全頭」を添えて
      「押していないから絞れていない」ことが分かるようにしている。
    -->
    <div class="rating-filters" role="group" aria-labelledby="rating-filters-label">
      <span class="rating-filters-label" id="rating-filters-label">自分の評価</span>
      {
        RATINGS.map((r) => (
          <label class="checkbox-label rating-option">
            <input type="checkbox" class="filter-rating" value={r} />
            <span class="rating-chip" data-rating={r}>{r}</span>
          </label>
        ))
      }
      <label class="checkbox-label rating-option">
        <input type="checkbox" class="filter-rating" value={UNRATED} />
        <span class="rating-chip rating-chip-unrated">未評価</span>
      </label>
      <span class="rating-filters-hint">未選択なら全頭</span>
    </div>

    <div class="toggles">
      <label class="checkbox-label">
        <input type="checkbox" id="filter-dam-priority" />
        母優先のみ
      </label>
      {
        hasSurgeryData && (
          <label class="checkbox-label">
            <input type="checkbox" id="filter-exclude-surgery" />
            手術・既往ありを除く
          </label>
        )
      }
      <label class="checkbox-label">
        <input type="checkbox" id="filter-hide-skip" />
        消を付けた馬を隠す
      </label>
      <label class="checkbox-label">
        <input type="checkbox" id="filter-favorite-only" />
        お気に入りのみ
      </label>
      <button type="button" id="filter-reset">条件をクリア</button>
    </div>
  </div>

  <p id="result-count" class="result-count">{total} / {total} 頭</p>
  <p class="scroll-hint">
    表は横スクロールで全{columns.length}列が見られます（父・母父・測尺・厩舎・netkeibaリンクなど）。
    画面が広いときは <strong>No・馬名・評価</strong> の3列が左端に残るので、スクロールしても
    どの馬に評価を入れているか分かります。
  </p>

  <div class="table-wrap">
    <table id="horse-table">
      <caption class="visually-hidden">
        2026年募集馬{total}頭の血統・測尺・一口価格・厩舎の一覧（評価欄つき）
      </caption>
      <thead>
        <tr>
          {
            columns.map((col) => (
              <th class={col.align === 'num' ? 'num' : undefined}>
                {col.sortKey ? (
                  <button type="button" class="sort-btn" data-sort-key={col.sortKey}>{col.label}</button>
                ) : (
                  col.label
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody id="horse-tbody" set:html={initialRowsHtml} />
    </table>
  </div>

  <h2>このツールでできること</h2>
  <p>
    {total}頭を1つの表で並べ替え・絞り込みしながら比較できます。次のことができます。
  </p>
  <ul>
    <li>列見出しをクリックして並べ替える（もう一度押すと昇順・降順が入れ替わります）</li>
    <li>馬名・父・母父・厩舎・性別で絞り込む</li>
    <li>一口価格・体高・管囲・馬体重を下限〜上限の範囲で絞り込む</li>
    <li>{hasSurgeryData ? '「母優先のみ」「手術・既往ありを除く」で候補を狭める' : '「母優先のみ」で候補を狭める'}</li>
    <li>各馬にA〜Eの評価・お気に入り（★）・消・メモを付け、「お気に入りのみ」「消を付けた馬を隠す」で見直す</li>
    <li>自分が付けたA〜Eで絞り込む（A・Bのように複数選べ、まだ印を付けていない「未評価」も選べます）</li>
    <li>「みんな」列で、他の利用者がその馬にどのA〜Eを付けているか（人数の内訳）を見る</li>
    <li>気になった馬はその場で netkeiba の個体ページや X の検索結果を開いて調べる</li>
  </ul>

  <h2>使い方</h2>
  <ol>
    <li>まず「一口 (万円)」で出せる予算に絞り、頭数を減らします。</li>
    <li>父・母父・厩舎など、自分が重視する条件で並べ替えて上から眺めます。</li>
    <li>気になった馬の <strong>評価欄（馬名のすぐ右）</strong> でA〜Eを選ぶか、★を押します。</li>
    <li>
      その右の <strong>「みんな」列</strong> で、他の利用者の印の分かれ方を見比べます
      （自分だけが高く見ている馬、意見が割れている馬が分かります）。
    </li>
    <li>検討から外した馬は「消」にチェックを入れ、「消を付けた馬を隠す」で視界から外します。</li>
    <li>
      ひと通り印を付けたら、絞り込みの <strong>「自分の評価」</strong> でA・Bだけにチェックを入れて
      上位だけを見比べます（複数選べます）。「未評価」を選べば、まだ印を付けていない馬の
      取りこぼしも確認できます。
    </li>
    <li>最後に「お気に入りのみ」にチェックを入れると、残った候補だけを見比べられます。</li>
  </ol>
  <p class="note">
    条件を全部戻したいときは「条件をクリア」を押してください。評価・お気に入り・消・メモは
    クリアされません。
  </p>

  <h2>測尺（体高・胸囲・管囲・馬体重）の見方</h2>
  <p>
    測尺は募集時点で計測された馬体のサイズです。単体の数値だけでは判断しづらいので、
    このツールでは同じ年の募集馬{total}頭の中での位置を見るために使えます
    （下の範囲は掲載データを集計した実測値です）。
  </p>
  <dl class="measure-list">
    {
      measurements.map((m) => (
        <div class="measure-item">
          <dt>{m.term}</dt>
          <dd>
            <p class="measure-meaning">{m.meaning}</p>
            <p class="measure-stat">
              {total}頭では {m.stat.min}〜{m.stat.max}{m.unit}（平均 {m.stat.avg}{m.unit}）
            </p>
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="note">
    数値の大小がそのまま良し悪しを表すわけではないため、このツールでは測尺に対する
    点数付けや推奨は行っていません。どこを重視するかは利用者が決めるものとしています。
  </p>

  <h2>「母優先」とは</h2>
  <p>
    その馬の母（繁殖牝馬）に出資している会員に優先枠がある、というクラブの制度上の区分です。
    一覧の「母優」列に◯が付いている馬が該当し、2026年募集馬では{total}頭中{damPriorityCount}頭が該当します。
    フィルタの「母優先のみ」で該当馬だけに絞り込めます。
  </p>

  <h2>掲載しているデータ</h2>
  <p>
    2026年募集馬の確定リストに載っている客観情報だけを収録しています（{total}頭・
    牡{maleCount}頭／牝{femaleCount}頭）。個人の評価・見送り判断は含みません。
  </p>
  <ul>
    <li>父は{sireKinds}種類、母父は{bmsKinds}種類、厩舎の記載は{stableKinds}通り</li>
    <li>一口価格は{priceRange.min}万円〜{priceRange.max}万円（中央値{priceRange.median}万円）</li>
    <li>
      {
        hasSurgeryData
          ? `手術・既往の記載がある馬は${surgeryCount}頭（「手術・既往」列に赤字で表示）`
          : '手術・既往は今年の募集リストに記載が無いため、この一覧では収録していません'
      }
    </li>
    <li>兄弟欄に記載のない馬は{noSiblingCount}頭</li>
  </ul>
  <p class="note">
    データは募集馬確定リスト時点のものです。最新の情報や実際の募集条件は必ずクラブ公式でご確認ください。
  </p>

  <h2>よくある質問</h2>
  <div class="faq">
    {
      faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

  <style>
    .lead { color: var(--muted); margin-top: 0; }
    .note { color: var(--muted); font-size: 0.875rem; }
    /* 年度切り替えの導線。本文より弱く、でも見落とさない程度に */
    .year-switch { margin: 0 0 0.5rem; font-size: 0.875rem; color: var(--muted); }

    .unofficial {
      margin: 0 0 0.5rem;
      padding: 0.6rem 0.8rem;
      border-left: 3px solid var(--accent);
      background: var(--accent-weak);
      font-size: 0.8125rem;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem 1.1rem;
      align-items: end;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      margin-block: 1.25rem 0.75rem;
      font-size: 0.875rem;
    }
    .filters label {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      color: var(--muted);
    }
    .filters input[type='text'],
    .filters input[type='number'],
    .filters select {
      font: inherit;
      padding: 0.4rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: var(--bg);
      color: var(--text);
      max-width: 11rem;
    }
    .filters .range {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      color: var(--muted);
    }
    .filters .range input { width: 4.5rem; }

    .toggles {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.9rem;
      width: 100%;
      border-top: 1px solid var(--border);
      padding-top: 0.9rem;
    }

    /* 入力欄の行とチェックボックスの行の区切りは .toggles と同じ扱いにして、
       「条件の種類が変わった」ことを罫線1本だけで示す（枠や背景は重ねない）。 */
    .rating-filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.9rem;
      width: 100%;
      border-top: 1px solid var(--border);
      padding-top: 0.9rem;
    }
    .rating-filters-label { color: var(--muted); }
    .rating-filters-hint {
      color: var(--muted);
      font-size: 0.8125rem;
      margin-left: auto;
    }
    /* チェックボックスと印は一体で押したいので、他のトグルより間隔を詰める */
    .rating-option { gap: 0.3rem !important; }
    .rating-chip {
      display: inline-block;
      min-width: 1.6rem;
      padding: 0.1rem 0.4rem;
      border: 1px solid transparent; /* 未評価だけ枠線を出すので、幅を揃えるために全員に持たせる */
      border-radius: 4px;
      text-align: center;
      font-weight: 600;
      font-size: 0.8125rem;
      line-height: 1.4;
    }
    /* 色は表の評価セレクト（BaseLayout の --rating-*）と同じものを使う */
    .rating-chip[data-rating='A'] { background: var(--rating-a-bg); color: var(--rating-a-fg); }
    .rating-chip[data-rating='B'] { background: var(--rating-b-bg); color: var(--rating-b-fg); }
    .rating-chip[data-rating='C'] { background: var(--rating-c-bg); color: var(--rating-c-fg); }
    .rating-chip[data-rating='D'] { background: var(--rating-d-bg); color: var(--rating-d-fg); }
    .rating-chip[data-rating='E'] { background: var(--rating-e-bg); color: var(--rating-e-fg); }
    /* 未評価は「印が無い」状態なので色を持たせない。表の未評価セレクトと同じ地の見た目にする。 */
    .rating-chip-unrated {
      border-color: var(--border);
      color: var(--muted);
      font-weight: 400;
    }
    .checkbox-label {
      flex-direction: row !important;
      align-items: center;
      gap: 0.35rem !important;
      color: var(--text) !important;
    }
    #filter-reset {
      font: inherit;
      font-size: 0.8125rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      color: var(--text);
      margin-left: auto;
    }
    #filter-reset:hover { border-color: var(--accent); color: var(--accent); }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
    }

    .result-count {
      color: var(--muted);
      font-size: 0.8125rem;
      margin: 0 0 0.25rem;
    }

    /* 表幅が画面に収まらないことに気づかず、評価欄（右方向）を見落とす人がいたため明示する */
    .scroll-hint {
      color: var(--muted);
      font-size: 0.8125rem;
      margin: 0 0 0.5rem;
    }
    .scroll-hint strong { color: var(--text); }

    .measure-list { margin: 0.75rem 0 0; }
    .measure-item {
      display: grid;
      grid-template-columns: 5rem 1fr;
      gap: 0.5rem 1rem;
      padding: 0.6rem 0;
      border-top: 1px solid var(--border);
    }
    .measure-item dt { font-weight: 600; }
    .measure-item dd { margin: 0; }
    .measure-meaning { margin: 0; }
    .measure-stat { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.875rem; }
    @media (max-width: 32rem) {
      .measure-item { grid-template-columns: 1fr; gap: 0.15rem; }

      /* 幅の狭い画面では .filters label が max-width: 11rem のまま伸びず、
         右半分が空いた状態で1列ずつ折り返してしまう。各項目を横幅いっぱいにする。 */
      .filters label { flex: 1 1 100%; min-width: 0; }
      /* ただし評価の印は中身が1文字なので、横幅いっぱいにすると6行を占有してしまう。
         ここだけは内容幅のまま横に並べる。 */
      .filters .rating-filters label { flex: 0 0 auto; }
      /* 印を折り返した行に「未選択なら全頭」が取り残されないよう、右寄せをやめる */
      .rating-filters-hint { margin-left: 0; flex-basis: 100%; }
      .filters input[type='text'],
      .filters input[type='number'],
      .filters select {
        max-width: none;
        width: 100%;
      }
      /* .range 自体に幅を明示しないと、中の input(flex:1 1 0) が親(label)の幅ではなく
         自分たちの内容サイズを基準に広がり、ラベルより広くなって画面右にはみ出していた。 */
      .filters .range { width: 100%; min-width: 0; }
      .filters .range input { width: auto; flex: 1 1 0; min-width: 0; }
    }

    .faq-item { border-top: 1px solid var(--border); padding-top: 0.75rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.25rem; }
    .faq-item p { margin: 0 0 1rem; }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  </style>

  <!--
    表の行はクライアント側の script が innerHTML で描き直すため、Astro のスコープ属性が
    付かない。スコープ付き <style> のセレクタは一致せず無効になるので、表まわりだけは
    is:global にする（誤爆を避けるため全セレクタを #horse-table 配下に限定する）。
  -->
  <style is:global>
    #horse-table {
      border-collapse: collapse;
      width: 100%;
      font-size: 0.8125rem;
      white-space: nowrap;
    }
    #horse-table th,
    #horse-table td {
      padding: 0.4rem 0.55rem;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: middle;
    }
    #horse-table thead th {
      background: var(--accent-weak);
      position: sticky;
      top: 0;
      z-index: 2;
    }
    #horse-table th.num,
    #horse-table td.num { text-align: right; }
    #horse-table tbody tr:hover td { background: var(--accent-weak); }

    /* 左端3列（No・馬名・評価）は固定するので、幅を固定して left オフセットと一致させる。
       auto レイアウトのままだと中身に応じて列幅が伸び、固定位置とずれて列が重なる。
       3.5rem + 12.5rem = 16rem が評価列の左オフセットになる。 */
    #horse-table th:nth-child(1),
    #horse-table td:nth-child(1) {
      width: 3.5rem;
      min-width: 3.5rem;
      max-width: 3.5rem;
    }
    #horse-table th:nth-child(2),
    #horse-table td:nth-child(2) {
      width: 12.5rem;
      min-width: 12.5rem;
      max-width: 12.5rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #horse-table th:nth-child(3),
    #horse-table td:nth-child(3) {
      width: 10rem;
      min-width: 10rem;
      max-width: 10rem;
    }

    /* 表は画面幅に収まらない（実データで約2000px）。評価欄を操作している間もどの馬か
       分かるように、馬名は画面幅を問わず常に左端に固定する。No・評価まで固定するのは
       狭い画面では表示領域をほぼ使い切ってしまうため、広い画面だけに追加で固定する。
       固定列は背景を塗らないと、下を流れる列が透けて重なって見える。 */
    #horse-table th:nth-child(2),
    #horse-table td:nth-child(2) {
      position: sticky;
      left: 0;
      background: var(--surface);
      z-index: 1;
      /* 固定列とスクロール部分の境目。罫線だと表の他の線と紛れるので、
         「この下を内容が流れている」ことが分かる弱い影にする（枠線との二重使いはしない）。 */
      box-shadow: 6px 0 5px -5px rgb(0 0 0 / 0.28);
    }
    #horse-table thead th:nth-child(2) {
      background: var(--accent-weak);
      z-index: 3; /* 縦横どちらの固定にも勝つ必要がある */
    }
    #horse-table tbody tr:hover td:nth-child(2) { background: var(--accent-weak); }

    @media (min-width: 56rem) {
      #horse-table th:nth-child(1),
      #horse-table td:nth-child(1) {
        position: sticky;
        left: 0;
        background: var(--surface);
        z-index: 1;
      }
      /* 広い画面では No 列が左端に来るため、馬名列は No 列の幅ぶん右にずらし、
         境目の影は評価列側（新しい右端）に移す。 */
      #horse-table th:nth-child(2),
      #horse-table td:nth-child(2) {
        left: 3.5rem;
        box-shadow: none;
      }
      #horse-table th:nth-child(3),
      #horse-table td:nth-child(3) {
        position: sticky;
        left: 16rem;
        background: var(--surface);
        z-index: 1;
        box-shadow: 6px 0 5px -5px rgb(0 0 0 / 0.28);
      }
      #horse-table thead th:nth-child(1),
      #horse-table thead th:nth-child(3) {
        background: var(--accent-weak);
        z-index: 3;
      }
      #horse-table tbody tr:hover td:nth-child(1),
      #horse-table tbody tr:hover td:nth-child(3) { background: var(--accent-weak); }
    }

    #horse-table .sort-btn {
      font: inherit;
      font-weight: 600;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--text);
      padding: 0;
      white-space: nowrap;
    }
    #horse-table .sort-btn:hover { color: var(--accent); }
    #horse-table .sort-btn[data-active='true'] { color: var(--accent); }

    #horse-table .horse-name { font-weight: 600; }
    #horse-table .sibling,
    #horse-table .surgery {
      max-width: 12rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #horse-table .surgery { color: var(--danger); }
    #horse-table .dam-priority { color: var(--accent); font-weight: 600; }

    #horse-table .links a {
      margin-right: 0.35rem;
      font-size: 0.75rem;
    }

    /* <td> 自体を flex にするとテーブルの縦位置計算が壊れるので、必ず内側の div に当てる */
    #horse-table .eval-cell {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    #horse-table .rating-select {
      font: inherit;
      font-size: 0.8125rem;
      padding: 0.2rem 0.3rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--text);
    }
    #horse-table .favorite-btn {
      font-size: 0.9rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      width: 1.7rem;
      height: 1.7rem;
      cursor: pointer;
      color: var(--border);
      line-height: 1;
      flex: none;
    }
    #horse-table .favorite-btn[aria-pressed='true'] {
      color: var(--accent);
      border-color: var(--accent);
    }
    #horse-table .skip-label {
      display: flex;
      align-items: center;
      gap: 0.2rem;
      color: var(--muted);
    }
    #horse-table .memo-input {
      font: inherit;
      font-size: 0.8125rem;
      padding: 0.25rem 0.4rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--text);
      width: 11rem;
    }
    #horse-table tr[data-skip='true'] { opacity: 0.4; }
  </style>

  <script>
    import { horses2026 } from '../data/horses2026.ts';
    import {
      sortHorses,
      filterHorses,
      type Sex,
      type SortKey,
      type SortDirection,
      type HorseFilter,
      type RatingFilterValue,
    } from '../lib/horses.ts';
    import {
      loadEvaluations,
      saveEvaluations,
      getEvaluation,
      updateEvaluation,
      ratingsByHorseId,
      storageKeyForYear,
      type Evaluation,
      type EvaluationMap,
    } from '../lib/evaluations.ts';
    // 行のマークアップはビルド時と共有する。ここで別に組み立てると二重管理になり、
    // 初期HTML（＝クローラーが見る内容）と描き直した後の表がずれる。
    import { COLUMNS, horseRowHtml } from '../lib/horse-row.ts';
    import { fetchPeerSummary, submitRating } from '../lib/evaluation-client.ts';
    import type { EvaluationSummary, RatingCounts } from '../lib/evaluation-api.ts';

    const tbody = document.getElementById('horse-tbody') as HTMLTableSectionElement;
    const resultCount = document.getElementById('result-count') as HTMLElement;
    const sortButtons = document.querySelectorAll<HTMLButtonElement>('.sort-btn');

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const filterName = el<HTMLInputElement>('filter-name');
    const filterSire = el<HTMLSelectElement>('filter-sire');
    const filterBms = el<HTMLInputElement>('filter-bms');
    const filterStable = el<HTMLSelectElement>('filter-stable');
    const filterSex = el<HTMLSelectElement>('filter-sex');
    const filterPriceMin = el<HTMLInputElement>('filter-price-min');
    const filterPriceMax = el<HTMLInputElement>('filter-price-max');
    const filterHeightMin = el<HTMLInputElement>('filter-height-min');
    const filterHeightMax = el<HTMLInputElement>('filter-height-max');
    const filterCaretMin = el<HTMLInputElement>('filter-caret-min');
    const filterCaretMax = el<HTMLInputElement>('filter-caret-max');
    const filterWeightMin = el<HTMLInputElement>('filter-weight-min');
    const filterWeightMax = el<HTMLInputElement>('filter-weight-max');
    const filterDamPriority = el<HTMLInputElement>('filter-dam-priority');
    // 手術・既往のデータが1件も無い年はチェックボックス自体を出していないので null になりうる
    const filterExcludeSurgery = document.getElementById('filter-exclude-surgery') as HTMLInputElement | null;
    const filterHideSkip = el<HTMLInputElement>('filter-hide-skip');
    const filterFavoriteOnly = el<HTMLInputElement>('filter-favorite-only');
    const filterResetBtn = el<HTMLButtonElement>('filter-reset');
    // A〜E＋未評価。個別にidを振らず、値（value）をそのままフィルタ条件に使う
    const ratingCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-rating'));

    const textInputs = [filterName, filterBms, filterPriceMin, filterPriceMax, filterHeightMin, filterHeightMax, filterCaretMin, filterCaretMax, filterWeightMin, filterWeightMax];
    const selects = [filterSire, filterStable, filterSex];
    // 評価チェックボックスもここに混ぜる。listener登録と「条件をクリア」の対象が同じで済む。
    const toggles = [filterDamPriority, filterExcludeSurgery, filterHideSkip, filterFavoriteOnly, ...ratingCheckboxes].filter(
      (t): t is HTMLInputElement => t !== null,
    );

    let sortKey: SortKey = 'id';
    let sortDirection: SortDirection = 'asc';
    // 保存キーは募集年ごとに分ける。/2025/ と同じキーを使うと、馬IDが年ごとに1から
    // 振り直される都合で別の馬の評価が出てしまう。
    const storageKey = storageKeyForYear(2026);
    let evaluations: EvaluationMap = loadEvaluations(window.localStorage, storageKey);

    const RECRUIT_YEAR = 2026;
    /**
     * 他会員の評価分布。`null` = まだAPIから取れていない（表には「…」を出す）。
     * 取得できたら中身を入れて描き直す。取得に失敗した場合も空オブジェクトが入るので、
     * いつまでも「…」のままにはならない。
     */
    let peerSummary: EvaluationSummary | null = null;

    function numberValue(input: HTMLInputElement): number | undefined {
      return input.value === '' ? undefined : Number(input.value);
    }

    function currentFilter(): HorseFilter {
      const filter: HorseFilter = {};
      if (filterName.value.trim()) filter.name = filterName.value.trim();
      if (filterSire.value) filter.sire = filterSire.value;
      if (filterBms.value.trim()) filter.broodmareSire = filterBms.value.trim();
      if (filterStable.value) filter.stable = filterStable.value;
      if (filterSex.value) filter.sex = filterSex.value as Sex;
      filter.minPrice = numberValue(filterPriceMin);
      filter.maxPrice = numberValue(filterPriceMax);
      filter.minHeight = numberValue(filterHeightMin);
      filter.maxHeight = numberValue(filterHeightMax);
      filter.minCaretGirth = numberValue(filterCaretMin);
      filter.maxCaretGirth = numberValue(filterCaretMax);
      filter.minWeight = numberValue(filterWeightMin);
      filter.maxWeight = numberValue(filterWeightMax);
      if (filterDamPriority.checked) filter.damPriorityOnly = true;
      if (filterExcludeSurgery?.checked) filter.excludeSurgery = true;
      // 自分の評価は端末ごとの状態なので、Horse ではなく「馬ID→印」の対応表として渡す。
      // 1つも選んでいないときは条件自体を積まない（＝全頭表示のまま）。
      const ratings = selectedRatings();
      if (ratings.length > 0) {
        filter.ratings = ratings;
        filter.ratingByHorseId = ratingsByHorseId(evaluations);
      }
      return filter;
    }

    function selectedRatings(): RatingFilterValue[] {
      return ratingCheckboxes.filter((c) => c.checked).map((c) => c.value as RatingFilterValue);
    }

    /**
     * 「みんな」列に渡す値。未取得は `undefined`（「…」）、取得済みだが1票も無い馬は
     * `null`（「−」）と区別する。同じ表示にすると、通信に失敗しているのか本当に0票なのかが
     * 利用者に伝わらない。
     */
    function peerCountsFor(horseId: string): RatingCounts | null | undefined {
      if (!peerSummary) return undefined;
      return peerSummary[horseId] ?? null;
    }

    function render() {
      let list = filterHorses(horses2026, currentFilter());
      // 評価はユーザーごとの状態なので、客観データのフィルタとは分けてここで適用する
      if (filterHideSkip.checked) {
        list = list.filter((h) => !getEvaluation(evaluations, h.id).skip);
      }
      if (filterFavoriteOnly.checked) {
        list = list.filter((h) => getEvaluation(evaluations, h.id).favorite);
      }
      list = sortHorses(list, sortKey, sortDirection);

      tbody.innerHTML =
        list.length === 0
          ? `<tr><td colspan="${COLUMNS.length}">条件に一致する馬がいません。</td></tr>`
          : list
              .map((h) => horseRowHtml(h, getEvaluation(evaluations, h.id), undefined, peerCountsFor(h.id)))
              .join('');
      resultCount.textContent = `${list.length} / ${horses2026.length} 頭`;

      for (const btn of sortButtons) {
        const active = btn.dataset.sortKey === sortKey;
        btn.setAttribute('data-active', String(active));
        const label = btn.textContent!.replace(/\s*[▲▼]$/u, '');
        btn.textContent = active ? `${label} ${sortDirection === 'asc' ? '▲' : '▼'}` : label;
      }
    }

    function persistEvaluation(horseId: string, patch: Partial<Evaluation>) {
      evaluations = updateEvaluation(evaluations, horseId, patch);
      saveEvaluations(window.localStorage, storageKey, evaluations);
    }

    for (const btn of sortButtons) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sortKey as SortKey;
        if (sortKey === key) {
          sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
          sortKey = key;
          sortDirection = 'asc';
        }
        render();
      });
    }

    for (const input of textInputs) input.addEventListener('input', render);
    for (const select of selects) select.addEventListener('change', render);
    for (const toggle of toggles) toggle.addEventListener('change', render);

    filterResetBtn.addEventListener('click', () => {
      for (const input of textInputs) input.value = '';
      for (const select of selects) select.value = '';
      for (const toggle of toggles) toggle.checked = false;
      render();
    });

    // 評価UIの変更はイベント委譲で拾う（再描画のたびに listener を付け直さなくて済む）。
    // メモ欄は blur を待たず入力のたびに保存する（'change' は blur/Enter まで発火しないため、
    // 入力途中で離脱するとメモが失われてしまう）。
    tbody.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (target.getAttribute('data-field') !== 'memo') return;
      const row = target.closest('tr[data-horse-id]') as HTMLTableRowElement | null;
      if (!row) return;
      persistEvaluation(row.dataset.horseId!, { memo: (target as HTMLInputElement).value });
    });

    tbody.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      const row = target.closest('tr[data-horse-id]') as HTMLTableRowElement | null;
      if (!row) return;
      const horseId = row.dataset.horseId!;
      const field = target.getAttribute('data-field');

      if (field === 'rating') {
        const value = (target as HTMLSelectElement).value;
        // 背景色はCSSの [data-rating] で当てているので、選択のたびに属性も更新する
        target.setAttribute('data-rating', value);
        const rating = value ? (value as Evaluation['rating']) : null;
        persistEvaluation(horseId, { rating });
        // 集計へ送るのは A〜E だけ。★・消・メモは送らない（送信経路そのものが無い）。
        // 失敗しても submitRating 側で握りつぶすので、表示は localStorage の内容のまま動く。
        void submitRating(RECRUIT_YEAR, horseId, rating);
        // 評価で絞り込んでいる最中に印を変えると、その馬が条件から外れる（入る）ので描き直す。
        // 消・★のトグルと同じ扱い。
        if (selectedRatings().length > 0) render();
      } else if (field === 'skip') {
        const checked = (target as HTMLInputElement).checked;
        persistEvaluation(horseId, { skip: checked });
        row.dataset.skip = String(checked);
        if (filterHideSkip.checked) render();
      }
    });

    tbody.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.getAttribute('data-field') !== 'favorite') return;
      const row = target.closest('tr[data-horse-id]') as HTMLTableRowElement | null;
      if (!row) return;
      const pressed = target.getAttribute('aria-pressed') === 'true';
      target.setAttribute('aria-pressed', String(!pressed));
      persistEvaluation(row.dataset.horseId!, { favorite: !pressed });
      if (filterFavoriteOnly.checked) render();
    });

    // 初期HTMLは未評価の状態なので、保存済みの評価を反映するために一度描き直す。
    render();

    // 他会員の集計は非同期に載せる。表の描画を待たせないよう await せず、
    // 届いたところでもう一度描き直す（届かなくても表はそのまま使える）。
    void fetchPeerSummary(RECRUIT_YEAR).then((summary) => {
      peerSummary = summary;
      render();
    });
  </script>
</BaseLayout>
