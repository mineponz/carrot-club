---
/**
 * 分析記事「第2次募集の15頭を、過去のデータで見比べる」。
 *
 * 2026年度の第2次募集で今から出資できる15頭（`lotteryStatus2026.ts`の最新snapshot＝9/16
 * 「第2次募集対象馬一覧」）を、[[20260913-size-predicts-roi-for-fillies-only]]（project scope,
 * secondBrain）の物差しで見比べる。9/13に本人向けに作った提案資料の公開版にあたる。
 *
 * ## 15頭の集合は残口データから導く（直書きしない）
 * `remainingSharesByHorseId(remainingSharesRows(horses2026, LOTTERY_STATUS_SNAPSHOTS))` の
 * キー一覧＝今の募集回で残口がある馬。第2次募集は期間を決めた抽選で、残口は締切まで
 * 動かないため9/16snapshotのままでよい（本人回答・2026-09-19）。
 *
 * ## 群分けのロジックは`src/lib/second-offering-screen.ts`
 * 牝の判定（体重・胸囲とも中央値超／片方だけ／どちらも以下／下位1/4）は2017〜2023年度募集の
 * 牝285頭（一口価格判明）の実データから毎回計算する。牡は募集時データで有意な指標が無いため
 * 群分けしない（同ノート）。
 *
 * ## ◎○△等の印は付けない（本人合意・2026-09-19）
 * 条件に当てはまる馬を示すところまでで、判断は読者に委ねる。
 *
 * ## 他の会員の評価は載せない
 * D1に集計している「みんな」の評価は表示停止中の将来の有料機能候補
 * （[[20260821-hide-peer-evaluations]]）。この記事にも一切出さない。
 *
 * ## 受付期間は書かない
 * 第2次募集の受付期間はクラブ会員限定ページが未確認のため不明（本人回答・2026-09-19）。
 *
 * ## 本文が置いている前提はビルド時アサーションにしてある
 * 群の頭数・具体的な馬番の内訳・物差しの数値・15頭という頭数が残口データと一致することを
 * 実データで検算し、崩れたらビルドを落とす（[[20260825-assert-article-premises-at-build-time]]）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatTiles from '../../components/charts/StatTiles.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import MethodsLink from '../../components/MethodsLink.astro';
import AdSlot from '../../components/AdSlot.astro';
import { horses2026 } from '../../data/horses2026.ts';
import { LOTTERY_STATUS_SNAPSHOTS } from '../../data/lotteryStatus2026.ts';
import {
  remainingSharesRows,
  remainingSharesByHorseId,
  type RemainingSharesRow,
} from '../../lib/remaining-shares.ts';
import { loadRecruitsWithResults, loadDamRoster } from '../../lib/analysis-data.ts';
import {
  screenSecondOffering,
  gradeWinningSiblingsOf,
  FEMALE_SIZE_CATEGORY_ORDER,
  FEMALE_SIZE_CATEGORY_LABEL,
  computeColtChecks,
  coltSidesOf,
  COLT_CHECK_LABEL,
  COLT_CHECK_SIDE_LABEL,
  type ColtCheck,
  type FemaleSizeCategory,
} from '../../lib/second-offering-screen.ts';
import { horseDetailHref } from '../../lib/horse-row.ts';
import { formatP } from '../../lib/chart-math.ts';

const allRecruits = loadRecruitsWithResults();
const remainingRows = remainingSharesRows(horses2026, LOTTERY_STATUS_SNAPSHOTS);
const remainingById = new Map<string, RemainingSharesRow>(remainingRows.map((r) => [r.id, r]));
const targetIds = Object.keys(remainingSharesByHorseId(remainingRows));

const screen = screenSecondOffering(horses2026, targetIds, allRecruits);
const { benchmark } = screen;
const damRoster = loadDamRoster();

/** 残口の表示（一覧の「残口」列と同じ規則）。 */
function sharesLabel(id: string): string {
  const row = remainingById.get(id);
  if (!row || row.hasRemaining !== true) return '—';
  if (row.shares === null) return 'あり';
  return row.shares.kind === 'exact' ? `${row.shares.count}口` : `${row.shares.count}口以上`;
}

const bothAboveHorses = screen.females.filter((f) => f.category === 'both-above');
const regionalPendingRows = [...screen.females, ...screen.males]
  .filter((r) => r.regionalStablePending)
  .sort((a, b) => Number(a.horse.id) - Number(b.horse.id));

/** 重賞勝ち兄姉がいる馬（15頭のうち）。 */
const gradeSiblingRows = [...screen.females, ...screen.males]
  .map((row) => ({ row, siblings: gradeWinningSiblingsOf(row.horse, damRoster) }))
  .filter((r) => r.siblings.length > 0);

// ---- 本文が置いている前提のビルド時アサーション ----
const premiseErrors: string[] = [];

// 1. 対象は15頭（牝11・牡4）
if (targetIds.length !== 15) {
  premiseErrors.push(`第2次募集の対象頭数が変わった（${targetIds.length}頭 / 期待値15頭）。本文の頭数を直すこと。`);
}
if (screen.females.length !== 11) {
  premiseErrors.push(`牝の頭数が変わった（${screen.females.length}頭 / 期待値11頭）。`);
}
if (screen.males.length !== 4) {
  premiseErrors.push(`牡の頭数が変わった（${screen.males.length}頭 / 期待値4頭）。`);
}

// 2. 牝の物差し（母集団・中央値・下位1/4境界）
if (benchmark.n !== 285) {
  premiseErrors.push(`牝の母集団の頭数が変わった（${benchmark.n}頭 / 期待値285頭）。物差しの根拠の節を直すこと。`);
}
if (benchmark.medianWeightKg !== 438) {
  premiseErrors.push(`体重の中央値が変わった（${benchmark.medianWeightKg}kg / 期待値438kg）。`);
}
if (benchmark.medianChestGirthCm !== 174.5) {
  premiseErrors.push(`胸囲の中央値が変わった（${benchmark.medianChestGirthCm}cm / 期待値174.5cm）。`);
}
if (benchmark.bottomQuartileWeightBoundaryKg !== 417) {
  premiseErrors.push(
    `体重の下位1/4境界が変わった（${benchmark.bottomQuartileWeightBoundaryKg}kg / 期待値417kg）。` +
      '下位1/4群の判定に使っている数値なので、群分けと本文を直すこと。'
  );
}

// 3. 両方中央値超の群の回収率（35% vs 18%、有意差あり）
if (benchmark.above.n !== 113 || benchmark.restOrEqual.n !== 172) {
  premiseErrors.push(
    `両方中央値超群/それ以外群の頭数が変わった（${benchmark.above.n}頭 / ${benchmark.restOrEqual.n}頭、` +
      '期待値113頭/172頭）。「物差しの根拠」節の棒グラフの数字を直すこと。'
  );
}
if (!(benchmark.above.over100RatePct > benchmark.restOrEqual.over100RatePct)) {
  premiseErrors.push(
    '募集価格以上に稼いだ割合の大小関係が逆転した（両方中央値超群のほうが高い、と書いた本文を直すこと）。'
  );
}
if (!(benchmark.over100RateTest.p < 0.01)) {
  premiseErrors.push(
    `割合の差の検定が有意でなくなった（${formatP(benchmark.over100RateTest.p)}）。` +
      '「はっきりした差」と書いた本文を直すこと。'
  );
}

// 4. 15頭の群分け内訳（提案資料の内訳と一致するか）
const idsOf = (category: FemaleSizeCategory) =>
  screen.females
    .filter((f) => f.category === category)
    .map((f) => f.horse.id)
    .sort((a, b) => Number(a) - Number(b));
const EXPECTED_FEMALE_GROUPS: Record<FemaleSizeCategory, string[]> = {
  'both-above': ['12', '61'],
  'one-above': ['26', '82'],
  'below-median': ['20', '30', '34', '92'],
  'bottom-quartile-weight': ['37', '38', '93'],
};
for (const category of FEMALE_SIZE_CATEGORY_ORDER) {
  const actual = idsOf(category);
  const expected = EXPECTED_FEMALE_GROUPS[category];
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    premiseErrors.push(
      `${FEMALE_SIZE_CATEGORY_LABEL[category]}群の内訳が変わった（No.${actual.join('・')} / ` +
        `期待値No.${expected.join('・')}）。牝11頭の表と結論の段落を直すこと。`
    );
  }
}
const EXPECTED_MALE_IDS = ['31', '79', '91', '94'];
const actualMaleIds = screen.males.map((m) => m.horse.id).sort((a, b) => Number(a) - Number(b));
if (JSON.stringify(actualMaleIds) !== JSON.stringify(EXPECTED_MALE_IDS)) {
  premiseErrors.push(`牡の内訳が変わった（No.${actualMaleIds.join('・')} / 期待値No.${EXPECTED_MALE_IDS.join('・')}）。`);
}
const EXPECTED_REGIONAL_PENDING_IDS = ['91', '92', '93', '94'];
const actualRegionalPendingIds = regionalPendingRows
  .map((r) => r.horse.id)
  .sort((a, b) => Number(a) - Number(b));
if (JSON.stringify(actualRegionalPendingIds) !== JSON.stringify(EXPECTED_REGIONAL_PENDING_IDS)) {
  premiseErrors.push(
    `地方所属予定フラグの内訳が変わった（No.${actualRegionalPendingIds.join('・')} / ` +
      `期待値No.${EXPECTED_REGIONAL_PENDING_IDS.join('・')}）。「地方所属予定の注意」節を直すこと。`
  );
}

// 5. 重賞勝ち兄姉がいる馬はNo.20だけ（半兄ヒンドゥタイムズ・小倉大賞典(G3)）
const EXPECTED_GRADE_SIBLING_IDS = ['20'];
const actualGradeSiblingIds = gradeSiblingRows
  .map((r) => r.row.horse.id)
  .sort((a, b) => Number(a) - Number(b));
if (JSON.stringify(actualGradeSiblingIds) !== JSON.stringify(EXPECTED_GRADE_SIBLING_IDS)) {
  premiseErrors.push(
    `重賞勝ち兄姉がいる馬の内訳が変わった（No.${actualGradeSiblingIds.join('・') || 'なし'} / ` +
      `期待値No.${EXPECTED_GRADE_SIBLING_IDS.join('・')}）。「重賞勝ちの兄姉がいる馬」節を直すこと。`
  );
}

// 6. 対象15頭が残口データ（lotteryStatus2026.ts）の頭数と一致する（二重管理の検算）
if (targetIds.length !== Object.keys(remainingSharesByHorseId(remainingRows)).length) {
  premiseErrors.push('対象馬IDの取得元が食い違っている（screenSecondOffering呼び出しのバグの可能性）。');
}

// 7. 牡の見比べ（4項目×3つの見方＝12通り。差らしきものは体高×重賞だけ、という本文の前提）
const colt = computeColtChecks(allRecruits);
const coltByKey = new Map(colt.checks.map((c) => [c.key, c]));
const coltHeight = coltByKey.get('height')!;
const coltBirth = coltByKey.get('birthDate')!;
const coltPs = colt.checks.flatMap((c) => [
  { label: `${c.key}×勝ち上がり`, p: c.pWin },
  { label: `${c.key}×重賞`, p: c.pGrade },
  { label: `${c.key}×回収率`, p: c.pRoi },
]);
const coltSignificant = coltPs.filter((x) => x.p < 0.05).map((x) => x.label);
if (JSON.stringify(coltSignificant) !== JSON.stringify(['height×重賞'])) {
  premiseErrors.push(
    `牡でp<0.05になる組み合わせが「体高×重賞」だけではなくなった（${coltSignificant.join('・') || 'なし'}）。牡の節の本文を直すこと。`
  );
}
if (!(coltHeight.focus.gradeRatePct > coltHeight.rest.gradeRatePct)) {
  premiseErrors.push('体高の高い側のほうが重賞馬の割合が高い、という向きが崩れた。牡の節を直すこと。');
}
if (!(coltHeight.rest.winRatePct > coltHeight.focus.winRatePct)) {
  premiseErrors.push('体高の低い側のほうが勝ち上がり率がわずかに上、という本文の前提が崩れた。');
}
if (!(coltBirth.focus.gradeWinners > coltBirth.rest.gradeWinners) || coltBirth.pGrade < 0.05) {
  premiseErrors.push('早生まれ側の重賞馬が多いが偶然の範囲、という本文の前提が崩れた。');
}
const maleRows = screen.males.map((m) => ({ m, sides: coltSidesOf(m.horse, colt.checks) }));
const tallColts = maleRows.filter((r) => r.sides.height === true);
const centralColts = maleRows.filter((r) => !r.m.regionalStablePending);
if (
  JSON.stringify(tallColts.map((r) => r.m.horse.id)) !== JSON.stringify(['94']) ||
  !tallColts.every((r) => r.m.regionalStablePending)
) {
  premiseErrors.push('体高が中央値超の牡は地方所属予定のNo.94だけ、という本文の前提が崩れた。');
}
if (
  JSON.stringify(centralColts.map((r) => r.m.horse.id)) !== JSON.stringify(['31', '79']) ||
  !centralColts.every((r) => r.sides.birthDate === true)
) {
  premiseErrors.push('中央所属予定の牡はNo.31・79で、どちらも早生まれ側、という本文の前提が崩れた。');
}

/** 牡の比較表で、項目名から飛ばす既存記事（その項目を主題にした記事がある項目だけ）。 */
const COLT_ARTICLE_HREF: Readonly<Record<string, string | undefined>> = {
  height: '/articles/height/',
  weight: '/articles/weight/',
  birthDate: '/articles/birth-month/',
};

/** 項目の「真ん中の値」の表示。誕生日は1月1日からの日数を月日に直す。 */
function coltMedianLabel(c: ColtCheck): string {
  if (c.key === 'birthDate') {
    const d = new Date(Date.UTC(2025, 0, 1) + Math.round(c.median) * 86_400_000);
    return `${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
  }
  if (c.key === 'height') return `${c.median}cm`;
  if (c.key === 'weight') return `${c.median}kg`;
  return `${c.median}万円`;
}

if (premiseErrors.length > 0) {
  throw new Error(`第2次募集15頭記事の前提が崩れた:\n- ${premiseErrors.join('\n- ')}`);
}

// 広告コードは他の記事と同じもの（vault: 20260821-article-ad-embed-snippets）
const AD_SP_WIDE_A = 'f81bbb016a82d6366a0e2f70051b1a0c';
const AD_SP_WIDE_B = 'b4b7d55c89d5fc92c564979491a16ad1';
const AD_SP_RECT = '24e3e1a24f40d88ee1a0ca315c54a7b9';
const AD_PC_WIDE_A = 'f0efb5bd6ae3e164bb584a4dbb846f48';
const AD_PC_WIDE_B = '0a525f6469ec1f40642b4550e53d39cc';

const description = `第2次募集で今から出資できる15頭（牝11・牡4）を、過去の募集データで確かめた物差しで見比べた。牝は募集時の体重・胸囲がともに過去の中央値を超えると回収率100%超の割合がおよそ2倍になる。該当するのはNo.12・61の2頭。牡は測尺で絞れない。`;

/** 群ごとの見出しに出す短い説明。 */
const CATEGORY_NOTE: Record<FemaleSizeCategory, string> = {
  'both-above': `体重438kg・胸囲174.5cmの中央値を両方とも上回る馬（過去データで回収率100%超が35%）`,
  'one-above': '体重・胸囲のどちらか一方だけが中央値を上回る馬',
  'below-median': '体重・胸囲とも中央値以下の馬（下位1/4には入らない）',
  'bottom-quartile-weight': '体重が過去の下位1/4（417kg未満）の馬',
};
---

<BaseLayout
  title="第2次募集の15頭を、過去のデータで見比べる"
  description={description}
  breadcrumb={[
    { label: '分析記事', href: '/articles/' },
    { label: '第2次募集の15頭を、過去のデータで見比べる', href: '/articles/second-offering/' },
  ]}
  showHeaderNotices={false}
  ogImage="/og-article-second-offering-v1.png"
  ogImageAlt="分析記事「第2次募集の15頭を、過去のデータで見比べる」のカード画像（【非公式】キャロットクラブ出資馬検討ツール）"
>
  <article>
    <h1>第2次募集の15頭を、過去のデータで見比べる</h1>

    <p>
      第2次募集が始まった。1次、1.5次と進んで、今から出資できる馬は{targetIds.length}頭まで減った。1次で満口にならなかった馬が過去にどうなったかは、<a href="/articles/secondary-offering/">1.5次募集に回った馬の記事</a>で追いかけている。
    </p>
    <p>
      私は1.5次募集で1頭に申し込んで、出資が決まった。そのとき困ったのは、残っている馬がどれも同じくらいに見えてしまうことだった。1次で人気が集まらなかった馬どうしを比べるのだから、無理もない。だから、過去の募集馬のデータで確かめられる物差しを1本だけ探して、それで並べ直した。この記事は、その物差しを残りの{targetIds.length}頭に当てたものだ。
    </p>
    <p>
      結論から書く。<strong>牝馬は、募集時の馬体重と胸囲がどちらも過去の牝の真ん中より上かどうかで、その後の稼ぎがはっきり分かれてきた。{targetIds.length}頭の中でそれに当てはまるのはNo.{bothAboveHorses.map((f) => f.horse.id).join('とNo.')}の{bothAboveHorses.length}頭</strong>。牡馬のほうは、この物差しでは差が出ない。そこも正直に書いておく。
    </p>

    <StatTiles
      tiles={[
        { label: '第2次募集の対象', value: `${targetIds.length}頭`, note: `牝${screen.females.length}頭・牡${screen.males.length}頭` },
        {
          label: '牝の物差し（過去データ）',
          value: `${benchmark.medianWeightKg}kg / ${benchmark.medianChestGirthCm}cm`,
          note: '2017〜2023年度募集・牝の体重・胸囲の中央値',
        },
        {
          label: '両方中央値超の回収率100%超',
          value: `${Math.round(benchmark.above.over100RatePct)}%`,
          note: `それ以外は${Math.round(benchmark.restOrEqual.over100RatePct)}%（${formatP(benchmark.over100RateTest.p)}）`,
        },
        { label: '条件に当てはまる牝', value: `No.${bothAboveHorses.map((f) => f.horse.id).join('・')}`, note: '体重・胸囲とも中央値超' },
      ]}
    />

    <ArticleToc />
    <MethodsLink />

    <AdSlot sp={AD_SP_WIDE_A} pc={AD_PC_WIDE_A} />

    <h2>条件に当てはまる牝</h2>
    <p>
      募集時の馬体重が{benchmark.medianWeightKg}kgを超え、胸囲も{benchmark.medianChestGirthCm}cmを超えている牝は、今回の{targetIds.length}頭では次の{bothAboveHorses.length}頭だけだ。
    </p>
    <ul>
      {
        bothAboveHorses.map((f) => (
          <li>
            <a href={horseDetailHref(f.horse.id)}>No.{f.horse.id} {f.horse.name}</a>（父{f.horse.sire}・体重{f.horse.weight}kg・胸囲{f.horse.chestGirth}cm・一口{f.horse.pricePerShare}万円・残口{sharesLabel(f.horse.id)}）
          </li>
        ))
      }
    </ul>
    <p>
      {bothAboveHorses.length}頭のどちらが上かを決める材料は、このデータには無い。ここから先は血統や厩舎、ツアーで見た印象で選んでほしい。
    </p>

    <h2>物差しの根拠</h2>
    <p>
      2017〜2023年度に募集された牝馬のうち、一口価格が分かる{benchmark.n}頭を2つに分けた。募集時の馬体重と胸囲がどちらも中央値（{benchmark.medianWeightKg}kg・{benchmark.medianChestGirthCm}cm）を超えている{benchmark.above.n}頭と、それ以外の{benchmark.restOrEqual.n}頭だ。
    </p>

    <div class="hbar-group">
      <p class="hbar-title">募集価格以上に稼いだ割合（回収率100%超）</p>
      <div class="hbar-row">
        <span class="hbar-label">体重・胸囲とも中央値超（{benchmark.above.n}頭）</span>
        <span class="hbar-track">
          <span class="hbar-fill" style={`width:${Math.max(1.5, benchmark.above.over100RatePct)}%`} />
        </span>
        <span class="hbar-value">
          {Math.round(benchmark.above.over100RatePct)}%（{benchmark.above.over100Count}頭）
        </span>
      </div>
      <div class="hbar-row">
        <span class="hbar-label">それ以外（{benchmark.restOrEqual.n}頭）</span>
        <span class="hbar-track">
          <span class="hbar-fill is-muted" style={`width:${Math.max(1.5, benchmark.restOrEqual.over100RatePct)}%`} />
        </span>
        <span class="hbar-value">
          {Math.round(benchmark.restOrEqual.over100RatePct)}%（{benchmark.restOrEqual.over100Count}頭）
        </span>
      </div>

    </div>

    <div class="hbar-group">
      <p class="hbar-title">回収率の中央値</p>
      <div class="hbar-row">
        <span class="hbar-label">体重・胸囲とも中央値超（{benchmark.above.n}頭）</span>
        <span class="hbar-track">
          <span class="hbar-fill" style={`width:${Math.max(1.5, Math.min(100, benchmark.above.medianRoiPct))}%`} />
        </span>
        <span class="hbar-value">{Math.round(benchmark.above.medianRoiPct)}%</span>
      </div>
      <div class="hbar-row">
        <span class="hbar-label">それ以外（{benchmark.restOrEqual.n}頭）</span>
        <span class="hbar-track">
          <span class="hbar-fill is-muted" style={`width:${Math.max(1.5, Math.min(100, benchmark.restOrEqual.medianRoiPct))}%`} />
        </span>
        <span class="hbar-value">{Math.round(benchmark.restOrEqual.medianRoiPct)}%</span>
      </div>
    </div>

    <p class="table-note">回収率＝獲得賞金 ÷ 募集総額（一口価格×口数）。「中央値超」は境界値ちょうどを含まない。割合の差の検定は{formatP(benchmark.over100RateTest.p)}。</p>
    <p>
      募集価格以上に稼いだ馬の割合は、ほぼ2倍の開きになる。回収率の真ん中の値で比べると、差はもっと大きい。偶然でこれだけ開くことは、まず無い。
    </p>
    <p>
      ひとつ断っておくと、体重と胸囲はどちらも「体の大きさ」を測っている。根拠が2つ重なっているわけではなく、「大きい牝」という1本の物差しだと思って読んでほしい。体重だけ、胸囲だけで見た結果は<a href="/articles/weight/">馬体重の記事</a>と<a href="/articles/chest-girth/">胸囲の記事</a>に書いた。
    </p>

    <AdSlot sp={AD_SP_WIDE_B} pc={AD_PC_WIDE_B} />

    <h2>牝{screen.females.length}頭を群で見る</h2>
    <p>
      残りの牝も同じ物差しで並べた。体重と胸囲の片方だけが真ん中を超えている馬、どちらも届かない馬、そして体重が過去の牝の下位1/4（{benchmark.bottomQuartileWeightBoundaryKg}kg未満）に入る馬に分けている。下の群ほど、この物差しの上では分が悪い。ただ、分が悪いというだけで、走らないと決まったわけではない。牝の体重と成績の関係は、<a href="/articles/weight/">馬体重の記事</a>の「牝では『体高』ではなく『体重』で見る」の節にもう少し詳しく書いた。
    </p>

    {
      FEMALE_SIZE_CATEGORY_ORDER.map((category) => {
        const rows = screen.females.filter((f) => f.category === category);
        if (rows.length === 0) return null;
        return (
          <>
            <h3>
              {FEMALE_SIZE_CATEGORY_LABEL[category]}（{rows.length}頭）
            </h3>
            <p class="table-note">{CATEGORY_NOTE[category]}</p>
            <div class="table-scroll">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>馬名</th>
                    <th>父</th>
                    <th>体重</th>
                    <th>胸囲</th>
                    <th>一口価格</th>
                    <th>残口</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((f) => (
                    <tr>
                      <td data-label="No.">{f.horse.id}</td>
                      <td data-label="馬名">
                        <a href={horseDetailHref(f.horse.id)}>{f.horse.name}</a>{f.regionalStablePending && <span class="regional-tag">地方所属予定</span>}
                      </td>
                      <td data-label="父">{f.horse.sire}</td>
                      <td data-label="体重">{f.horse.weight}kg</td>
                      <td data-label="胸囲">{f.horse.chestGirth}cm</td>
                      <td data-label="一口価格">{f.horse.pricePerShare}万円</td>
                      <td data-label="残口">{sharesLabel(f.horse.id)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        );
      })
    }

    <AdSlot sp={AD_SP_RECT} pc={AD_PC_WIDE_A} />

    <h2>牡{screen.males.length}頭</h2>
    <p>
      牡も同じように調べた。募集時に分かる4つの項目（体高・馬体重・誕生日・一口価格）について、2017〜2023年度に募集された牡{colt.n}頭をそれぞれ真ん中の値で2つに分け、勝ち上がり率・重賞を勝った馬の数・回収率を比べている。
    </p>

    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>項目（真ん中の値）</th>
            <th>比べた2つ</th>
            <th>勝ち上がり率</th>
            <th>重賞馬</th>
            <th>回収率の中央値</th>
          </tr>
        </thead>
        <tbody>
          {
            colt.checks.map((c) => (
              <tr class:list={[{ 'is-notable': c.key === 'height' }]}>
                <td data-label="項目">
                  {COLT_ARTICLE_HREF[c.key] ? (
                    <a href={COLT_ARTICLE_HREF[c.key]}>{COLT_CHECK_LABEL[c.key]}</a>
                  ) : (
                    COLT_CHECK_LABEL[c.key]
                  )}（{coltMedianLabel(c)}）
                </td>
                <td data-label="比べた2つ">
                  {COLT_CHECK_SIDE_LABEL[c.key].focus} ／ {COLT_CHECK_SIDE_LABEL[c.key].rest}
                </td>
                <td data-label="勝ち上がり率">
                  {Math.round(c.focus.winRatePct)}% ／ {Math.round(c.rest.winRatePct)}%
                </td>
                <td data-label="重賞馬">
                  {c.focus.gradeWinners}頭（{Math.round(c.focus.gradeRatePct)}%） ／ {c.rest.gradeWinners}頭（{Math.round(c.rest.gradeRatePct)}%）
                </td>
                <td data-label="回収率の中央値">
                  {Math.round(c.focus.medianRoiPct)}% ／ {Math.round(c.rest.medianRoiPct)}%
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="table-note">項目名のリンク先は、その項目を牡牝あわせて調べた記事。一口価格と賞金の関係は<a href="/articles/height/">体高の記事</a>の「参考: 一口価格との比較」で扱っている。勝ち上がり率は出走した馬のうち1勝以上した割合。回収率の定義は牝と同じ。「真ん中の値」ちょうどの馬は、体高・体重・価格では低い側、誕生日では遅生まれ側に入れている。</p>

    <p>
      牝の体の大きさのような、はっきりした差はどこにも出なかった。勝ち上がり率はどの項目で分けてもほぼ同じだ。回収率の中央値は開いて見える項目もあるが、1頭ごとのばらつきが大きく、偶然でも出る程度の差に収まっている。
    </p>
    <p>
      唯一、差らしく見えるのが<strong>体高と重賞馬の関係</strong>だ。背の高い側から重賞馬が{coltHeight.focus.gradeWinners}頭、低い側からは{coltHeight.rest.gradeWinners}頭。割合にすると{Math.round(coltHeight.focus.gradeRatePct)}%と{Math.round(coltHeight.rest.gradeRatePct)}%になる。ただ、4項目×3つの見方で12回比べた中の1つだけなので、偶然の可能性を消しきれない。勝ち上がり率ではむしろ低い側がわずかに上だ。「背の高い牡からは大物が出やすいかもしれない」くらいに受け取っておくのがいいと思う。
    </p>
    <p>
      今回の牡{screen.males.length}頭を、この4項目で見るとこうなる。印（▲）が付いているのは、背が高い・重い・早生まれ・価格が高い側に入っている項目だ。
    </p>

    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>No.</th>
            <th>馬名</th>
            <th>体高</th>
            <th>体重</th>
            <th>誕生日</th>
            <th>一口価格</th>
            <th>残口</th>
          </tr>
        </thead>
        <tbody>
          {
            maleRows.map(({ m, sides }) => (
              <tr>
                <td data-label="No.">{m.horse.id}</td>
                <td data-label="馬名">
                  <a href={horseDetailHref(m.horse.id)}>{m.horse.name}</a>{m.regionalStablePending && <span class="regional-tag">地方所属予定</span>}
                </td>
                <td data-label="体高">{m.horse.height}cm{sides.height && <span class="side-mark">▲</span>}</td>
                <td data-label="体重">{m.horse.weight}kg{sides.weight && <span class="side-mark">▲</span>}</td>
                <td data-label="誕生日">
                  {Number(m.horse.birthDate.split('-')[1])}月{Number(m.horse.birthDate.split('-')[2])}日{sides.birthDate && <span class="side-mark">▲</span>}
                </td>
                <td data-label="一口価格">{m.horse.pricePerShare}万円{sides.pricePerShare && <span class="side-mark">▲</span>}</td>
                <td data-label="残口">{sharesLabel(m.horse.id)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>
      体高が真ん中を超えているのは{tallColts.map((r) => `No.${r.m.horse.id}`).join('・')}だけで、地方所属の予定だ。中央に入る予定の{centralColts.map((r) => `No.${r.m.horse.id}`).join('と')}は、どちらも早生まれの側に入っている。早生まれ側からは重賞馬が{coltBirth.focus.gradeWinners}頭、遅生まれ側からは{coltBirth.rest.gradeWinners}頭出ているが、これも偶然で片づけられる程度の差だ。誕生日と体格・成績の関係は<a href="/articles/birth-month/">誕生月の記事</a>でまとめて見ている。
    </p>
    <p>
      結局、牡の{screen.males.length}頭をデータで順位付けする根拠は無い。選ぶ材料は、血統や厩舎、ツアーで見た印象のほうにある。
    </p>

    <h2>地方所属予定の馬について</h2>
    <p>
      次の{regionalPendingRows.length}頭は地方所属の予定だ。ここまでの物差しは、中央に入った馬がほとんどを占めるデータで作っている。走る舞台も賞金の水準も違うので、上の群分けはそのまま当てはめないほうがいい。
    </p>
    <ul>
      {
        regionalPendingRows.map((r) => (
          <li>
            <a href={horseDetailHref(r.horse.id)}>No.{r.horse.id} {r.horse.name}</a>（{r.horse.stable}）
          </li>
        ))
      }
    </ul>

    <AdSlot sp={AD_SP_WIDE_A} pc={AD_PC_WIDE_A} />

    <h2>重賞勝ちの兄姉がいる馬</h2>
    {
      gradeSiblingRows.length > 0 ? (
        <>
          <p>
            一口馬主は夢を見る趣味でもある。体の大きさの物差しでは真ん中より下でも、兄姉が重賞を勝っている馬はいる。
          </p>
          <ul>
            {gradeSiblingRows.map(({ row, siblings }) => (
              <li>
                <a href={horseDetailHref(row.horse.id)}>
                  No.{row.horse.id} {row.horse.name}
                </a>の兄姉に{siblings.map((s, i) => (
                  <>
                    {i > 0 && '、'}<strong>{s.name}</strong>（{s.gradeWins.join('、')}）
                  </>
                ))}。
              </li>
            ))}
          </ul>
          <p>
            過去の募集馬で確かめると、重賞を勝った兄姉がいる牝は、本人も重賞を勝つ割合が上がっていた。ただ、勝ち上がれるかどうかはほとんど変わらない。「大きく当たるかもしれないが、外れる確率は他の馬と同じくらい」と受け取るのがちょうどいい。母がほかのクラブ（サンデーレーシングなど）の出身馬に絞った<a href="/articles/club-siblings/">別の記事</a>でも、「兄姉が重賞を勝っている馬はどうだったか」を追いかけている。
          </p>
        </>
      ) : (
        <p>今回の15頭では、過去にキャロットが募集していない兄姉も含めて重賞勝ち馬は見つからなかった。</p>
      )
    }

    <h2>この記事の限界</h2>
    <ul>
      <li>
        すべて過去の傾向で、1頭ずつの将来を言い当てるものではない。条件を満たした牝でも、募集価格以上に稼いだのは{Math.round(benchmark.above.over100RatePct)}%で、残りは届いていない。
      </li>
      <li>
        判定に使っているのは募集時の測尺だけだ。過去の馬も募集時の値で比べているので、ツアー後の体重は混ぜていない。
      </li>
      <li>回収率は獲得賞金の額面で計算している。実際に会員に届く分配は、維持費などが引かれてこれより下がる。</li>
      <li>手術歴がある馬の影響は確かめていない。</li>
    </ul>

    <h2>残口のある馬をまとめて見る</h2>
    <p>
      今から出資できる{targetIds.length}頭は<a href="/?remaining=1">一覧の「残口あり」ビュー</a>にまとまっている。馬名からはこのサイトの個別ページに飛べるので、気になった馬の血統・測尺を見てほしい。
    </p>

    <h2>データについて</h2>
    <p>
      牝の物差しは2017〜2023年度募集・牝{benchmark.n}頭（一口価格判明・測尺判明）から計算した。「中央値超」は境界値ちょうどを含まない。回収率＝獲得賞金 ÷ 募集総額（一口価格×口数）で、管理費・維持費・引退時の売却額を差し引いた実際の会員配当額ではない。第2次募集の対象馬・残り口数はクラブ公式発表（「{LOTTERY_STATUS_SNAPSHOTS.at(-1)!.label}」・{LOTTERY_STATUS_SNAPSHOTS.at(-1)!.asOf}時点）による。
    </p>

    <p>
      <a href="/">募集馬一覧へ戻る</a> ／ <a href="/articles/">分析記事一覧へ</a>
    </p>
  </article>
</BaseLayout>

