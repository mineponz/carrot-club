      border: none;
      padding: 0.15rem 0;
      display: flex;
      gap: 0.6rem;
      min-width: 0;
    }
    .recruit-table td::before {
      content: attr(data-label);
      flex: none;
      width: 6.5rem;
      color: var(--muted);
      font-size: 0.8125rem;
    }
  }
  .foal-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foal-list li + li {
    margin-top: 0.4rem;
  }
  .foal-meta,
  .dam-meta {
    display: block;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .grade-tag {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-weak);
    border-radius: 4px;
  }
  .grade-sib {
    display: inline-block;
  }
  .finding {
    margin: 1.25rem 0;
