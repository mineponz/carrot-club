  table.data-table td {
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  table.data-table th {
    color: var(--muted);
    font-weight: 600;
    white-space: nowrap;
  }
  /* 行見出し（母名）。狭い画面でも1文字ずつ折り返さないよう最小幅を確保する */
