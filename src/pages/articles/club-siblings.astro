    color: var(--text);
    font-weight: 700;
    min-width: 7rem;
    white-space: normal;
  }
  table.data-table tbody td {
    min-width: 11rem;
  }

  /*
   * 今年の募集馬の表はSP幅（390px）だと9列が1文字ずつ折り返して読めなくなる。
   * 横スクロールに逃がすより、1頭＝1カードに積み直したほうが読みやすい。
   * 見出しは `data-label` から出すので、列を足すときは td 側に属性を付け忘れないこと。
   */
  @media (max-width: 640px) {
    .recruit-table thead {
      display: none;
    }
    .recruit-table,
    .recruit-table tbody,
    .recruit-table tr,
