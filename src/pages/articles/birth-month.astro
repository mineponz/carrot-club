---
/**
 * 分析記事「誕生月と体格・成績の関係」。2017〜2025年募集の全頭（`analysis/data/recruits.json`）に
 * 新規追加した`birthDate`（生年月日。取得方法は`scripts/fetch-birth-date.mjs`、個体ページの
 * プロフィール表`生年月日`欄から）と、体高・馬体重・現在の競走成績をクロス集計する。
 * 体高記事（`height.astro`）・母齢記事（`dam-age.astro`）と同じデータ基盤・同じ書き方
 * （動的計算・実名紹介・広告配置）を踏襲する。
 *
 * 発端（本人 / 2026-08-24）: 「誕生日が遅くて小さい馬は買いか。人間の早生まれと同じで、
 * 誕生日が遅い馬は募集時点でまだ若いぶん小さく出やすいのでは」という仮説の検証。
 * JRAの馬齢は暦年（1/1）区切りで進むため、「誕生日が早い＝1月に近い」ほど同期の中で
 * 年長・大きく出やすく、「誕生日が遅い」ほど年少・小さく出やすい、という向きになる
 * （人間の学年のような4月区切りではない点に注意）。
 *
 * 一次分析（vault: 20260824-birth-month-size-correlation-article）で「早生まれで小さい馬」と
 * 「遅生まれで小さい馬」を比べると、平均総賞金は後者の方が高い傾向が出た。本人から
 * 「もっと厳密に検証してから」との指示を受けて外れ値・交絡・検定を追加確認し、reviewer
 * サブエージェントのレビューでさらに複数の問題（6月生n=1の外れ値がグラフの結論と矛盾、
 * 未検証の「偏りは無い」断定、体高記事への懸念に対する残差分析の欠如等）を修正済み。
 *
 * 2026-08-24、本人から公開後フィードバック（今後の記事執筆全般に適用、
 * vault: 3-resources/knowledge/20260824-carrot-club-article-writing-conventions.md）:
 * - 「データについて」節や本文に、○頭除外・本人指定といった内部向けの技術的経緯を書かない
 *   （記事は他の会員に読ませるもの。読者には結論と根拠だけ見せる）
 * - 一口馬主は夢を見る趣味なので、重賞勝ち馬の実例紹介に必ず触れる（height.astro踏襲）
 * - 「大きい/小さい」の基準を体高だけでなく馬体重も使って明確にする
 * これを受けて「大きい/小さい」の判定を体高・馬体重を標準化して平均した体格スコアに変更し、
 * 重賞勝ち馬紹介セクションを追加、文中の内部向け経緯説明を削った。
 *
 * 2025年募集（現2歳、93頭）は大半が未出走のため、体格×成績の主要な比較（4分割・検定）からは
 * 除外する。誕生日×体高・馬体重の相関（早生まれ効果そのもの）は成績を使わないため、
 * 2025年募集も含めた全頭で計算している。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarChart from '../../components/charts/BarChart.astro';
import ChartTooltip from '../../components/charts/ChartTooltip.astro';
import StatTiles from '../../components/charts/StatTiles.astro';
import AdSlot from '../../components/AdSlot.astro';
import GradeWinnerTable from '../../components/GradeWinnerTable.astro';
import { loadRecruitsWithResults, racedOnly, RACE_RESULTS_FETCHED_AT } from '../../lib/analysis-data.ts';
import { formatResultsAsOf } from '../../lib/sibling-recruits.ts';
import { pearsonCorrelation, mean, median, formatManYen, mannWhitneyU } from '../../lib/chart-math.ts';

/**
 * 誕生日を「年に依存しない通し日数」に変換する（1〜366）。同じ月日でも生まれ年のうるう年
 * 有無で通し日数が1日ずれる（2/29以降）のを避けるため、常に固定の平年（2001年）で計算する。
 * 2/29生まれは3/1と同じ扱いにする。
 */
function dayOfYear(isoDate: string): number {
  const [, m, d] = isoDate.split('-').map(Number);
  if (m === 2 && d === 29) return 60;
  const start = Date.UTC(2001, 0, 1);
  const cur = Date.UTC(2001, m - 1, d);
  return Math.round((cur - start) / 86400000) + 1;
}

function linreg(xs: readonly number[], ys: readonly number[]): { a: number; b: number } {
  const mx = mean(xs);
  const my = mean(ys);
  let num = 0;
  let den = 0;
  for (let i = 0; i < xs.length; i++) {
    num += (xs[i] - mx) * (ys[i] - my);
    den += (xs[i] - mx) ** 2;
  }
  const b = den === 0 ? 0 : num / den;
  return { a: my - b * mx, b };
}

function stddev(values: readonly number[]): number {
  const m = mean(values);
  return Math.sqrt(mean(values.map((v) => (v - m) ** 2)));
}

const allWithResults = loadRecruitsWithResults();
const resultsAsOf = formatResultsAsOf(RACE_RESULTS_FETCHED_AT);
const all = allWithResults.filter((h) => h.birthDate !== null);

// ---- 誕生月の分布 ----
const months = all.map((h) => Number((h.birthDate as string).split('-')[1]));
const monthBins = Array.from({ length: 12 }, (_, i) => i + 1)
  .map((m) => ({ m, count: months.filter((v) => v === m).length }))
  .filter((b) => b.count > 0);
const monthBars = monthBins.map((b) => ({
  label: `${b.m}月`,
  value: b.count,
  displayValue: `${b.count}頭`,
}));

// ---- 誕生日(通し日数) × 体高・馬体重 の相関（早生まれ効果そのものの確認） ----
const withHeight = all.filter((h) => h.height !== null);
const withWeight = all.filter((h) => h.weight !== null);
const doyHeightR = pearsonCorrelation(
  withHeight.map((h) => dayOfYear(h.birthDate as string)),
  withHeight.map((h) => h.height as number)
);
const doyWeightR = pearsonCorrelation(
  withWeight.map((h) => dayOfYear(h.birthDate as string)),
  withWeight.map((h) => h.weight as number)
);

// 月別の平均体高（早生まれ効果を見た目で示す）。サンプルが極端に少ない月（6月はn=1）は
// 1頭の値がそのまま棒になり、傾向を誤読させるので表示対象から外す。
const MIN_MONTH_N = 10;
const monthAvgBars = monthBins
  .filter((b) => b.count >= MIN_MONTH_N)
  .map((b) => {
    const hs = withHeight.filter((h) => Number((h.birthDate as string).split('-')[1]) === b.m).map((h) => h.height as number);
    return {
      label: `${b.m}月生`,
      value: hs.length ? mean(hs) : 0,
      displayValue: hs.length ? `${mean(hs).toFixed(1)}cm` : '—',
      n: hs.length,
    };
  });

// ---- 体高そのもの×成績、誕生日で補正した体高残差×成績 の相関比較 ----
// 「体高が小さいと成績が振るわない」（前回の体高記事）は、単に遅生まれの若い馬を
// 不当に評価し損なっているだけではないか、という冒頭の懸念を直接検証する。
const racedWithHeight = racedOnly(withHeight);
const heightPrizeR = pearsonCorrelation(
  racedWithHeight.map((h) => h.height as number),
  racedWithHeight.map((h) => h.totalPrizeManYen)
);
const heightRegression = linreg(
  withHeight.map((h) => dayOfYear(h.birthDate as string)),
  withHeight.map((h) => h.height as number)
);
const residualPrizeR = pearsonCorrelation(
  racedWithHeight.map(
    (h) => (h.height as number) - (heightRegression.a + heightRegression.b * dayOfYear(h.birthDate as string))
  ),
  racedWithHeight.map((h) => h.totalPrizeManYen)
);

// ---- 本題: 「小さい馬」を誕生タイミングで分けると成績に差があるか ----
// 2025年募集（現2歳）は大半が未出走のため主要な比較からは除外する。
// 「大きい/小さい」は体高だけでなく馬体重も判断材料にするため、両方を標準化して平均した
// 「体格スコア」で判定する（体高だけ・馬体重だけで見ても結論の向きは変わらない）。
const matureOnly = all.filter((h) => h.recruitYear !== 2025 && h.height !== null && h.weight !== null);
const doyMedian = median(matureOnly.map((h) => dayOfYear(h.birthDate as string)));
const heightMedian = median(matureOnly.map((h) => h.height as number));
const weightMedian = median(matureOnly.map((h) => h.weight as number));
const heightMeanAll = mean(matureOnly.map((h) => h.height as number));
const heightSd = stddev(matureOnly.map((h) => h.height as number)) || 1;
const weightMeanAll = mean(matureOnly.map((h) => h.weight as number));
const weightSd = stddev(matureOnly.map((h) => h.weight as number)) || 1;
function sizeScore(h: (typeof matureOnly)[number]): number {
  const hz = ((h.height as number) - heightMeanAll) / heightSd;
  const wz = ((h.weight as number) - weightMeanAll) / weightSd;
  return (hz + wz) / 2;
}
const sizeScoreMedian = median(matureOnly.map(sizeScore));
const bigCount = matureOnly.filter((h) => sizeScore(h) >= sizeScoreMedian).length;
const smallCount = matureOnly.length - bigCount;

type Quadrant = '早生まれ・大きい' | '早生まれ・小さい' | '遅生まれ・大きい' | '遅生まれ・小さい';
function quadrantOf(h: (typeof matureOnly)[number]): Quadrant {
  const early = dayOfYear(h.birthDate as string) <= doyMedian;
  const big = sizeScore(h) >= sizeScoreMedian;
  if (early && big) return '早生まれ・大きい';
  if (early && !big) return '早生まれ・小さい';
  if (!early && big) return '遅生まれ・大きい';
  return '遅生まれ・小さい';
}
function isMaleOrGelding(sex: string | null): boolean {
  return sex === '牡' || sex === 'セン';
}

const maturedRaced = racedOnly(matureOnly);
const quadrantOrder: Quadrant[] = ['早生まれ・大きい', '早生まれ・小さい', '遅生まれ・大きい', '遅生まれ・小さい'];
const quadrantGroups = new Map<Quadrant, typeof maturedRaced>();
for (const h of maturedRaced) {
  const q = quadrantOf(h);
  quadrantGroups.set(q, [...(quadrantGroups.get(q) ?? []), h]);
}
const quadrantStats = quadrantOrder.map((q) => {
  const g = quadrantGroups.get(q) ?? [];
  const prizes = g.map((h) => h.totalPrizeManYen);
  const gradeWinners = g.filter((h) => h.gradeWins.length > 0).length;
  return {
    label: q,
    n: g.length,
    avgPrize: g.length ? mean(prizes) : 0,
    medianPrize: g.length ? median(prizes) : 0,
    gradeWinners,
    gradeRate: g.length ? (gradeWinners / g.length) * 100 : 0,
    maleShare: g.length ? (g.filter((h) => isMaleOrGelding(h.sex)).length / g.length) * 100 : 0,
    avgRecruitYear: g.length ? mean(g.map((h) => h.recruitYear)) : 0,
  };
});
const quadrantBars = quadrantStats.map((s) => ({
  label: s.label,
  value: s.avgPrize,
  displayValue: `${formatManYen(s.avgPrize)}万円`,
  n: s.n,
  note: `中央値${formatManYen(s.medianPrize)}万円・重賞馬${s.gradeWinners}頭`,
}));

const earlySmall = quadrantGroups.get('早生まれ・小さい') ?? [];
const lateSmall = quadrantGroups.get('遅生まれ・小さい') ?? [];
const earlyBig = quadrantGroups.get('早生まれ・大きい') ?? [];
const lateBig = quadrantGroups.get('遅生まれ・大きい') ?? [];

// 「小さい」馬同士・「大きい」馬同士、それぞれで早生まれ/遅生まれの総賞金差を検定する。
const smallPrizeTest = mannWhitneyU(
  earlySmall.map((h) => h.totalPrizeManYen),
  lateSmall.map((h) => h.totalPrizeManYen)
);
const bigPrizeTest = mannWhitneyU(
  earlyBig.map((h) => h.totalPrizeManYen),
  lateBig.map((h) => h.totalPrizeManYen)
);

// 外れ値の影響チェック: 上位（人数比で同じ割合）を除いた平均。
const TRIM_FRACTION = 0.03;
function trimmedMean(values: readonly number[], fraction: number): number {
  const dropN = Math.round(values.length * fraction);
  const sorted = [...values].sort((a, b) => b - a).slice(dropN);
  return mean(sorted);
}
const earlySmallTrimmed = trimmedMean(
  earlySmall.map((h) => h.totalPrizeManYen),
  TRIM_FRACTION
);
const lateSmallTrimmed = trimmedMean(
  lateSmall.map((h) => h.totalPrizeManYen),
  TRIM_FRACTION
);

// 交絡チェック: 募集年で賞金を標準化（同じ年に募集された馬同士でしか比べない）したうえで、
// 早生まれ群 と 遅生まれ群 のズレを比べ直す（小さい・大きい両方）。
const prizeStatsByYear = new Map<number, { mean: number; sd: number }>();
for (const year of new Set(maturedRaced.map((h) => h.recruitYear))) {
  const prizes = maturedRaced.filter((h) => h.recruitYear === year).map((h) => h.totalPrizeManYen);
  const sd = stddev(prizes);
  prizeStatsByYear.set(year, { mean: mean(prizes), sd: sd === 0 ? 1 : sd });
}
function yearStandardizedZ(h: (typeof maturedRaced)[number]): number {
  const stats = prizeStatsByYear.get(h.recruitYear);
  if (!stats) return 0;
  return (h.totalPrizeManYen - stats.mean) / stats.sd;
}
const earlySmallZ = earlySmall.length ? mean(earlySmall.map(yearStandardizedZ)) : 0;
const lateSmallZ = lateSmall.length ? mean(lateSmall.map(yearStandardizedZ)) : 0;
const earlyBigZ = earlyBig.length ? mean(earlyBig.map(yearStandardizedZ)) : 0;
const lateBigZ = lateBig.length ? mean(lateBig.map(yearStandardizedZ)) : 0;

// ---- 重賞勝ち馬紹介（一口馬主の夢の部分） ----
// 誕生タイミング×体格スコアの4分類がある馬（=2025年募集を除く・体高体重が分かる馬）の中で、
// 実際に重賞を勝った馬を紹介する。「小さい」側からも重賞馬が出ていることを実例で見せる。
const gradeWinners = matureOnly
  .filter((h) => h.gradeWins.length > 0)
  .sort((a, b) => b.totalPrizeManYen - a.totalPrizeManYen);
const GRADE_WINNERS_VISIBLE = 10;
const gradeWinnersTop = gradeWinners.slice(0, GRADE_WINNERS_VISIBLE);
const gradeWinnersRest = gradeWinners.slice(GRADE_WINNERS_VISIBLE);
const smallGradeWinners = gradeWinners.filter((h) => sizeScore(h) < sizeScoreMedian);
const lateSmallGradeWinnerExample = [...lateSmall]
  .filter((h) => h.gradeWins.length > 0)
  .sort((a, b) => b.totalPrizeManYen - a.totalPrizeManYen)[0];

// ---- 補足: 2025年募集（現2歳）限定で「誕生日とデビューの早さ」に関係があるか ----
const y2025 = all.filter((h) => h.recruitYear === 2025);
const y2025Debuted = y2025.filter((h) => (h.starts ?? 0) > 0);
const debutDoyR = pearsonCorrelation(
  y2025.map((h) => dayOfYear(h.birthDate as string)),
  y2025.map((h) => ((h.starts ?? 0) > 0 ? 1 : 0))
);

const RECRUIT_YEARS = [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025];
const yearRangeLabel = `${RECRUIT_YEARS[0]}〜${RECRUIT_YEARS[RECRUIT_YEARS.length - 1]}年`;

// 広告コードは他の記事と同じもの（本人の判断で使い回し。vault: 20260821-article-ad-embed-snippets）
const AD_SP_WIDE_A = 'f81bbb016a82d6366a0e2f70051b1a0c';
const AD_SP_WIDE_B = 'b4b7d55c89d5fc92c564979491a16ad1';
const AD_SP_RECT = '24e3e1a24f40d88ee1a0ca315c54a7b9';
const AD_PC_WIDE_A = 'f0efb5bd6ae3e164bb584a4dbb846f48';
const AD_PC_WIDE_B = '0a525f6469ec1f40642b4550e53d39cc';

const description = `【非公式】キャロットクラブ${yearRangeLabel}${all.length}頭の募集時データと現在の競走成績を独自集計。誕生日が体高・馬体重に与える「早生まれ効果」と、小さい馬を誕生月で分けたときの成績差、実際の重賞勝ち馬を紹介。`;
---

<BaseLayout
  title="誕生月と体格・成績の関係"
  description={description}
  breadcrumb={[{ label: '分析記事', href: '/articles/' }, { label: '誕生月と体格・成績の関係', href: '/articles/birth-month/' }]}
  showHeaderNotices={false}
>
  <article>
    <h1>誕生月と体格・成績の関係を見てみた</h1>

    <p>
      「誕生日が遅くて小さい馬は買いなのか」という質問をもらった。人間の学年でいう早生まれ・
      遅生まれと同じで、馬も暦年（1月〜12月）の中で誕生日が遅いほど、募集時点ではまだ若く、
      体高・馬体重が小さく出やすいはず。だとすると<a href="/articles/height/">前回の体高の記事</a>で
      見た「体高が小さいと成績もやや振るわない」という傾向は、単に「誕生日が遅いだけの若い馬」を
      不当に評価し損なっているだけかもしれない。逆に「誕生日が早いのに小さい馬」は、同期の中で
      年齢的なアドバンテージがありながら小さいわけで、より注意すべきシグナルとも考えられる。
      この仮説を{yearRangeLabel}募集（{all.length}頭）のデータで確かめてみた。
    </p>

    <StatTiles
      tiles={[
        { label: '対象頭数', value: `${all.length}頭` },
        { label: '誕生日 × 体高', value: doyHeightR !== null ? `r=${doyHeightR.toFixed(3)}` : '—', note: '早いほど大きい' },
        { label: '誕生日 × 馬体重', value: doyWeightR !== null ? `r=${doyWeightR.toFixed(3)}` : '—', note: '早いほど重い' },
        { label: '誕生月の範囲', value: `${monthBins[0].m}〜${monthBins[monthBins.length - 1].m}月` },
      ]}
    />

    <AdSlot sp={AD_SP_WIDE_A} pc={AD_PC_WIDE_A} />

    <h2>馬にも「早生まれ効果」ははっきりある</h2>
    <p>
      まず誕生月の分布から。{yearRangeLabel}募集は{monthBins[0].m}月〜{monthBins[monthBins.length - 1].m}月に
      集中していて、2〜3月がピーク。
    </p>
    <BarChart title={`誕生月の分布（全${all.length}頭）`} bars={monthBars} valueLabel="頭数" />

    <p>
      誕生日を「その年の何日目か」という数値に直して体高・馬体重との相関を取ると、
      体高でr={doyHeightR?.toFixed(3)}、馬体重でr={doyWeightR?.toFixed(3)}。どちらも
      「誕生日が遅いほど小さい」向きにはっきりした相関があり、体高のばらつきのかなりの部分が
      誕生日だけで説明できてしまうくらい強い。月別の平均体高を並べても一目瞭然で、
      {monthAvgBars[0].label}の平均{monthAvgBars[0].displayValue}から
      {monthAvgBars[monthAvgBars.length - 1].label}の平均{monthAvgBars[monthAvgBars.length - 1].displayValue}まで、
      月が進むごとにきれいに下がっていく。<strong>「早生まれのほうが大きく出る」は馬にも
      そのまま当てはまる</strong>。
    </p>
    <BarChart title="誕生月別 平均体高" bars={monthAvgBars} valueLabel="平均体高" />

    <AdSlot sp={AD_SP_WIDE_B} pc={AD_PC_WIDE_B} />

    <h2>体高記事の傾向は、遅生まれ馬を不当評価していただけなのか</h2>
    <p>
      ここが冒頭の仮説の核心。誕生日で「その馬が生まれた時期にしては体高が高いか低いか」を
      補正した<strong>年齢調整後の体高</strong>（誕生日から回帰で予測される体高との差分）を作り、
      これと成績の相関を取り直した。素の体高×獲得賞金合計の相関はr={heightPrizeR?.toFixed(3)}
      （<a href="/articles/height/">前回の体高記事</a>と同じ値）。年齢調整後の体高×獲得賞金合計は
      r={residualPrizeR?.toFixed(3)}で、<strong>ほとんど変わらなかった</strong>。つまり体高記事で見た
      「体高が小さいと成績もやや振るわない」という傾向は、遅生まれの若い馬を不当に評価し
      損なっていたわけではなく、誕生日を考慮してもなお残る差らしい。この時点で、冒頭の懸念は
      データ上は支持されなかったことになる。
    </p>
    <p>
      ただしこれは連続的な回帰の話で、「小さい馬」を早生まれ/遅生まれで直接比べたときにどうかは
      別に見る価値がある。それが次の本題。
    </p>

    <h2>本題: 「小さい馬」を誕生タイミングで分けると成績はどう違うか</h2>
    <p>
      {yearRangeLabel}募集のうち、まだ大半が未出走の2025年募集を除いた{matureOnly.length}頭を、
      誕生日（通し日数の中央値）と体格の2軸で4グループに分けた。「大きい/小さい」は体高
      （中央値{heightMedian}cm）・馬体重（中央値{weightMedian}kg）をそれぞれ標準化して平均した
      「体格スコア」で判定している（体高だけ・馬体重だけで見ても結論の向きは同じだった）。
      頭数は大きい{bigCount}頭・小さい{smallCount}頭。出走済み{maturedRaced.length}頭での
      平均総賞金は次の通り。
    </p>
    <BarChart
      title="誕生タイミング×体格 4グループの平均総賞金"
      bars={quadrantBars}
      valueLabel="平均総賞金"
      nLabel="出走済み頭数"
      noteLabel="内訳"
    />
    <p>
      「小さい」馬同士で比べると、遅生まれで小さい馬（平均{formatManYen(quadrantStats[3].avgPrize)}万円）は、
      早生まれなのに小さい馬（平均{formatManYen(quadrantStats[1].avgPrize)}万円）より成績が良い。
      中央値でも同じ向き（{formatManYen(quadrantStats[3].medianPrize)}万円 対
      {formatManYen(quadrantStats[1].medianPrize)}万円）で、上位{(TRIM_FRACTION * 100).toFixed(0)}%を
      除いた平均で見ても{formatManYen(lateSmallTrimmed)}万円 対 {formatManYen(earlySmallTrimmed)}万円と、
      一部の高額稼ぎ馬に引っ張られた差ではなさそうだった。「大きい」馬同士でも同じ向きの差があり、
      遅生まれで大きい馬（平均{formatManYen(quadrantStats[2].avgPrize)}万円）は早生まれで大きい馬
      （平均{formatManYen(quadrantStats[0].avgPrize)}万円）よりむしろ差が大きい。つまり体格スコアで
      見た限り、大きい・小さいどちらの階層でも「遅生まれの方が成績が良い」という同じ向きの傾向が出た。
    </p>

    <div class="finding">
      <p class="finding-lead">ただし統計的に「有意」ではなく、交絡もある</p>
      <p>
        見た目の向きは一貫していたが、そのまま「遅生まれの方が買い」と言い切れるほど強い差ではない。
        早生まれ・小さい（n={earlySmall.length}）と遅生まれ・小さい（n={lateSmall.length}）の総賞金差を
        Mann-Whitney U検定にかけるとp={smallPrizeTest.p.toFixed(3)}。「大きい」馬同士
        （早生まれn={earlyBig.length}・遅生まれn={lateBig.length}）で同じ検定をかけると
        p={bigPrizeTest.p.toFixed(3)}で、こちらの方が一般的な有意水準（0.05）に近い。ただしどちらも
        0.05は下回っておらず、統計的に「有意」とは言えない。重賞馬率で見ると、大きい群は
        早生まれ{quadrantStats[0].gradeRate.toFixed(1)}%・遅生まれ{quadrantStats[2].gradeRate.toFixed(1)}%、
        小さい群は早生まれ{quadrantStats[1].gradeRate.toFixed(1)}%・遅生まれ
        {quadrantStats[3].gradeRate.toFixed(1)}%とどちらもほぼ差が無く、平均・中央値の差ほどには
        重賞級の実績の出やすさには表れていない。
      </p>
      <p>
        募集年・性別の構成も確認したところ、偏りは見つかったが向きは一様ではなかった。小さい馬
        グループは早生まれの方が平均募集年がやや新しく（{quadrantStats[1].avgRecruitYear.toFixed(1)}年
        対{quadrantStats[3].avgRecruitYear.toFixed(1)}年、稼ぐ時間が短いぶん差を実際より大きく見せる
        方向）、逆に大きい馬グループは遅生まれの方がわずかに新しい
        （{quadrantStats[2].avgRecruitYear.toFixed(1)}年 対{quadrantStats[0].avgRecruitYear.toFixed(1)}年、
        こちらは差を実際より小さく見せる方向）。募集年ごとに賞金を標準化（同じ年の募集馬同士でしか
        比べない）したz得点で比べ直すと、小さい群は早生まれz={earlySmallZ.toFixed(3)}・遅生まれ
        z={lateSmallZ.toFixed(3)}で差はいくらか縮み、大きい群は早生まれz={earlyBigZ.toFixed(3)}・
        遅生まれz={lateBigZ.toFixed(3)}で標準化後も向きは変わらなかった。総合すると「傾向としては
        一貫してありそうだが、確信を持って言い切れる差ではない」というのが正直なところ。
      </p>
    </div>

    <div class="ad-rect">
      <AdSlot sp={AD_SP_RECT} pc={AD_PC_WIDE_A} />
    </div>

    <h2>実際にどんな馬がいたか</h2>
    <p>
      相関係数や検定の話ばかりだと実感が湧かないので、実際に重賞を勝った{gradeWinners.length}頭を
      獲得賞金の多い順に紹介する。体格スコアで「小さい」側に入る馬も{smallGradeWinners.length}頭
      重賞を勝っており、体高・馬体重が並より小さくても大きく稼ぐ馬は普通にいる。
      {lateSmallGradeWinnerExample && (
        <>中でも<strong>{lateSmallGradeWinnerExample.displayName}</strong>は遅生まれ・小さい
        グループに入りながら{lateSmallGradeWinnerExample.gradeWins.join('、')}を勝ち、
        獲得賞金合計{formatManYen(lateSmallGradeWinnerExample.totalPrizeManYen)}万円を稼いでいる。
        こういう馬に出会えるのが一口馬主の醍醐味でもある。</>
      )}
      表が長くなるので、開いているのは上位{GRADE_WINNERS_VISIBLE}頭で、
      残り{gradeWinnersRest.length}頭はその下の折りたたみに入れてある。
    </p>
    <GradeWinnerTable rows={gradeWinnersTop} />
    {gradeWinnersRest.length > 0 && (
      <details class="more-winners">
        <summary>残りの{gradeWinnersRest.length}頭も見る（獲得賞金{GRADE_WINNERS_VISIBLE + 1}位以下）</summary>
        <GradeWinnerTable rows={gradeWinnersRest} />
      </details>
    )}

    <div class="ad-rect">
      <AdSlot sp={AD_SP_RECT} pc={AD_PC_WIDE_B} />
    </div>

    <h2>補足: 現2歳（2025年募集）のデビューの早さは誕生日と関係あるか</h2>
    <p>
      主要な比較からは除いた2025年募集{y2025.length}頭についても、誕生日とデビューの早さの
      関係だけ軽く見ておく。{resultsAsOf}時点でデビュー済みは{y2025Debuted.length}頭のみで、
      誕生日（通し日数）とデビュー済みかどうかの相関はr={debutDoyR?.toFixed(3)}。
      ほぼゼロで、今のところ「早生まれの方が早くデビューしている」ような傾向は見えない。
      ただしデビュー済みがまだ{y2025Debuted.length}頭しかなく、判断するには早すぎる参考値。
    </p>

    <h2>まとめ</h2>
    <ul class="conclusion">
      <li>誕生日と体高・馬体重の相関はr={doyHeightR?.toFixed(3)}／r={doyWeightR?.toFixed(3)}と
        はっきりしていて、<strong>「早生まれのほうが大きく出る」は馬にも確かに当てはまる</strong>。</li>
      <li>誕生日で補正した「年齢調整後の体高」でも成績との相関はr={residualPrizeR?.toFixed(3)}
        （素の体高はr={heightPrizeR?.toFixed(3)}）とほぼ変わらず、<strong>体高記事の傾向が
        遅生まれ馬を不当評価していたわけではなさそう</strong>だった。</li>
      <li>体高・馬体重を合わせた「体格スコア」で誕生タイミングと成績を見ると、大きい・小さい
        どちらの階層でも「遅生まれの方が成績が良い」という同じ向きの傾向が出た。「小さい」馬同士
        の差（p={smallPrizeTest.p.toFixed(3)}）より「大きい」馬同士の差（p={bigPrizeTest.p.toFixed(3)}）の方が
        一般的な有意水準（0.05）に近かったが、どちらも統計的に有意とまでは言えなかった。
        募集年・性別の構成にも偏りが見つかったが、向きは一様ではなく、標準化しても傾向自体は
        変わらなかった。</li>
      <li>重賞馬率で見ると、大きい群・小さい群それぞれの中で早生まれと遅生まれの差はほぼ無く
        （大きい群{quadrantStats[0].gradeRate.toFixed(1)}%対{quadrantStats[2].gradeRate.toFixed(1)}%、
        小さい群{quadrantStats[1].gradeRate.toFixed(1)}%対{quadrantStats[3].gradeRate.toFixed(1)}%）、
        今回見えた差は主に平均・中央値レベルのもので、トップクラスに届くかどうかまでは
        左右していなそうだった。</li>
      <li>「誕生日が遅くて小さい馬」を「早生まれなのに小さい馬」より積極的に避ける理由は
        今回のデータからは見つからなかった。体高・馬体重が並より小さくても重賞を勝った馬は
        実際に{smallGradeWinners.length}頭いる。</li>
    </ul>

    <div class="ad-rect">
      <AdSlot sp={AD_SP_RECT} pc={AD_PC_WIDE_B} />
    </div>

    <h2>データについて</h2>
    <p>
      誕生日は個体ページのプロフィール表から取得したもの。体高・馬体重は募集時点の測尺で、
      実際に測った日付までは分からないため、「誕生日から募集時点までの月齢」ではなく
      「その年の何日目に生まれたか」を代わりの尺度として使っている。同じ年度の募集馬は
      同じ時期に測尺されている前提だが、実際に数日〜数週間のズレがある可能性はある。
      競走成績は{resultsAsOf}時点のスナップショットで、2025年募集（現2歳）は大半が未出走のため
      主要な比較から除外した。獲得賞金は中央（JRA）・地方（NAR）の合計で、海外レースの賞金は
      含まれていない。相関係数・検定の結果はあくまで目安で、出資判断の材料というより
      趣味の分析として楽しんでもらえたら。
    </p>

    <p>
      <a href="/">募集馬一覧へ戻る</a> ／ <a href="/articles/">分析記事一覧へ</a>
    </p>
  </article>

  <ChartTooltip />
</BaseLayout>

