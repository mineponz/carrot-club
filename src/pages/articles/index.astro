---
/**
 * 分析記事の一覧ページ。2017〜2025年募集の全頭データ（analysis/data/）を使った読み物コンテンツの
 * ハブ。記事を増やしたらここにも追加する。頭数・年範囲はheight.astroと同じrecruits.jsonから
 * 動的に出す（ハードコードすると年ごとにデータが増えるたびにここも直し忘れる）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadRecruitsWithResults } from '../../lib/analysis-data.ts';

const all = loadRecruitsWithResults();
const years = [...new Set(all.map((h) => h.recruitYear))].sort((a, b) => a - b);
const yearRangeLabel = `${years[0]}〜${years[years.length - 1]}年`;
// dam-age記事は母齢不明の3頭を集計から除外しているため、all.length（818）とは頭数が異なる。
const withDamAge = all.filter((h) => h.damAge !== null).length;

const articles = [
  {
    href: '/articles/dam-age/',
    title: `母馬の年齢と成績の関係を、${withDamAge}頭のデータで見てみた`,
    description:
      '「高齢の母馬は不利」という俗説を、母齢と獲得賞金の相関係数・階級別グラフで検証。結果はほぼ無相関だった。',
  },
  {
    href: '/articles/height/',
    title: `体高と成績の関係を、${all.length}頭のデータで見てみた`,
    description:
      '募集時の体高と、その後の中央・地方獲得賞金の関係を散布図・階級別グラフで見る。ダービー馬タスティエーラなど実際の代表馬も紹介。',
  },
];

const description = `【非公式】${yearRangeLabel}のキャロットクラブ募集馬データを使った分析記事の一覧。`;
---

<BaseLayout title="分析記事" description={description}>
  <h1>分析記事</h1>
  <p>
    {yearRangeLabel}募集の募集時データと、その後の競走成績を突き合わせた独自集計をもとに、
    体高・一口価格といった募集時の情報が後の成績とどう関係するかを見ていく読み物コンテンツです。
  </p>
  <ul class="article-list">
    {articles.map((a) => (
      <li>
        <a href={a.href}>{a.title}</a>
        <p>{a.description}</p>
      </li>
    ))}
  </ul>
  <p class="more-note">今後、一口価格や父系統など別の切り口でも記事を追加していく予定です。</p>
</BaseLayout>

<style>
  .article-list {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
  }
  .article-list li {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }
  .article-list li + li { margin-top: 0.75rem; }
  .article-list a {
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }
  .article-list a:hover { text-decoration: underline; }
  .article-list p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .more-note {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
