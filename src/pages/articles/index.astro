---
/**
 * 記事の一覧ページ。「データ分析」（募集時データと成績を突き合わせた集計）・
 * 「育成」（募集後〜デビュー前の育成の節目。例: 北海道を出る時期）・
 * 「読み物」（募集時期に紐づかない読み物。例: 馬名の傾向）の3区分をh2で分けて出す
 * （`articles.ts`の`kind`で判定。2026-09-16に区分を導入、2026-09-23に「育成」を追加）。
 * 記事が0件の区分はその見出しごと出さない。
 * 記事を増やしたらここにも追加する。頭数・年範囲はheight.astroと同じrecruits.jsonから
 * 動的に出す（ハードコードすると年ごとにデータが増えるたびにここも直し忘れる）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadRecruitsWithResults } from '../../lib/analysis-data.ts';
import { analysisArticles } from '../../data/articles.ts';

const all = loadRecruitsWithResults();
const years = [...new Set(all.map((h) => h.recruitYear))].sort((a, b) => a - b);
const yearRangeLabel = `${years[0]}〜${years[years.length - 1]}年`;

const sections = [
  { label: 'データ分析', articles: analysisArticles.filter((a) => a.kind === 'analysis') },
  { label: '育成', articles: analysisArticles.filter((a) => a.kind === 'training') },
  { label: '読み物', articles: analysisArticles.filter((a) => a.kind === 'reading') },
].filter((s) => s.articles.length > 0);

const description = `【非公式】${yearRangeLabel}のキャロットクラブ募集馬データを使った分析記事・育成記事・読み物の一覧。`;
---

<BaseLayout title="記事一覧" description={description}>
  <h1>記事一覧</h1>
  <p>
    {yearRangeLabel}募集の募集時データと、その後の競走成績を突き合わせた独自集計の分析記事、
    募集後の育成の歩みを近況から数えた育成記事、募集馬にまつわる読み物をまとめています。
  </p>
  <p class="methods-note">
    <a href="/articles/methods/">分析記事の読み方</a> ……
    記事に出てくる「順位相関」「p値」「偏相関」などの用語を、図と実際の集計例で説明しています。
    はじめて読む方はこちらから。
  </p>

  {sections.map((section) => (
    <>
      <h2>{section.label}</h2>
      <ul class="article-list">
        {section.articles.map((a) => (
          <li>
            <a class="article-card" href={a.href}>
              <img
                class="article-card-thumb"
                src={a.image}
                alt=""
                width="1200"
                height="630"
                loading="lazy"
              />
              <span class="article-card-body">
                <span class="article-card-title">{a.title}</span>
                <span class="article-card-desc">{a.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}

  <p class="more-note">今後、父系統など別の切り口でも記事を追加していく予定です。</p>
  <p class="more-note">
    ここで作った物差しを運営者自身の出資馬に当ててみた読み物は
    <a href="/my-horses/">出資馬の話</a>にまとめています。
  </p>
  <p class="more-note">
    記事は<a href="/about/">運営者</a>が個人で集計・執筆しています。
  </p>
</BaseLayout>

<style>
  .article-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .article-card:hover {
    border-color: var(--info);
    transform: translateY(-2px);
  }
  .article-card-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background: var(--accent-weak);
  }
  .article-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.1rem;
  }
  .article-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }
  .article-card:hover .article-card-title { text-decoration: underline; }
  .article-card-desc {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .more-note {
    color: var(--muted);
    font-size: 0.875rem;
  }
  /* 用語解説への導線。分析記事のカード（--info系の青）と役割を揃えつつ、
     カード一覧の前に置いて「先に読む案内」だと分かる見た目にする。 */
  .methods-note {
    padding: 0.7rem 0.95rem;
    background: var(--info-weak);
    border: 1px solid var(--info);
    border-radius: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .methods-note a {
    color: var(--info);
    font-weight: 700;
  }
</style>
