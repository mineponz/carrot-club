// 「牝は上がる／牡は動かない」を同じ物差しで言えていなかった（reviewer指摘 2026-09-02）。
// 本文が主張しているのは有意差なので、検定で守る。
if (!(femaleWinTest.usable && femaleWinTest.test.p < ALPHA && femaleWinRates[0].rate < femaleWinRates[3].rate)) {
  premiseErrors.push(
    `牝の勝ち上がり率の差が有意でなくなった（軽い1/4 ${femaleWinRates[0].rate.toFixed(1)}% / ` +
