// ---- 代表馬（重賞勝ち馬） ----
const gradeWinners = all
  .filter((h) => h.gradeWins.length > 0)
  .sort((a, b) => b.totalPrizeManYen - a.totalPrizeManYen);
const GRADE_WINNERS_VISIBLE = 12;
const gradeWinnersTop = gradeWinners.slice(0, GRADE_WINNERS_VISIBLE);
const gradeWinnersRest = gradeWinners.slice(GRADE_WINNERS_VISIBLE);
const gradeMales = gradeWinners.filter((h) => h.sex === '牡');
const gradeFemales = gradeWinners.filter((h) => h.sex === '牝');
const gradeMaleWeightMedian = median(gradeMales.map((h) => h.weight as number));
const gradeFemaleWeightMedian = median(gradeFemales.map((h) => h.weight as number));
// 「小柄な牝で走った馬」側の実例：牝の重賞馬を体重が軽い順に。
const lightFemaleGradeWinners = [...gradeFemales].sort((a, b) => (a.weight as number) - (b.weight as number)).slice(0, 3);
// 「小柄な牡は心配いらない」側の実例：牡の重賞馬を体重が軽い順に。
const lightMaleGradeWinners = [...gradeMales].sort((a, b) => (a.weight as number) - (b.weight as number)).slice(0, 3);
