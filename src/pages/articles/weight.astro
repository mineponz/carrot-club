  );
}
// 牡は「賞金以外の指標も、向きは重い側だが有意差までは出ない」と書いている。
// 賞金だけ見て「無関係」と書き、勝ち上がり率・重賞頭数・デビュー率が同じ向きに動いているのを
// 伏せていたのを直した箇所なので、その3つとも「有意でない」ことを条件にする。
for (const [label, t] of [
  ['勝ち上がり率', maleWinTest],
  ['重賞率', maleGradeTest],
  ['デビュー率', maleDebutTest],
] as const) {
  if (t.usable && t.test.p < ALPHA) {
    premiseErrors.push(
      `牡の${label}が軽い1/4と重い1/4で有意差になった（${ratePText(t)}）。` +
