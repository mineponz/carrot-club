// これは体型スコアそのものの偏相関で言うべきもので、体高↔賞金の偏相関の流用ではない
// （reviewer指摘 2026-09-02。結論は同じだが根拠が別の量だった）。
if (
  !(
    femaleBuildGivenWeight !== null &&
