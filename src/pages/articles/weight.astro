// （牡は賞金だけ見て「無関係」と書き、勝ち上がり率・重賞頭数が同じ向きに動いているのを
//  伏せていた・reviewer指摘 2026-09-02）。
const maleGradeCounts = rateInQuartiles(males, maleScheme, isGradeWinner);
const maleDebutRates = rateInQuartiles(males, maleScheme, hasDebut);
/** 4分位の両端どうしの比率検定。期待度数5未満ならpを読ませない。 */
function endsRateTest(rows: RecruitWithResult[], scheme: ReturnType<typeof quartileScheme>, hit: (h: RecruitWithResult) => boolean) {
  const light = rows.filter(scheme.light);
  const heavy = rows.filter(scheme.heavy);
  const x1 = light.filter(hit).length;
  const x2 = heavy.filter(hit).length;
  const pooled = (x1 + x2) / (light.length + heavy.length);
  const minExpected = Math.min(
    pooled * light.length,
    pooled * heavy.length,
    (1 - pooled) * light.length,
    (1 - pooled) * heavy.length
  );
  return {
    lightHits: x1,
    heavyHits: x2,
    lightN: light.length,
    heavyN: heavy.length,
    /** 他の群並みなら軽い側に何頭出ているはずか（「ゼロ」の重さを読者に伝える用）。 */
    lightExpected: pooled * light.length,
    test: twoProportionZTest(x1, light.length, x2, heavy.length),
    usable: minExpected >= 5,
  };
}
const maleWinTest = endsRateTest(males, maleScheme, hasWin);
const maleGradeTest = endsRateTest(males, maleScheme, isGradeWinner);
const maleDebutTest = endsRateTest(males, maleScheme, hasDebut);
const femaleWinTest = endsRateTest(females, femaleScheme, hasWin);
const femaleGradeTest = endsRateTest(females, femaleScheme, isGradeWinner);
/** 比率比較の検定結果を本文に出す形。期待度数が足りない群では数字を出さず、その旨を書く。 */
function ratePText(r: ReturnType<typeof endsRateTest>): string {
  return r.usable ? formatP(r.test.p) : '頭数が少なく検定に足りない';
}

// ---- 頑健性: 走る時間が足りている2017〜2022年募集だけでも同じ向きが出るか ----
const matureRacedMales = racedMales.filter((h) => h.recruitYear <= MATURE_YEAR);
const matureRacedFemales = racedFemales.filter((h) => h.recruitYear <= MATURE_YEAR);
const rMatureMale = spearmanCorrelation(
  matureRacedMales.map((h) => h.weight as number),
  matureRacedMales.map((h) => h.totalPrizeManYen)
);
const rMatureFemale = spearmanCorrelation(
  matureRacedFemales.map((h) => h.weight as number),
  matureRacedFemales.map((h) => h.totalPrizeManYen)
);

// ---- 散布図（性別で色を分ける） ----
const SCATTER_Y_MAX = 10000;
const sexSeriesKey = (sex: string | null) => (sex === '牝' ? 'female' : sex === '牡' ? 'male' : 'unknown');
const scatterPoints = raced
  .filter((h) => h.totalPrizeManYen < SCATTER_Y_MAX)
  .map((h) => ({
