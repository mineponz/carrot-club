const femaleLightGradeWinners = females.filter((h) => femaleScheme.light(h) && h.gradeWins.length > 0);
const femaleLightCut = Math.max(...females.filter(femaleScheme.light).map((h) => h.weight as number));

// ---- 募集年の偏り（重い1/4・軽い1/4の平均募集年） ----
// 主要な主張は性別ごとなので、募集年の偏りの検算も性別ごとに出す
// （全頭の数字を部分集合の弁明に流用していた・reviewer指摘 2026-09-02）。
function meanYearEnds(rows: RecruitWithResult[], scheme: ReturnType<typeof quartileScheme>) {
  return {
    light: mean(rows.filter(scheme.light).map((h) => h.recruitYear)),
    heavy: mean(rows.filter(scheme.heavy).map((h) => h.recruitYear)),
  };
}
const yearEndsMale = meanYearEnds(males, maleScheme);
const yearEndsFemale = meanYearEnds(females, femaleScheme);

// ---- 本文が置いている前提のビルド時アサーション ----
const ALPHA = 0.05;
const premiseErrors: string[] = [];

// 全頭では体重と賞金が正に相関している（導入の前提）。
if (!(rAll.spearman !== null && rAll.spearman > 0 && rAll.spearmanP !== null && rAll.spearmanP < ALPHA)) {
  premiseErrors.push(
    `全頭で体重と賞金の順位相関が有意な正でなくなった（rs=${rAll.spearman?.toFixed(3)} / ` +
      `p=${rAll.spearmanP?.toFixed(4)}）。「まとめて見ると大きい馬ほど稼ぐ」という導入を書き直すこと。`
  );
}
// 牡では賞金との関係が消える。
if (!(rMale.spearmanP !== null && rMale.spearmanP >= 0.2 && Math.abs(rMale.spearman ?? 1) < 0.1)) {
  premiseErrors.push(
    `牡で体重と賞金の関係が出てきた（rs=${rMale.spearman?.toFixed(3)} / p=${rMale.spearmanP?.toFixed(4)}）。` +
      '「牡では賞金との関係が消える」と書いた本文を書き直すこと。'
