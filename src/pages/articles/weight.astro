if (!(Math.abs(caretRow.sex.gapInSd) > Math.abs(weightRow.sex.gapInSd) * 2)) {
  premiseErrors.push(
    `管囲の性差（${caretRow.sex.gapInSd.toFixed(2)}SD）が馬体重（${weightRow.sex.gapInSd.toFixed(2)}SD）より突出しなくなった。`
