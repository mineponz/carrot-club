---
/**
 * 分析記事「馬体重と成績」。2017〜2025年募集の全頭（`analysis/data/recruits.json`）にある
 * 募集時の馬体重（weight）と現在の競走成績（`analysis/data/race-results.json`）をクロス集計する。
 * 体高・母齢・誕生月・胸囲・産次・クラブ・管囲に続く8本目。測尺4項目（体高・胸囲・管囲・馬体重）
 * の最後の1本。
 *
 * ## この記事の主題は「馬体重がはっきり効くのは牝だけ」
 * 全頭をまとめると馬体重は獲得賞金と弱く正に相関する（体高記事と同水準）。ところが牡牝を分けると、
 * 牝でははっきり残り（順位相関0.22・p<0.0001、4分位の賞金中央値が単調に増える）、
 * 牡では賞金との関係が見えない（順位相関ほぼ0・p≈0.6・優越確率49.5%）。
 *
 * ## 牡を「無関係」と書かないこと（reviewer指摘・2026-09-02）
 * 牡は**賞金**では関係が消えるが、勝ち上がり率（60.6→68.0%）・重賞頭数（5→6→9→11）・
 * デビュー率（76.6→85.6%）は弱いながら全部「重い側が上」を向いている。いずれも有意ではない
 * （p=0.11〜0.29）が、牝側で重賞頭数0/4/3/6を主要な証拠に使う以上、牡側の同じ指標を伏せると
 * 基準のすり替えになる。書けるのは「賞金では見えない／他の指標も差と呼べない」まで。
 *
 * ## 管囲記事（caret-girth）との違い
 * 管囲は牡牝の中央値が1.13SDも離れた「性別の代理変数」だったが、馬体重の性差は0.37SDで穏やか。
 * SD差は分布の重なりの話でしかないので、管囲記事と同じ物差し（性別を統制した偏順位相関）でも
 * 示す: 管囲 0.168→0.063（63%減）に対し馬体重 0.163→0.127（22%減）。
 *
 * ## 牝では体高ではなく体重（言い方に注意）
 * 牝だけで偏相関を取ると、体高を統制しても体重は残る（0.21・p<0.0001）。体重を統制すると体高は
 * ゼロ近くまで落ちる（-0.04・p=0.47）が、**体高は牝では統制前から有意でない**（0.099・p=0.060）。
 * だから「体高に効果があったが体重が正体だった」とは書けない（＝効果量基準と有意性基準の
 * すり替えになる。caret-girth記事で出た失敗）。書けるのは「牝で残るのは体重の方だけ」まで。
 * 誕生日を統制しても体重の相関はむしろ上がる（0.25）＝「小柄な牝は単に遅生まれ」では説明できない。
 * 「体高の割に詰まっているか（体型）」も牝でやや差が出るが、体型スコアを体重で統制すると
 * 0.149→0.059（p=0.26）まで落ちる＝体型そのものの効果ではない。
 *
 * ## 「大きい馬は骨が丈夫」の検証
 * 体の割に管が太い（骨っぽい）馬がデビューに辿り着く率・勝ち上がった後の出走数を、牡牝別に見る。
 * どちらも差は出ない。骨折や長期休養そのもののデータは手元に無いので間接指標であることを明示する。
 * 出走数を丈夫さの代理にするときは勝ち上がり有無で層別する（中央の未勝利戦は3歳9月上旬で終わり、
 * 勝ち上がれなかった馬はほとんどそこで中央を去るため。地方・障害へ行く馬もいる）。
 *
 * ## 書き方の前提
 * - 4分位は母集団の体重の25/50/75パーセンタイルで切る（`>= lo && < hi`）。境界にタイが乗って
 *   群が偏らないか、下にアサーションで検算している。
 * - 本文が置いている前提（牡では消える・牝では残る・牝の4分位が単調・体高は体重の影・
 *   骨量と丈夫さは無関係）はすべてビルド時アサーションにしてある。データを取り直して前提が
 *   崩れたらビルドが落ちる。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarChart from '../../components/charts/BarChart.astro';
import ScatterChart from '../../components/charts/ScatterChart.astro';
import ChartTooltip from '../../components/charts/ChartTooltip.astro';
import StatTiles from '../../components/charts/StatTiles.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import MethodsLink from '../../components/MethodsLink.astro';
import TermLink from '../../components/TermLink.astro';
import AdSlot from '../../components/AdSlot.astro';
import GradeWinnerTable from '../../components/GradeWinnerTable.astro';
import {
  loadRecruitsWithResults,
  racedOnly,
  RACE_RESULTS_FETCHED_AT,
  type RecruitWithResult,
} from '../../lib/analysis-data.ts';
import { formatResultsAsOf } from '../../lib/sibling-recruits.ts';
import {
  histogram,
  pearsonCorrelation,
  spearmanCorrelation,
  mannWhitneyU,
  twoProportionZTest,
  bucketMedian,
  countByBucket,
  correlationPValue,
  formatP,
  probabilityOfSuperiority,
  mean,
  median,
  formatManYen,
} from '../../lib/chart-math.ts';

const allRecruits = loadRecruitsWithResults();
const resultsAsOf = formatResultsAsOf(RACE_RESULTS_FETCHED_AT);

// 馬体重が取れていない3頭（netkeibaページ自体を特定できなかった馬）は集計対象から外す。
const all = allRecruits.filter((h) => h.weight !== null);
const raced = racedOnly(all);
const unraced = all.length - raced.length;

const males = all.filter((h) => h.sex === '牡');
const females = all.filter((h) => h.sex === '牝');
const sexUnknown = all.length - males.length - females.length;
const racedMales = racedOnly(males);
const racedFemales = racedOnly(females);

const weights = all.map((h) => h.weight as number);
const weightMin = Math.min(...weights);
const weightMax = Math.max(...weights);
const weightMean = mean(weights);
const weightMedian = median(weights);
const maleWeightMedian = median(males.map((h) => h.weight as number));
const femaleWeightMedian = median(females.map((h) => h.weight as number));

// ---- 分布（10kg刻み） ----
const HIST_BIN = 10;
const HIST_MIN = 350;
const HIST_MAX = 590;
function weightBins(rows: RecruitWithResult[]) {
  return histogram(rows.map((h) => h.weight as number), HIST_BIN, HIST_MIN, HIST_MAX).map((b) => ({
    label: `${b.binStart}`,
    value: b.count,
    displayValue: `${b.count}頭`,
  }));
}
const allBins = weightBins(all);
const maleBins = weightBins(males);
const femaleBins = weightBins(females);
const sexHistAxisMax = Math.max(...maleBins.map((b) => b.value), ...femaleBins.map((b) => b.value));

// ---- 4分位（母集団の体重の25/50/75パーセンタイルで切る。[lo, hi) で持つ） ----
function quartileScheme(rows: RecruitWithResult[]) {
  const sorted = [...rows].map((h) => h.weight as number).sort((a, b) => a - b);
  const n = sorted.length;
  const t1 = sorted[Math.floor(n / 4)];
  const t2 = sorted[Math.floor(n / 2)];
  const t3 = sorted[Math.floor((3 * n) / 4)];
  const labels = ['軽い1/4', 'やや軽い', 'やや重い', '重い1/4'] as const;
  const labelOf = (w: number) => (w < t1 ? labels[0] : w < t2 ? labels[1] : w < t3 ? labels[2] : labels[3]);
  const inGroup = (label: string) => (h: RecruitWithResult) => labelOf(h.weight as number) === label;
  const rangeOfGroup = (label: string) => {
    const v = rows.filter(inGroup(label)).map((h) => h.weight as number);
    return `${Math.min(...v)}〜${Math.max(...v)}kg`;
  };
  return {
    order: [...labels],
    lightest: labels[0],
    heaviest: labels[3],
    labelOf,
    light: inGroup(labels[0]),
    heavy: inGroup(labels[3]),
    inGroup,
    rangeOfGroup,
  };
}
const allScheme = quartileScheme(all);
const maleScheme = quartileScheme(males);
const femaleScheme = quartileScheme(females);

/** 4分位ごとの獲得賞金中央値を、渡した母集団（出走済み）で棒グラフ用に組む。 */
function prizeBars(
  racedRows: RecruitWithResult[],
  population: RecruitWithResult[],
  scheme: ReturnType<typeof quartileScheme>
) {
  const med = bucketMedian(racedRows, (h) => scheme.labelOf(h.weight as number), (h) => h.totalPrizeManYen);
  const counts = countByBucket(population, (h) => scheme.labelOf(h.weight as number));
  return scheme.order
    .map((label) => {
      const row = med.find((r) => r.bucket === label);
      if (!row) return null;
      return {
        label,
        value: Math.round(row.med),
        displayValue: `${formatManYen(Math.round(row.med))}万`,
        n: row.n,
        note: `${scheme.rangeOfGroup(label)}・${counts.get(label) ?? 0}頭`,
      };
    })
    .filter((b): b is NonNullable<typeof b> => b !== null);
}
const allPrizeBars = prizeBars(raced, all, allScheme);
const malePrizeBars = prizeBars(racedMales, males, maleScheme);
const femalePrizeBars = prizeBars(racedFemales, females, femaleScheme);
const sexPrizeAxisMax = Math.max(...malePrizeBars.map((b) => b.value), ...femalePrizeBars.map((b) => b.value));

// 4分位の合計が母数と合うか、群が偏りすぎていないか検算する（境界のタイは見ても気づけない）。
for (const [label, rows, scheme] of [
  ['全頭', all, allScheme],
  ['牡', males, maleScheme],
  ['牝', females, femaleScheme],
  ['出走済み全体', raced, allScheme],
] as const) {
  const sizes = scheme.order.map((l) => rows.filter((h) => scheme.labelOf(h.weight as number) === l).length);
  const sum = sizes.reduce((a, b) => a + b, 0);
  if (sum !== rows.length) {
    throw new Error(`馬体重の4分位で取りこぼしがある（${label}: 合計${sum} ≠ 母数${rows.length}）`);
  }
  if (Math.min(...sizes) < rows.length / 6) {
    throw new Error(
      `${label}の4分位が偏りすぎている（${sizes.join('/')}）。同じ体重の馬が境界に集中している可能性がある。`
    );
  }
}

// ---- 相関（体重×賞金・全体/牡/牝） ----
function weightPrizeR(rows: RecruitWithResult[]) {
  const w = rows.map((h) => h.weight as number);
  const p = rows.map((h) => h.totalPrizeManYen);
  const pearson = pearsonCorrelation(w, p);
  const spearman = spearmanCorrelation(w, p);
  return {
    n: rows.length,
    pearson,
    spearman,
    pearsonP: correlationPValue(pearson, rows.length),
    spearmanP: correlationPValue(spearman, rows.length),
  };
}
const rAll = weightPrizeR(raced);
const rMale = weightPrizeR(racedMales);
const rFemale = weightPrizeR(racedFemales);

// ---- 測尺4種の一覧（賞金との相関・性差） ----
const MEASURES = [
  { key: 'weight', label: '馬体重' },
  { key: 'height', label: '体高' },
  { key: 'caretGirth', label: '管囲' },
  { key: 'chestGirth', label: '胸囲' },
] as const;
type MeasureKey = (typeof MEASURES)[number]['key'];
function measureOf(h: RecruitWithResult, key: MeasureKey): number | null {
  return h[key] as number | null;
}
function corrWith(rows: RecruitWithResult[], key: MeasureKey) {
  const v = rows.filter((h) => measureOf(h, key) !== null);
  const spearman = spearmanCorrelation(
    v.map((h) => measureOf(h, key) as number),
    v.map((h) => h.totalPrizeManYen)
  );
  return { n: v.length, spearman, spearmanP: correlationPValue(spearman, v.length) };
}
/** 標本標準偏差（測尺ごとに単位が違うので、性差を「SD何個ぶん」に揃えるのに使う）。 */
function stdev(values: number[]): number {
  if (values.length < 2) return 0;
  const m = mean(values);
  return Math.sqrt(values.reduce((acc, v) => acc + (v - m) * (v - m), 0) / (values.length - 1));
}
function sexGapInSd(key: MeasureKey) {
  const v = all.filter((h) => (h.sex === '牡' || h.sex === '牝') && measureOf(h, key) !== null);
  const values = v.map((h) => measureOf(h, key) as number);
  const maleMed = median(v.filter((h) => h.sex === '牡').map((h) => measureOf(h, key) as number));
  const femaleMed = median(v.filter((h) => h.sex === '牝').map((h) => measureOf(h, key) as number));
  const sd = stdev(values);
  return { maleMed, femaleMed, gapInSd: sd > 0 ? (maleMed - femaleMed) / sd : 0 };
}
const measureRows = MEASURES.map((m) => ({
  ...m,
  all: corrWith(raced, m.key),
  male: corrWith(racedMales, m.key),
  female: corrWith(racedFemales, m.key),
  sex: sexGapInSd(m.key),
}));
const weightRow = measureRows.find((m) => m.key === 'weight')!;
const heightRow = measureRows.find((m) => m.key === 'height')!;
const caretRow = measureRows.find((m) => m.key === 'caretGirth')!;

// ---- 偏相関（順位ベース）。牝で「体高より体重」「遅生まれでは説明できない」を見せる用。 ----
function toRanks(values: number[]): number[] {
  const idx = values.map((v, i): [number, number] => [v, i]).sort((a, b) => a[0] - b[0]);
  const ranks = new Array<number>(values.length);
  let i = 0;
  while (i < idx.length) {
    let j = i;
    while (j + 1 < idx.length && idx[j + 1][0] === idx[i][0]) j++;
    const avg = (i + j) / 2 + 1;
    for (let k = i; k <= j; k++) ranks[idx[k][1]] = avg;
    i = j + 1;
  }
  return ranks;
}
/** y を x で線形回帰した残差。 */
function residual(y: number[], x: number[]): number[] {
  const my = mean(y);
  const mx = mean(x);
  let sxy = 0;
  let sxx = 0;
  for (let i = 0; i < y.length; i++) {
    sxy += (x[i] - mx) * (y[i] - my);
    sxx += (x[i] - mx) * (x[i] - mx);
  }
  const b = sxx === 0 ? 0 : sxy / sxx;
  return y.map((v, i) => v - (my + b * (x[i] - mx)));
}
/** a と b の偏スピアマン相関（c の影響を順位のうえで取り除いてから相関を取る）。 */
function partialSpearman(a: number[], b: number[], c: number[]): number | null {
  if (a.length < 3 || a.length !== b.length || a.length !== c.length) return null;
  const ra = toRanks(a);
  const rb = toRanks(b);
  const rc = toRanks(c);
  return pearsonCorrelation(residual(ra, rc), residual(rb, rc));
}
function dayOfYear(birthDate: string): number {
  const [, m, d] = birthDate.split('-').map(Number);
  return (m - 1) * 31 + d;
}
const femaleWithBirth = racedFemales.filter((h) => h.birthDate !== null);
const partials = {
  // 牝・体高を統制した 体重↔賞金
  weightGivenHeight: partialSpearman(
    racedFemales.map((h) => h.weight as number),
    racedFemales.map((h) => h.totalPrizeManYen),
    racedFemales.map((h) => h.height as number)
  ),
  // 牝・体重を統制した 体高↔賞金
  heightGivenWeight: partialSpearman(
    racedFemales.map((h) => h.height as number),
    racedFemales.map((h) => h.totalPrizeManYen),
    racedFemales.map((h) => h.weight as number)
  ),
  // 牝・管囲を統制した 体重↔賞金
  weightGivenCaret: partialSpearman(
    racedFemales.map((h) => h.weight as number),
    racedFemales.map((h) => h.totalPrizeManYen),
    racedFemales.map((h) => h.caretGirth as number)
  ),
  // 牝・誕生日を統制した 体重↔賞金
  weightGivenBirth: partialSpearman(
    femaleWithBirth.map((h) => h.weight as number),
    femaleWithBirth.map((h) => h.totalPrizeManYen),
    femaleWithBirth.map((h) => dayOfYear(h.birthDate as string))
  ),
};
const partialWeightGivenHeightP = correlationPValue(partials.weightGivenHeight, racedFemales.length);
const partialHeightGivenWeightP = correlationPValue(partials.heightGivenWeight, racedFemales.length);
const partialWeightGivenCaretP = correlationPValue(partials.weightGivenCaret, racedFemales.length);
const partialWeightGivenBirthP = correlationPValue(partials.weightGivenBirth, femaleWithBirth.length);

/**
 * 測尺どうしの連動の強さ。本文で「体重と体高は連動している」と書く根拠なので、
 * 数字を直接書かずここで計算する（母集団を取り違えたリテラルを本文に置かないため）。
 */
function measurePairR(rows: RecruitWithResult[], a: MeasureKey, b: MeasureKey) {
  const v = rows.filter((h) => measureOf(h, a) !== null && measureOf(h, b) !== null);
  return pearsonCorrelation(
    v.map((h) => measureOf(h, a) as number),
    v.map((h) => measureOf(h, b) as number)
  );
}
const femaleWeightHeightR = measurePairR(racedFemales, 'weight', 'height');
const femaleWeightChestR = measurePairR(racedFemales, 'weight', 'chestGirth');

/**
 * 性別（牡=1・牝=0）を統制した偏順位相関。
 * 「馬体重は管囲と違って性別の代理ではない」を、管囲記事と同じ物差しで示すために出す。
 * 中央値の差（SD換算）は分布の重なりの話でしかなく、「その相関のうちどれだけが性別由来か」
 * には直接答えないため（reviewer指摘・2026-09-02）。
 */
function sexControlledR(key: MeasureKey) {
  const v = raced.filter((h) => (h.sex === '牡' || h.sex === '牝') && measureOf(h, key) !== null);
  const raw = spearmanCorrelation(
    v.map((h) => measureOf(h, key) as number),
    v.map((h) => h.totalPrizeManYen)
  );
  const controlled = partialSpearman(
    v.map((h) => measureOf(h, key) as number),
    v.map((h) => h.totalPrizeManYen),
    v.map((h) => (h.sex === '牡' ? 1 : 0))
  );
  return { raw, controlled };
}
const weightSexControlled = sexControlledR('weight');
const caretSexControlled = sexControlledR('caretGirth');
/** 全頭4分位それぞれの牡率。管囲（太い側の87.7%が牡）と対比させる。 */
const allQuartileMaleShare = allScheme.order.map((label) => {
  const g = all.filter(allScheme.inGroup(label)).filter((h) => h.sex === '牡' || h.sex === '牝');
  return { label, share: (100 * g.filter((h) => h.sex === '牡').length) / g.length };
});

// ---- 体型（体高の割に体重があるか）＝ 性別内で体高・体重を標準化した差で3等分 ----
function zBySexMap(rows: RecruitWithResult[], key: 'weight' | 'height' | 'caretGirth') {
  const m = new Map<RecruitWithResult, number>();
  for (const sx of ['牡', '牝'] as const) {
    const sub = rows.filter((h) => h.sex === sx);
    const v = sub.map((h) => h[key] as number);
    const mu = mean(v);
    const sd = stdev(v);
    sub.forEach((h) => m.set(h, sd > 0 ? ((h[key] as number) - mu) / sd : 0));
  }
  return m;
}
function tertileEnds<T>(items: T[], scoreOf: (x: T) => number) {
  const sorted = [...items].sort((a, b) => scoreOf(a) - scoreOf(b));
  const k = Math.floor(sorted.length / 3);
  return { low: sorted.slice(0, k), high: sorted.slice(-k) };
}
const buildZ = (() => {
  const zw = zBySexMap(raced, 'weight');
  const zh = zBySexMap(raced, 'height');
  return (h: RecruitWithResult) => (zw.get(h) ?? 0) - (zh.get(h) ?? 0); // >0 = 体高の割に重い（詰まった馬）
})();
function bodyTypeCompare(rows: RecruitWithResult[]) {
  const { low, high } = tertileEnds(rows, buildZ); // low=華奢, high=詰まった
  return {
    lowN: low.length,
    highN: high.length,
    lowMed: median(low.map((h) => h.totalPrizeManYen)),
    highMed: median(high.map((h) => h.totalPrizeManYen)),
    mw: mannWhitneyU(high.map((h) => h.totalPrizeManYen), low.map((h) => h.totalPrizeManYen)),
    superiority: probabilityOfSuperiority(low.map((h) => h.totalPrizeManYen), high.map((h) => h.totalPrizeManYen)),
  };
}
const buildMale = bodyTypeCompare(racedMales);
const buildFemale = bodyTypeCompare(racedFemales);
/**
 * 「体型の差は結局は体重の差」を正面から示す偏相関。
 * 体高↔賞金（体重統制）は別の量なので、体型スコアそのものを体重で統制して確かめる
 * （reviewer指摘・2026-09-02。結論は同じだが根拠が別物だった）。
 */
const femaleBuildR = spearmanCorrelation(racedFemales.map(buildZ), racedFemales.map((h) => h.totalPrizeManYen));
const femaleBuildGivenWeight = partialSpearman(
  racedFemales.map(buildZ),
  racedFemales.map((h) => h.totalPrizeManYen),
  racedFemales.map((h) => h.weight as number)
);
const femaleBuildRP = correlationPValue(femaleBuildR, racedFemales.length);
const femaleBuildGivenWeightP = correlationPValue(femaleBuildGivenWeight, racedFemales.length);
function bodyTypeBars(rows: RecruitWithResult[]) {
  const { low, high } = tertileEnds(rows, buildZ);
  const mid = rows.filter((h) => !low.includes(h) && !high.includes(h));
  return [
    { label: '華奢な1/3', rows: low },
    { label: '真ん中', rows: mid },
    { label: '詰まった1/3', rows: high },
  ].map((g) => ({
    label: g.label,
    value: Math.round(median(g.rows.map((h) => h.totalPrizeManYen))),
    displayValue: `${formatManYen(Math.round(median(g.rows.map((h) => h.totalPrizeManYen))))}万`,
    n: g.rows.length,
  }));
}
const femaleBodyTypeBars = bodyTypeBars(racedFemales);

// ---- 「体の割に管が太い＝骨が丈夫」の検証（性別内・骨量スコアで3等分） ----
const boneZ = (() => {
  const zc = zBySexMap(all, 'caretGirth');
  const zw = zBySexMap(all, 'weight');
  return (h: RecruitWithResult) => (zc.get(h) ?? 0) - (zw.get(h) ?? 0); // >0 = 体重の割に管が太い（骨っぽい）
})();
const hasDebut = (h: RecruitWithResult) => (h.starts ?? 0) > 0;
function boneSoundness(rows: RecruitWithResult[]) {
  const { low, high } = tertileEnds(rows, boneZ); // low=骨が細い側, high=骨っぽい側
  const debutRate = (g: RecruitWithResult[]) => (100 * g.filter(hasDebut).length) / g.length;
  const winnerStartsMed = (g: RecruitWithResult[]) =>
    median(g.filter((h) => (h.wins ?? 0) >= 1).map((h) => h.starts as number));
  const winners = (g: RecruitWithResult[]) => g.filter((h) => (h.wins ?? 0) >= 1);
  return {
    lowN: low.length,
    highN: high.length,
    lowDebut: debutRate(low),
    highDebut: debutRate(high),
    debutTest: twoProportionZTest(
      high.filter(hasDebut).length,
      high.length,
      low.filter(hasDebut).length,
      low.length
    ),
    lowWinnerStarts: winnerStartsMed(low),
    highWinnerStarts: winnerStartsMed(high),
    lowWinnerN: winners(low).length,
    highWinnerN: winners(high).length,
    /**
     * 勝ち上がり馬に絞った出走数の差の検定。デビュー率の検定（`debutTest`）と別物なので
     * 分けて持つ（1つのp値を2つの主張の根拠に使い回していた・reviewer指摘 2026-09-02）。
     */
    startsTest: mannWhitneyU(
      winners(low).map((h) => h.starts as number),
      winners(high).map((h) => h.starts as number)
    ),
  };
}
const boneMale = boneSoundness(males);
const boneFemale = boneSoundness(females);
// 未勝利で終わると出走数が伸びない、を見せる比較（すでに3歳を終えた2022年募集までに絞る）。
const MATURE_YEAR = 2022;
const matureNoWin = raced.filter((h) => h.wins === 0 && h.recruitYear <= MATURE_YEAR);
const matureWinners = all.filter((h) => (h.wins ?? 0) >= 1 && h.recruitYear <= MATURE_YEAR);
const noWinStartsMedian = median(matureNoWin.map((h) => h.starts as number));
const winnerStartsMedian = median(matureWinners.map((h) => h.starts as number));

// ---- 4分位の両端どうしの比較（賞金・勝ち上がり率・重賞馬） ----
function endsCompare(racedRows: RecruitWithResult[], scheme: ReturnType<typeof quartileScheme>) {
  const light = racedRows.filter(scheme.light);
  const heavy = racedRows.filter(scheme.heavy);
  return {
    lightN: light.length,
    heavyN: heavy.length,
    lightMed: median(light.map((h) => h.totalPrizeManYen)),
    heavyMed: median(heavy.map((h) => h.totalPrizeManYen)),
    mw: mannWhitneyU(light.map((h) => h.totalPrizeManYen), heavy.map((h) => h.totalPrizeManYen)),
    superiority: probabilityOfSuperiority(
      light.map((h) => h.totalPrizeManYen),
      heavy.map((h) => h.totalPrizeManYen)
    ),
  };
}
const endsAll = endsCompare(raced, allScheme);
const endsMale = endsCompare(racedMales, maleScheme);
const endsFemale = endsCompare(racedFemales, femaleScheme);

const hasWin = (h: RecruitWithResult) => (h.wins ?? 0) >= 1;
function rateInQuartiles(rows: RecruitWithResult[], scheme: ReturnType<typeof quartileScheme>, hit: (h: RecruitWithResult) => boolean) {
  return scheme.order.map((label) => {
    const g = rows.filter(scheme.inGroup(label));
    return { label, rate: (100 * g.filter(hit).length) / g.length, n: g.length, hits: g.filter(hit).length };
  });
}
const isGradeWinner = (h: RecruitWithResult) => h.gradeWins.length > 0;
const femaleWinRates = rateInQuartiles(females, femaleScheme, hasWin);
const femaleGradeCounts = rateInQuartiles(females, femaleScheme, isGradeWinner);
const maleWinRates = rateInQuartiles(males, maleScheme, hasWin);
