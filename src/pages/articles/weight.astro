// 牡の賞金は単調でない（U字）と書いている。「きれいに右上がり」の牝との対比の根拠。
{
  const meds = malePrizeBars.map((b) => b.value);
  if (meds.every((v, i) => i === 0 || v >= meds[i - 1])) {
    premiseErrors.push(
      `牡の4分位の賞金中央値が単調増加になった（${meds.join(' / ')}万円）。` +
        '「牡の棒はデコボコ」「最軽量群がむしろ高い」と書いた本文を書き直すこと。'
    );
