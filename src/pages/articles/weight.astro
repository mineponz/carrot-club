// 牝でははっきり残る。
if (!(rFemale.spearman !== null && rFemale.spearman > 0.15 && rFemale.spearmanP !== null && rFemale.spearmanP < 0.01)) {
  premiseErrors.push(
    `牝で体重と賞金の順位相関が弱くなった（rs=${rFemale.spearman?.toFixed(3)} / p=${rFemale.spearmanP?.toFixed(4)}）。` +
      '「牝でははっきり効く」と書いた本文を書き直すこと。'
  );
}
if (!(endsFemale.mw.p < ALPHA)) {
  premiseErrors.push(
    `牝の軽い1/4 vs 重い1/4の賞金差が有意でなくなった（p=${endsFemale.mw.p.toFixed(4)}）。本文を書き直すこと。`
  );
}
// 牝の4分位の賞金中央値は軽い→重いで単調に増える。
{
  const meds = femalePrizeBars.map((b) => b.value);
  const monotonic = meds.every((v, i) => i === 0 || v >= meds[i - 1]);
  if (!monotonic) {
    premiseErrors.push(
      `牝の4分位の賞金中央値が単調増加でなくなった（${meds.join(' / ')}万円）。` +
