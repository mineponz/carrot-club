---
/**
 * 分析記事「体高と成績の関係」。2017〜2025年募集の全頭（`analysis/data/recruits.json`。
 * 2021〜2025年は自分のスプレッドシート、2017〜2020年はクラブ公式サイトの過去の測尺一覧から
 * 追加取込）の募集時データと現在の競走成績（`analysis/data/race-results.json`）をクロス集計して
 * 見せる、募集馬一覧とは別系統のコンテンツページ。
 * 広告は記事ページ専用のタグ（本人指定 / vault: 20260821-article-ad-embed-snippets）を使う。
 *
 * 2026-08-22の本人フィードバックで大きく書き直した:
 * - データ取得元（外部サービス名）は本文に出さない
 * - 賞金は中央+地方の合計で見る（分けると片方だけ稼ぐ馬の実力を見誤る）
 * - 馬名は募集時の仮の名前でなく競走馬登録後の実名を出す（`displayName`）
 * - 実際の重賞勝ち馬を「代表馬」として紹介する
 * - 2026年募集馬が体高分布のどこに当てはまるかをアコーディオンで見せる
 *
 * 2026-08-22〜23、2017〜2020年募集分（348頭・クラブ公式サイトの過去の測尺一覧から取込）を追加。
 * この4年分は当初 父・母父・一口価格が空だったが、2026-08-23に個体ページから補ったので
 * （`scripts/enrich-legacy-pedigree-price.mjs`）、「この年度は価格データが無い」と本文に
 * 決め打ちで書かないこと。欠測の頭数は`racedWithoutPrice`等から動的に出す。
 * 対象頭数・体高分布・相関係数・重賞馬まわりの数字はrecruits.json/race-results.jsonから動的に
 * 計算しているため、この4年分を足しただけで数値は自動的に更新される（vault:
 * 20260822-import-2017-2020-legacy-data）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarChart from '../../components/charts/BarChart.astro';
import ScatterChart from '../../components/charts/ScatterChart.astro';
import ChartTooltip from '../../components/charts/ChartTooltip.astro';
import StatTiles from '../../components/charts/StatTiles.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import AdSlot from '../../components/AdSlot.astro';
import GradeWinnerTable from '../../components/GradeWinnerTable.astro';
import { loadRecruitsWithResults, racedOnly, RACE_RESULTS_FETCHED_AT } from '../../lib/analysis-data.ts';
import { formatResultsAsOf } from '../../lib/sibling-recruits.ts';
import {
  histogram,
  pearsonCorrelation,
  bucketAverage,
  countByBucket,
  mean,
  median,
  formatManYen,
} from '../../lib/chart-math.ts';
import { horses2026 } from '../../data/horses2026.ts';

const all = loadRecruitsWithResults();
// 賞金・成績は取った時点でしか正しくないので、記事のどこでも同じ「いつ時点か」を出す。
// 決め打ちで書くと成績を取り直したときに古い日付だけ残る（実際に「2026年8月時点」と
// 直書きしていた・2026-08-23）。
const resultsAsOf = formatResultsAsOf(RACE_RESULTS_FETCHED_AT);
const raced = racedOnly(all);
const unraced = all.length - raced.length;

// ---- 体高階級（複数箇所で使い回す） ----
// 上限は「その値未満」で持つ。体高は0.5cm刻みで入っているため、上限を149・153…と
// 整数の以下で書くと 149.5 / 153.5 / 157.5 / 161.5cm の馬（470頭中39頭）がどの階級にも
// 入らず、階級別の集計から黙って抜け落ちる。ラベルも実際に入る範囲（.5まで）で書く。
const HEIGHT_BUCKETS: [string, number, number][] = [
  ['〜149.5cm', -Infinity, 150],
  ['150〜153.5cm', 150, 154],
  ['154〜157.5cm', 154, 158],
  ['158〜161.5cm', 158, 162],
  ['162cm〜', 162, Infinity],
];
function bucketLabel(height: number): string {
  for (const [label, lo, hiExclusive] of HEIGHT_BUCKETS) {
    if (height >= lo && height < hiExclusive) return label;
  }
  return '?';
}
const bucketOrder = HEIGHT_BUCKETS.map(([label]) => label);
function orderBuckets<T extends { bucket: string }>(rows: T[]): T[] {
  return bucketOrder.map((label) => rows.find((r) => r.bucket === label)).filter((r): r is T => !!r);
}

// ---- 体高の分布 ----
const heights = all.map((h) => h.height).filter((v): v is number => v !== null);
const heightMin = Math.min(...heights);
const heightMax = Math.max(...heights);
const heightMean = mean(heights);
const heightMedian = median(heights);
const heightBins = histogram(heights, 3, 141, 168).map((b) => ({
  label: `${b.binStart}〜${b.binEnd}`,
  value: b.count,
  displayValue: `${b.count}頭`,
}));

// ---- 散布図の表示上限 ----
// 獲得賞金合計は少数の稼ぎ頭に大きく引っ張られる分布（下の代表馬紹介を参照）。
// 全部を1つの散布図に収めると大半の点がグラフ下端に潰れて見えなくなるため、
// 表示は1億円未満に絞り、それを超える馬は代表馬の一覧で個別に紹介する。
const SCATTER_Y_MAX = 10000;

/**
 * 散布図の点の色分け（性別）。以前は `sex === '牝' ? 'female' : 'male'` と書いていて、
 * 取込元に性別の列が無い2017〜2020年募集分（当時348頭）まで牡として塗っていた。
 * 分からないものは牡に混ぜず `unknown` として別の色にする。
 * 2026-08-23に個体ページから性別を補い（`scripts/enrich-legacy-sex.mjs`）、いま `unknown` に
 * なるのは個体ページを特定できなかった3頭だけ。この3頭は成績も取れていない＝散布図の点に
 * ならないので、凡例からも「性別不明」は消える（`unknownSexPoints`）。
 */
function sexSeriesKey(sex: string | null): string {
  if (sex === '牝') return 'female';
  // 「セン」（去勢馬）は募集時点では牡。取込元が現在の性別で書いていても牡側に寄せる。
  if (sex === '牡' || sex === 'セン') return 'male';
  return 'unknown';
}

// ---- 体高 × 獲得賞金合計（出走済みのみ） ----
const racedWithHeight = raced.filter((h) => h.height !== null);
const heightPrizeR = pearsonCorrelation(
  racedWithHeight.map((h) => h.height as number),
  racedWithHeight.map((h) => h.totalPrizeManYen)
);
const heightScatterAll = racedWithHeight.length;
const toHeightPoint = (h: (typeof racedWithHeight)[number]) => ({
  x: h.height as number,
  y: h.totalPrizeManYen,
  seriesKey: sexSeriesKey(h.sex),
  tipTitle: h.displayName,
  tipRows: [
    ['体高', `${h.height}cm`],
    ['獲得賞金合計', `${formatManYen(h.totalPrizeManYen)}万円`],
    ['通算成績', `${h.starts}戦${h.wins}勝`],
  ] as [string, string][],
});
const heightScatterPoints = racedWithHeight.filter((h) => h.totalPrizeManYen < SCATTER_Y_MAX).map(toHeightPoint);
const heightScatterOmitted = heightScatterAll - heightScatterPoints.length;
// 1億円超えも含めた全頭版。メインのグラフは見やすさ優先で1億円未満に絞っているが、
// 「重賞馬（1億円超え）込みでも見たい」という本人希望を受け、アコーディオンに畳んで別出しする
// （本人指摘: 全部を1つの軸に収めると稼ぎ頭に引っ張られて母集団の点がグラフ下端に潰れて
// 見えにくくなるため、混ぜずに別グラフにする方針にした）。
const heightScatterFullPoints = racedWithHeight.map(toHeightPoint);
const heightScatterFullMax = Math.max(...heightScatterFullPoints.map((p) => p.y));
// 縦軸の上限を2億円刻みで切り上げる（77,663万円→80,000万円=8億円、のように）。
// 実データの最高額に合わせて動的に決めているので、稼ぎ頭が更新されても直し忘れない。
const heightScatterFullDomainMax = Math.ceil(heightScatterFullMax / 20000) * 20000;
const heightScatterFullTicks = [0, 1, 2, 3, 4].map(
  (i) => (heightScatterFullDomainMax / 4) * i
);

// ---- 体高階級別の平均賞金・平均勝ち数 ----
const prizeByHeightBucket = bucketAverage(
  racedWithHeight,
  (h) => bucketLabel(h.height as number),
  (h) => h.totalPrizeManYen
);
const winsByHeightBucket = bucketAverage(
  racedWithHeight,
  (h) => bucketLabel(h.height as number),
  (h) => h.wins ?? 0
);
// 階級ごとの「母集団の頭数」と「重賞勝ち馬の頭数」。棒の高さ（平均賞金）の母数は出走済みだけ
// なので、`n`（＝出走済み頭数）とは別物として軸の下に併記する。
// 重賞馬の絞り込み条件は下の「代表馬」節の `gradeWinners` と同じ（あちらは賞金順に並べたいので
// 別に持つ）。ここで `gradeWinners` を参照すると宣言前の参照になるため `all` から数え直す。
const allByHeightBucket = countByBucket(
  all.filter((h) => h.height !== null),
  (h) => bucketLabel(h.height as number)
);
const gradeWinnersByHeightBucket = countByBucket(
  all.filter((h) => h.height !== null && h.gradeWins.length > 0),
  (h) => bucketLabel(h.height as number)
);

// 「158cm以上／未満」で切った重賞馬の出方。平均賞金の棒だけ見ていると分からない差なので
// 本文で使う。母数は階級全体（未出走も含む全頭）で揃える ―― 出走済みだけに絞ると、
// まだデビューしていない2024・2025年募集組の多い階級ほど率が高く出てしまう。
/** 階級の「母数に対する重賞馬の割合(%)」。本文とグラフで同じ数から出す */
function gradeRateFor(bucket: string): number {
  const total = allByHeightBucket.get(bucket) ?? 0;
  return total ? (100 * (gradeWinnersByHeightBucket.get(bucket) ?? 0)) / total : 0;
}

const TALL_CUT = 158;
const withHeight = all.filter((h) => h.height !== null);
function gradeShare(items: typeof withHeight) {
  const n = items.length;
  const g = items.filter((h) => h.gradeWins.length > 0).length;
  return { n, g, pct: n ? (100 * g) / n : 0 };
}
const tall = gradeShare(withHeight.filter((h) => (h.height as number) >= TALL_CUT));
const short = gradeShare(withHeight.filter((h) => (h.height as number) < TALL_CUT));
// 2023年以前の募集だけに絞っても同じ傾向が出るか（デビュー時期の偏りで見かけ上そう見えて
// いるだけではないか）の確認。本文でこの数字にも触れる。
const olderOnly = withHeight.filter((h) => h.recruitYear <= 2023);
const tallOlder = gradeShare(olderOnly.filter((h) => (h.height as number) >= TALL_CUT));
const shortOlder = gradeShare(olderOnly.filter((h) => (h.height as number) < TALL_CUT));

const prizeBars = orderBuckets(prizeByHeightBucket).map((r) => ({
  label: r.bucket,
  value: r.avg,
  displayValue: `${formatManYen(r.avg)}万円`,
  n: r.n,
  // 「重賞n頭」だと勝利数と読めてしまうので「重賞馬n頭」と書く（数えているのは馬の数）
  note: `全${allByHeightBucket.get(r.bucket) ?? 0}頭・重賞馬${gradeWinnersByHeightBucket.get(r.bucket) ?? 0}頭`,
}));
const winBars = orderBuckets(winsByHeightBucket).map((r) => ({
  label: r.bucket,
  value: r.avg,
  displayValue: `${r.avg.toFixed(2)}勝`,
  n: r.n,
}));

// ---- 参考: 一口価格 × 獲得賞金合計 ----
// 2026-08-23にnetkeibaの個体ページから2017〜2020年募集分の一口価格を追加取得したため、
// 「この年度は価格が無い」という決め打ちはもう使えない（`scripts/enrich-legacy-pedigree-price.mjs`）。
// 残っている欠測は年度ではなく馬ごとの事情（引退後に馬主が個人名義へ変わって募集情報の欄が
// 消えている、募集中止になった馬など）なので、頭数だけを数えて本文・注記から動的に出す。
const racedWithPrice = raced.filter((h) => h.pricePerShare !== null);
const racedWithoutPrice = raced.length - racedWithPrice.length;
const pricePrizeR = pearsonCorrelation(
  racedWithPrice.map((h) => h.pricePerShare as number),
  racedWithPrice.map((h) => h.totalPrizeManYen)
);
const priceScatterAll = racedWithPrice.length;
const toPricePoint = (h: (typeof racedWithPrice)[number]) => ({
  x: h.pricePerShare as number,
  y: h.totalPrizeManYen,
  seriesKey: sexSeriesKey(h.sex),
  tipTitle: h.displayName,
  tipRows: [
    ['一口価格', `${h.pricePerShare}万円`],
    ['獲得賞金合計', `${formatManYen(h.totalPrizeManYen)}万円`],
    ['通算成績', `${h.starts}戦${h.wins}勝`],
  ] as [string, string][],
});
const priceScatterPoints = racedWithPrice.filter((h) => h.totalPrizeManYen < SCATTER_Y_MAX).map(toPricePoint);
const priceScatterOmitted = priceScatterAll - priceScatterPoints.length;
// 体高チャートと同じ理由で、1億円超え込みの全頭版は別グラフにする。
const priceScatterFullPoints = racedWithPrice.map(toPricePoint);
const priceScatterFullMax = Math.max(...priceScatterFullPoints.map((p) => p.y));
const priceScatterFullDomainMax = Math.ceil(priceScatterFullMax / 20000) * 20000;
const priceScatterFullTicks = [0, 1, 2, 3, 4].map((i) => (priceScatterFullDomainMax / 4) * i);

/**
 * 散布図に実際に出ている点のうち、性別が分からないもの。全頭ベース（`sex === null`の頭数）で
 * 数えると、**そもそも点にならない馬**――成績が取れていない＝出走済みに入らない馬――のせいで
 * 凡例にだけ「性別不明」が残ってしまう。凡例と注記は、グラフに出ている点だけを見て決める。
 */
const unknownSexPoints = [...heightScatterPoints, ...priceScatterPoints].filter(
  (p) => p.seriesKey === 'unknown'
).length;

const sexSeries = [
  { key: 'male', label: '牡', colorVar: '--series-1' },
  { key: 'female', label: '牝', colorVar: '--series-2' },
  ...(unknownSexPoints > 0 ? [{ key: 'unknown', label: '性別不明', colorVar: '--series-3' }] : []),
];

// ---- 代表馬（重賞勝ち馬） ----
const gradeWinners = all
  .filter((h) => h.gradeWins.length > 0)
  .sort((a, b) => b.totalPrizeManYen - a.totalPrizeManYen);
const gradeWinnersWithoutPrice = gradeWinners.filter((h) => h.pricePerShare === null).length;
/**
 * 重賞馬の表は獲得賞金の多い順。2017〜2020年募集分を足して44頭まで増え、スマホだと表だけで
 * 画面数ぶんの長さになったため、上位ぶんだけ開いた状態にして残りは折りたたむ（2026-08-23）。
 * 「全部載っている」ことは変えない ―― 抜粋にすると、載っていない馬がいるのか判断できない。
 */
const GRADE_WINNERS_VISIBLE = 10;
const gradeWinnersTop = gradeWinners.slice(0, GRADE_WINNERS_VISIBLE);
const gradeWinnersRest = gradeWinners.slice(GRADE_WINNERS_VISIBLE);
const gradeWinnerHeights = gradeWinners.map((h) => h.height as number);
const gradeHeightMin = Math.min(...gradeWinnerHeights);
const gradeHeightMax = Math.max(...gradeWinnerHeights);
// グラフの階級と食い違わないよう、階級の数え上げ（gradeWinnersByHeightBucket）から取る
const gradeWinnersInMidBucket = gradeWinnersByHeightBucket.get('154〜157.5cm') ?? 0;

// ---- 2026年募集馬が体高分布のどこに当てはまるか ----
const buckets2026 = HEIGHT_BUCKETS.map(([label]) => ({
  label,
  horses: horses2026
    .filter((h) => bucketLabel(h.height) === label)
    .sort((a, b) => a.height - b.height),
}));

const RECRUIT_YEARS = [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025];
const yearCounts = RECRUIT_YEARS.map((y) => `${y}年${all.filter((h) => h.recruitYear === y).length}頭`).join(
  '・'
);
const yearRangeLabel = `${RECRUIT_YEARS[0]}〜${RECRUIT_YEARS[RECRUIT_YEARS.length - 1]}年`;

/**
 * 忍者AdMaxの枠コード。この記事はセクションの切れ目ごとに1枠ずつ置く。
 *
 * 枠は設置場所ごとに発行するのが本来だが、この記事では**同じコードを複数の場所で使い回す**
 * （本人の判断 / 2026-08-22）。レポートは枠単位でしか割れないので、どのセクションの広告が
 * 効いたかまでは分からなくなる ―― 「記事から取れているか」が分かれば十分、という整理。
 *
 * RECT はスマホ用の300x250。縦に大きいので置きすぎると読み進みを塞ぐ。本文が一区切りつく
 * 「重賞馬の表の後」と「まとめの後」の2か所だけに使い、他は横長で流す。
 * PC幅にはこの300x250のコードが無いので、同じ位置には横長を出す。
 */
const AD_SP_WIDE_A = 'f81bbb016a82d6366a0e2f70051b1a0c';
const AD_SP_WIDE_B = 'b4b7d55c89d5fc92c564979491a16ad1';
const AD_SP_RECT = '24e3e1a24f40d88ee1a0ca315c54a7b9';
const AD_PC_WIDE_A = 'f0efb5bd6ae3e164bb584a4dbb846f48';
const AD_PC_WIDE_B = '0a525f6469ec1f40642b4550e53d39cc';

const description = `【非公式】キャロットクラブ${yearRangeLabel}${all.length}頭の募集時データと現在の競走成績を独自集計。体高・一口価格と獲得賞金・重賞勝ち馬の関係を散布図で見る分析記事。`;
---

<BaseLayout
  title="体高と成績の関係"
  description={description}
  breadcrumb={[{ label: '分析記事', href: '/articles/' }, { label: '体高と成績の関係', href: '/articles/height/' }]}
  showHeaderNotices={false}
  ogImage="/og-article-height-v1.png"
  ogImageAlt={`分析記事「体高と成績の関係を${all.length}頭のデータで見る」のカード画像（【非公式】キャロットクラブ出資馬検討ツール）`}
>
  <article>
    <h1>体高と成績の関係を見てみた</h1>

    <p>
      キャロットクラブの募集馬選びで「体高が大きい方が良さそうだ」と私は何となく思っていたんだけど、
      実際どうなんだろうと思って調べてみた。{yearRangeLabel}募集（{yearCounts}）の募集時データに、
      {resultsAsOf}時点の獲得賞金・通算成績を突き合わせた独自集計の結果。
    </p>

    <StatTiles
      tiles={[
        { label: '対象頭数', value: `${all.length}頭` },
        { label: '出走済み', value: `${raced.length}頭` },
        { label: '未出走', value: `${unraced}頭`, note: '大半が直近の2025年募集組' },
        {
          label: '体高 × 獲得賞金合計',
          value: heightPrizeR !== null ? `r=${heightPrizeR.toFixed(3)}` : '—',
          note: '弱い正の相関',
        },
        {
          label: '一口価格 × 獲得賞金合計',
          value: pricePrizeR !== null ? `r=${pricePrizeR.toFixed(3)}` : '—',
          note: 'ほぼ無相関（参考）',
        },
      ]}
    />

    <ArticleToc />

    <AdSlot sp={AD_SP_WIDE_A} pc={AD_PC_WIDE_A} />

    <h2>体高の分布</h2>
    <p>
      まず母集団を見ておくと、{all.length}頭の体高は{heightMin}〜{heightMax}cmに収まっていて、
      平均{heightMean.toFixed(1)}cm・中央値{heightMedian}cm。3cm刻みでヒストグラムにするとこんな感じ。
    </p>
    <BarChart title={`体高の分布（全${all.length}頭・3cm刻み）`} bars={heightBins} valueLabel="頭数" />

    <AdSlot sp={AD_SP_WIDE_B} pc={AD_PC_WIDE_B} />

    <h2>体高 × 獲得賞金合計</h2>
    <p>
      出走済みの{raced.length}頭で、体高と獲得賞金合計（中央+地方、万円）を散布図にしてみた。
      点にカーソルを合わせる（スマホはタップ）と馬名と成績が出る。相関係数は
      r={heightPrizeR?.toFixed(3)} で、「体高が大きいほど稼ぐ」と言い切れるほど強くはない、
      かなり弱い正の相関にとどまった。
      {heightScatterOmitted > 0 && (
        <>獲得賞金合計が1億円を超える{heightScatterOmitted}頭はこのグラフでは省略した
        （後述の代表馬紹介、または下の「1億円超えも含めて見る」を参照）。</>
      )}
      {unknownSexPoints > 0 && (
        <>点の色は性別で分けている。性別が取れていない{unknownSexPoints}頭は牡に混ぜず
        <strong>「性別不明」の灰色</strong>で出している（牡に混ぜると牡の点が実際より
        多く見えてしまうため）。</>
      )}
    </p>
    <ScatterChart
      title={`体高 × 獲得賞金合計（出走済み・1億円未満${heightScatterPoints.length}頭）`}
      points={heightScatterPoints}
      series={sexSeries}
      xLabel="体高(cm)"
      yLabel="獲得賞金合計(万円)"
      xDomain={[141, 168]}
      yDomain={[0, SCATTER_Y_MAX]}
      xTicks={[145, 150, 155, 160, 165]}
      yTicks={[0, 2500, 5000, 7500, 10000]}
      formatX={(v) => `${v}`}
      formatY={(v) => (v === 0 ? '0' : `${v / 1000}k`)}
    />
    {heightScatterOmitted > 0 && (
      <details class="bucket-accordion">
        <summary>1億円超えも含めて見る（出走済み全{heightScatterAll}頭）</summary>
        <p class="table-note">
          稼ぎ頭を混ぜると軸が伸びて母集団の点がグラフ下端に潰れて見えにくくなるため、
          上のグラフとは分けている。縦軸のスケールが違う点に注意。
        </p>
        <ScatterChart
          title={`体高 × 獲得賞金合計（出走済み全${heightScatterAll}頭・1億円超え含む）`}
          points={heightScatterFullPoints}
          series={sexSeries}
          xLabel="体高(cm)"
          yLabel="獲得賞金合計(万円)"
          xDomain={[141, 168]}
          yDomain={[0, heightScatterFullDomainMax]}
          xTicks={[145, 150, 155, 160, 165]}
          yTicks={heightScatterFullTicks}
          formatX={(v) => `${v}`}
          formatY={(v) => (v === 0 ? '0' : `${v / 10000}億`)}
        />
      </details>
    )}

    <AdSlot sp={AD_SP_WIDE_A} pc={AD_PC_WIDE_A} />

    <h2>体高階級別に見ると</h2>
    <p>
      5階級に分けて平均を取ると傾向がもう少しはっきりする。<strong>154cm以上の階級</strong>がおおむね平均賞金・
      平均勝ち数ともに高めで、149.5cm以下は両方とも低い。ただし162cm以上はサンプルが
      {winBars.find((b) => b.label === '162cm〜')?.n ?? 0}頭しかいないので、この階級だけは参考程度に見てほしい。
    </p>
    <p>
      1つ目のグラフは軸の下に、その階級の母集団（体高が分かっている{withHeight.length}頭ベース）の頭数と、そのうち重賞を
      勝った馬の頭数を併記した。棒の高さ（平均獲得賞金合計）の母数はこのうち出走済みの馬だけ
      なので、頭数は棒にカーソルを合わせる（スマホはタップ）と両方出る。階級の分け方は
      2つ目のグラフも同じなので、頭数の併記は1つ目にまとめてある。
    </p>
    <BarChart
      title="体高階級別 平均獲得賞金合計"
      bars={prizeBars}
      valueLabel="平均獲得賞金合計"
      nLabel="平均の母数（出走済み）"
      noteLabel="階級全体"
    />
    <BarChart title="体高階級別 平均勝ち数" bars={winBars} valueLabel="平均勝ち数" />

    <AdSlot sp={AD_SP_WIDE_B} pc={AD_PC_WIDE_B} />

    <h2>実際にどんな馬がいたか</h2>
    <p>
      相関係数だけだと実感が湧かないので、この{all.length}頭の中で実際に重賞を勝った
      {gradeWinners.length}頭を獲得賞金の多い順に並べておく。表が長くなるので、開いているのは
      上位{GRADE_WINNERS_VISIBLE}頭で、残り{gradeWinnersRest.length}頭はその下の折りたたみに入れてある。
    </p>
    <GradeWinnerTable rows={gradeWinnersTop} />
    {gradeWinnersRest.length > 0 && (
      <details class="more-winners">
        <summary>残りの{gradeWinnersRest.length}頭も見る（獲得賞金{GRADE_WINNERS_VISIBLE + 1}位以下）</summary>
        <GradeWinnerTable rows={gradeWinnersRest} />
      </details>
    )}
    <p class="table-note">
      折りたたみを開いた{gradeWinners.length}頭が、{all.length}頭のうち重賞（中央G1〜G3・Jpn1〜3、地方重賞含む）を
      勝った馬のすべて。
      以下で「重賞馬」と書くのは<strong>この「重賞を1勝以上している馬」の頭数</strong>で、
      重賞の勝利数ではない。
      {gradeWinnersWithoutPrice > 0 && (
        <>一口価格が「—」の{gradeWinnersWithoutPrice}頭は、現在の馬主がクラブ名義でなくなっており価格を確認できない馬。</>
      )}
    </p>
    <p>
      頭数だけ見ると<strong>154〜157.5cm階級が{gradeWinnersInMidBucket}頭で最多</strong>だが、これは
      この階級の母数が{allByHeightBucket.get('154〜157.5cm')}頭と一番多いからで、
      <strong>母数に対する割合で見ると景色が変わる</strong>。
    </p>

    <div class="finding">
      <p class="finding-lead">重賞馬の出方は、階級で3倍以上ちがう</p>
      <ul>
        <li>
          <strong>158〜161.5cm</strong>… {allByHeightBucket.get('158〜161.5cm')}頭中
          {gradeWinnersByHeightBucket.get('158〜161.5cm')}頭が重賞馬
          <strong>（{gradeRateFor('158〜161.5cm').toFixed(1)}%）</strong>
        </li>
        <li>
          154〜157.5cm… {allByHeightBucket.get('154〜157.5cm')}頭中
          {gradeWinnersByHeightBucket.get('154〜157.5cm')}頭（{gradeRateFor('154〜157.5cm').toFixed(1)}%）
        </li>
        <li>
          158cmで切ると、<strong>158cm以上は{tall.pct.toFixed(1)}%</strong>（{tall.n}頭中{tall.g}頭）／
          158cm未満は{short.pct.toFixed(1)}%（{short.n}頭中{short.g}頭）
        </li>
      </ul>
    </div>

    <p class="table-note">
      <strong>デビュー時期の偏りではないか？</strong>
      レースを重ねている2023年以前の募集だけに絞っても、158cm以上{tallOlder.pct.toFixed(1)}%・
      158cm未満{shortOlder.pct.toFixed(1)}%で傾向は変わらなかった。一口価格の平均もこの階級だけ
      高いわけではない（むしろ全体平均より安い）ので、「高い馬が集まっているから」でも説明できない。
    </p>
    <p class="table-note">
      <strong>ただし断言できるほどのデータではない。</strong>
      重賞馬は全部で{gradeWinners.length}頭しかおらず、5つの階級を見比べて一番良かったものを
      取り上げている以上、たまたま偏った可能性は残る。体高そのものが原因とも言えない
      （大きく育つ馬は血統・育成環境も違う）。実際の重賞馬は{gradeHeightMin}〜{gradeHeightMax}cmに
      散らばっていて、両端の体高から重賞馬が出ないと言えるほどでもない。
    </p>

    <div class="ad-rect">
      <AdSlot sp={AD_SP_RECT} pc={AD_PC_WIDE_A} />
    </div>

    <h2>参考: 一口価格との比較</h2>
    <p>
      「じゃあ高い馬を選べばいいのでは」と思う人もいるはずなので、一口価格と獲得賞金合計の関係も
      同じ形式で並べておく。対象は出走済み{raced.length}頭のうち一口価格が分かっている
      {racedWithPrice.length}頭{racedWithoutPrice > 0 && <>（残り{racedWithoutPrice}頭は現在の馬主がクラブ名義でなくなっており、netkeiba側の記載欄自体が無いため除外）</>}。
      相関係数は r={pricePrizeR?.toFixed(3)} でほぼゼロ。体高よりもさらに予測力が無かった。
      {priceScatterOmitted > 0 && <>（1億円超えの{priceScatterOmitted}頭はこのグラフでは省略。
      下の「1億円超えも含めて見る」参照）</>}
      価格帯で見ても平均賞金はほとんど横並びで、一口価格は「その年の人気・血統への期待値」で
      あって「将来の稼ぎ」を予測する指標ではなさそう、というのが今回の実感。
    </p>
    <ScatterChart
      title={`一口価格 × 獲得賞金合計（出走済み・価格データあり・1億円未満${priceScatterPoints.length}頭）`}
      points={priceScatterPoints}
      series={sexSeries}
      xLabel="一口価格(万円)"
      yLabel="獲得賞金合計(万円)"
      xDomain={[0, 42]}
      yDomain={[0, SCATTER_Y_MAX]}
      xTicks={[0, 10, 20, 30, 40]}
      yTicks={[0, 2500, 5000, 7500, 10000]}
      formatX={(v) => `${v}`}
      formatY={(v) => (v === 0 ? '0' : `${v / 1000}k`)}
    />
    {priceScatterOmitted > 0 && (
      <details class="bucket-accordion">
        <summary>1億円超えも含めて見る（価格データあり全{priceScatterAll}頭）</summary>
        <p class="table-note">
          稼ぎ頭を混ぜると軸が伸びて母集団の点がグラフ下端に潰れて見えにくくなるため、
          上のグラフとは分けている。縦軸のスケールが違う点に注意。
        </p>
        <ScatterChart
          title={`一口価格 × 獲得賞金合計（価格データあり全${priceScatterAll}頭・1億円超え含む）`}
          points={priceScatterFullPoints}
          series={sexSeries}
          xLabel="一口価格(万円)"
          yLabel="獲得賞金合計(万円)"
          xDomain={[0, 42]}
          yDomain={[0, priceScatterFullDomainMax]}
          xTicks={[0, 10, 20, 30, 40]}
          yTicks={priceScatterFullTicks}
          formatX={(v) => `${v}`}
          formatY={(v) => (v === 0 ? '0' : `${v / 10000}億`)}
        />
      </details>
    )}

    <AdSlot sp={AD_SP_WIDE_A} pc={AD_PC_WIDE_B} />

    <h2>2026年募集馬はどこに当てはまる？</h2>
    <p>
      せっかくなので、今の2026年募集{horses2026.length}頭の体高が、この階級分けのどこに入るかも
      並べておく（下の各行をタップすると開く。馬名は個別ページへのリンク）。血統・価格・厩舎
      など他の条件でも並べ替え・絞り込みしたい場合は<a href="/">出資馬検討ツール</a>もどうぞ。
    </p>
    {buckets2026.map((b) => (
      <details class="bucket-accordion">
        <summary>{b.label}（{b.horses.length}頭）</summary>
        <ul>
          {b.horses.map((h) => (
            <li>
              <a href={`/horses/${h.id}/`}>{h.name}</a>
              <span class="bucket-meta">{h.height}cm・{h.sex}・{h.sire}</span>
            </li>
          ))}
        </ul>
      </details>
    ))}

    <AdSlot sp={AD_SP_WIDE_B} pc={AD_PC_WIDE_A} />

    <h2>まとめ</h2>
    <ul class="conclusion">
      <li>体高と獲得賞金合計には弱い正の相関（r={heightPrizeR?.toFixed(3)}）があったが、
        「体高が大きいほど稼ぐ」と言い切れるほどではない。</li>
      <li>一口価格と獲得賞金合計はほぼ無相関（r={pricePrizeR?.toFixed(3)}）。価格は将来の稼ぎを
        予測しない。</li>
      <li>ただし<strong>「重賞を勝てるか」で見ると話が変わる</strong>。158cm以上は{tall.n}頭中{tall.g}頭
        （<strong>{tall.pct.toFixed(1)}%</strong>）が重賞馬なのに対し、158cm未満は{short.n}頭中{short.g}頭
        （{short.pct.toFixed(1)}%）。平均賞金の差より、こちらの差のほうがはっきりしている。
        <strong>大物を狙うなら158cm以上を厚めに見る</strong>、というのは今回のデータからは言えそう。</li>
      <li>とはいえ重賞勝ち馬は{gradeWinners.length}頭しかなく、5階級を見比べて一番良かった階級を
        取り上げている以上、偏りの可能性は残る。実際の重賞勝ち馬も{gradeHeightMin}〜
        {gradeHeightMax}cmの範囲（母集団全体{heightMin}〜{heightMax}cm）に散らばっていて、体高で足切りする
        根拠と言えるほどではない。</li>
      <li>結局のところ体高は「大物が出やすい層」の目印どまりで、そこから先は血統・厩舎・個体
        そのものの見立て、という当たり前の結論に落ち着いた。価格に至っては見ても仕方がない。</li>
    </ul>

    {/*
      読み終わりの枠。本文を隠して広告を見せる形（リワード）は忍者AdMaxでは視聴完了を
      判定できないので取らない。
    */}
    <div class="ad-rect">
      <AdSlot sp={AD_SP_RECT} pc={AD_PC_WIDE_B} />
    </div>

    <h2>データについて</h2>
    <p>
      募集時データはクラブが募集時に公表した測尺・血統・一口価格が元。
      競走成績は{resultsAsOf}時点のスナップショットで、今後レースを重ねるたびに変わっていく。
      2024・2025年募集組はまだ大半が未出走〜デビュー間もないため、今回の集計は出走済みの
      {raced.length}頭（主に2023年以前の募集組）が中心になっている点は割り引いて見てほしい。
      獲得賞金は中央（JRA）・地方（NAR）の合計で、海外レースで得た賞金は含まれていない。
      <strong>同じ年の追加募集馬は今回の{all.length}頭に含めていない。</strong>追加募集は通常の募集と
      測尺を測るタイミングが違い、体高をそのまま横に並べる前提が崩れるため、どの年も
      通常募集ぶんだけを対象にしている。
      相関係数はあくまで線形の関係の強さの目安で、これだけで「体高が原因で稼ぐ」と言えるわけ
      ではない（良い血統・良い厩舎の馬がたまたま大きく育つ、といった別の要因が絡んでいる
      可能性もある）。出資判断の材料というより、あくまで趣味の分析として楽しんでもらえたら。
    </p>

    <p>
      <a href="/">募集馬一覧へ戻る</a> ／ <a href="/articles/">分析記事一覧へ</a>
    </p>
  </article>

  <ChartTooltip />
</BaseLayout>

<style>
  article :global(h2) {
    margin-top: 2.5rem;
  }
  .table-note {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  /* 見つかったことを1か所にまとめて置く枠。ここだけは注記（.table-note）ではなく
     本文と同じ文字サイズで出す ―― 記事の結論に直結する数字なので小さくしない。 */
  .finding {
    margin: 1.25rem 0;
    padding: 0.9rem 1.1rem;
    background: var(--accent-weak);
    border-left: 3px solid var(--accent);
    border-radius: 0 6px 6px 0;
  }
  .finding-lead {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }
  .finding ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .finding li + li {
    margin-top: 0.35rem;
  }
  /* 300x250を置く枠。中央寄せは**包む側**でやる ―― `.ad-slot` 自体に display を書くと
     BaseLayout の `.ad-slot-pc { display: none }` より強くなり、出し分けが壊れる。 */
  .ad-rect {
    display: flex;
    justify-content: center;
    margin: 1.75rem 0 0.5rem;
  }
  .more-winners,
  .bucket-accordion {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 0.85rem;
    margin: 0.5rem 0;
  }
  .more-winners summary,
  .bucket-accordion summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.25rem 0;
  }
  /* 折りたたみの中の表は、閉じているときの高さに引きずられないよう上の余白だけ詰める */
  .more-winners :global(.table-scroll) {
    margin-top: 0.5rem;
  }
  .bucket-accordion ul {
    list-style: none;
    margin: 0.5rem 0 0.25rem;
    padding: 0;
  }
  .bucket-accordion li {
    padding: 0.25rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .bucket-meta {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .conclusion {
    padding-left: 1.25rem;
  }
  .conclusion li + li {
    margin-top: 0.5rem;
  }
</style>
