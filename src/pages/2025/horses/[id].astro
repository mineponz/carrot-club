---
/**
 * 2025年募集馬の個別ページ（`/2025/horses/{id}/`）。全93頭ぶんを静的生成する。
 *
 * 2026年版（`src/pages/2026/horses/[id].astro`）と対になる過去年度ぶん。データ・文言・
 * 一覧への戻り先・localStorageキーだけが違い、表示は共通コンポーネントを使う。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HorseDetail from '../../../components/HorseDetail.astro';
import { horses2025 } from '../../../data/horses2025.ts';
import { SITE_TAGLINE_2025 } from '../../../consts.ts';
import { horseDetailDescription, horseDetailTitle } from '../../../lib/horse-meta.ts';
import type { Horse } from '../../../lib/horses.ts';

export function getStaticPaths() {
  return horses2025.map((horse) => ({ params: { id: horse.id }, props: { horse } }));
}

const { horse } = Astro.props as { horse: Horse };
---

<BaseLayout
  title={horseDetailTitle(horse)}
  breadcrumbLabel={horse.name}
  description={horseDetailDescription(horse, 2025)}
  tagline={SITE_TAGLINE_2025}
  breadcrumb={[{ label: '2025年募集馬 一覧', href: '/2025/' }]}
  homeHref="/2025/"
  ogImage="/og-horse-detail-v1.png"
  ogImageAlt="出資馬検討ツール - キャロットクラブの募集馬詳細ページ"
>
  {/* 2026年版と同じく、その年度の全頭と個別ページの接頭辞を渡す（年度をまたいで混ぜない） */}
  <HorseDetail
    horse={horse}
    recruitYear={2025}
    listHref="/2025/"
    allHorses={horses2025}
    detailBasePath="/2025/horses/"
  />
</BaseLayout>
