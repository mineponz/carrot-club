---
/**
 * 2025年募集馬一覧（過去年度ページ / `/2025/`）。
 *
 * ルート（`/`）が最新年度（2026年募集）に切り替わったときに、旧トップページの内容を
 * そのままここへ退避したもの。データ（horses2025）・文言・localStorageのキーはすべて
 * 2025年のまま維持する。表示ロジックの共通部品（BaseLayout / horses.ts / horse-row.ts /
 * evaluations.ts）はルートと共有しているので、共通部品を触るときは両方の年度を確認すること。
 *
 * 表の行はビルド時とブラウザ側の両方で `horseRowHtml()` から作る。ビルド時に
 * 全頭を埋め込んでおかないと、サーバーが返すHTMLに馬のデータが1件も含まれず
 * （クローラーには「読み込み中…」しか見えず）検索に載らない。
 * ブラウザ側は読み込み後に localStorage の評価を反映して同じ関数で描き直す。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SyncPanel from '../../components/SyncPanel.astro';
import { SITE_DESCRIPTION_2025, SITE_TAGLINE_2025, UNOFFICIAL_NOTICE } from '../../consts.ts';
import { horses2025 } from '../../data/horses2025.ts';
import {
  sortHorses,
  uniqueSexes,
  uniqueValues,
  valueCounts,
  UNRATED,
  type SortKey,
} from '../../lib/horses.ts';
import { DEFAULT_EVALUATION } from '../../lib/evaluations.ts';
// A〜Eの並びはAPI側の定義を唯一の出所にする（ここで別の配列を作ると表・集計とずれる）
import { RATINGS } from '../../lib/evaluation-api.ts';
import { COLUMNS, horseRowHtml } from '../../lib/horse-row.ts';

// 個別ページは年度ごとに別ルート（`/2025/horses/{id}/`）。既定はルート年度なので明示的に渡す。
const DETAIL_BASE_PATH = '/2025/horses/';

// フィルタの選択肢はビルド時に確定できるのでサーバー側で作る
const sires = uniqueValues(horses2025, 'sire');
// 父は複数選べるチェックリストにしてあるので、選択肢ごとの頭数も添える
// （数十種類並ぶ中から選ぶので、1頭しかいない父を選んで表が空になる、という迷い方を減らす）。
const sireCounts = valueCounts(horses2025, 'sire');
const stables = uniqueValues(horses2025, 'stable');
// その年にいない性別（セ）のチェックは出さない（押しても0頭になるだけの選択肢を並べない）
const sexOptions = uniqueSexes(horses2025);
// 母齢の入力欄の min/max に実データの範囲を入れる（スピナーがその年に居ない歳まで動かない）。
// プレースホルダは他の範囲入力と同じ「下限/上限」にする ―― 数字を出すと入力済みに見えるため。
const damAges = horses2025.map((h) => h.damAge);
const damAgeMin = Math.min(...damAges);
const damAgeMax = Math.max(...damAges);

// COLUMNS は `as const` なので、そのままだと sortKey / align を持たない要素との
// union になって参照できない。ここで緩い型に受け直す。
const columns: readonly { label: string; sortKey?: SortKey; align?: string; cls?: string }[] = COLUMNS;

// 初期表示はクライアント側の既定（id昇順）と揃える。評価は端末ごとの値なので
// 初期HTMLでは未評価（DEFAULT_EVALUATION）で描き、読み込み後に上書きする。
const initialRowsHtml = sortHorses(horses2025, 'id', 'asc')
  .map((horse) => horseRowHtml(horse, DEFAULT_EVALUATION, DETAIL_BASE_PATH))
  .join('\n');

const total = horses2025.length;

// 以下の数値はすべて src/data/horses2025.ts を集計した実測値。
const damPriorityCount = horses2025.filter((h) => h.damPriority).length;
const surgeryCount = horses2025.filter((h) => h.surgery !== '').length;
const noSiblingCount = horses2025.filter((h) => h.sibling === '').length;
const maleCount = horses2025.filter((h) => h.sex === '牡').length;
const femaleCount = horses2025.filter((h) => h.sex === '牝').length;
const sireKinds = uniqueValues(horses2025, 'sire').length;
const bmsKinds = uniqueValues(horses2025, 'broodmareSire').length;
const stableKinds = stables.length;

function range(key: 'height' | 'chestGirth' | 'caretGirth' | 'weight' | 'pricePerShare') {
  const values = horses2025.map((h) => h[key]).sort((a, b) => a - b);
  const sum = values.reduce((a, b) => a + b, 0);
  return {
    min: values[0],
    max: values[values.length - 1],
    avg: Math.round((sum / values.length) * 10) / 10,
    median: values[Math.floor(values.length / 2)],
  };
}

const heightRange = range('height');
const chestRange = range('chestGirth');
const caretRange = range('caretGirth');
const weightRange = range('weight');
const priceRange = range('pricePerShare');

const measurements = [
  {
    term: '体高',
    unit: 'cm',
    meaning: '地面から き甲（首の付け根の盛り上がり）までの高さ。馬の背丈にあたる。',
    stat: heightRange,
  },
  {
    term: '胸囲',
    unit: 'cm',
    meaning: 'き甲の後ろで胴回りを一周した長さ。胴の太さの目安。',
    stat: chestRange,
  },
  {
    term: '管囲',
    unit: 'cm',
    meaning: '前脚の管（前膝から球節までの部分）を一周した長さ。脚元の太さの目安。',
    stat: caretRange,
  },
  {
    term: '馬体重',
    unit: 'kg',
    meaning: '計測時点の体重。',
    stat: weightRange,
  },
];

// FAQは「画面に見えている文言」と JSON-LD を完全に一致させる必要があるため、
// 必ずこの配列だけを唯一の出所にして両方を描画する（不一致はガイドライン違反）。
const faqs = [
  {
    q: '入力した評価やメモはどこに保存されますか？',
    a: '評価（A〜E）・お気に入り・消・メモは、お使いの端末のブラウザ内（localStorage）に保存されます。あわせて、端末を移っても引き継げるように、端末ごとにランダムに作られる匿名の同期ID（会員番号や氏名とは結び付きません）に紐づけてサーバーにも控えを保存します。控えは同じ同期IDからしか読み出せず、ほかの会員には公開されません。別の端末に引き継ぐ手順はページ下部の「評価を別の端末に引き継ぐ」をご覧ください。',
  },
  {
    q: 'このサイトはキャロットクラブの公式サイトですか？',
    a: `${UNOFFICIAL_NOTICE} 掲載しているのは募集馬リストの客観データを並べ替え・絞り込みできる形に整理したものだけで、出資の判断は必ずクラブ公式の情報でご確認ください。`,
  },
  {
    q: '「母優先」とは何ですか？',
    a: `その馬の母（繁殖牝馬）に出資している会員に優先枠がある、というクラブの制度上の区分です。この一覧では該当する馬の「母優」列に◯を付けており、2025年募集馬では${total}頭中${damPriorityCount}頭が該当します。絞り込みの「母優先」で「あり」を選ぶと該当馬だけに、「なし」を選ぶと該当しない馬だけに絞り込めます。`,
  },
  {
    q: 'このツールに独自の評価やおすすめは載っていますか？',
    a: '載っていません。掲載しているのは馬名・性別・父・母父・母齢・誕生日・厩舎・一口価格・体高・胸囲・管囲・馬体重・兄弟・母優先・手術や既往の記載といった客観データのみで、点数付けや順位付けは一切していません。評価は利用者自身が入力します。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="2025年募集馬 一覧"
  description={SITE_DESCRIPTION_2025}
  tagline={SITE_TAGLINE_2025}
  homeHref="/2025/"
  wide
>
  <h1>2025年募集馬 一覧（{total}頭）</h1>
  <p class="lead">
    キャロットクラブ2025年募集馬{total}頭を、血統・測尺・一口価格・厩舎で並べ替え、絞り込みできる
    非公式の選定支援ツールです。評価・お気に入り・消・メモはこの端末のブラウザ内（localStorage）に
    保存され、再読み込みしても残ります（<a href="#sync-panel">同期IDで別の端末に引き継げます</a>）。
    入力した内容がほかの会員に公開されることはありません。
  </p>
  <!-- 非公式である旨は BaseLayout のヘッダーで全ページに常時表示しているため、ここには重ねない -->
  <p class="year-switch">
    これは昨年（2025年募集）のアーカイブです。
    <a href="/">2026年募集馬（最新）の一覧はこちら</a>（評価は年ごとに別々に保存されます）。
  </p>


  <!--
    絞り込みは既定で畳んでおく（本人の指示）。表を先に見せたいのと、SPでは開いた状態の
    フォームだけで1画面ぶん占有してしまうため。JSを足さずに済むよう <details> を使う。
    畳んでいる間も入力欄はDOMに残るので、既存のフィルタ処理はそのまま動く。
    ただし「畳んだまま条件が効いている」状態は気づけないので、summary に効いている
    条件の数を出す（下の render() で更新）。
  -->
  <details class="filter-details">
    <summary>
      絞り込み
      <span class="filter-active-count" id="filter-active-count" hidden></span>
    </summary>
    <div class="filters">
      {/*
        父は1つしか選べない <select> だったが、「キズナとサトノダイヤモンドを並べて見る」
        ができなかったのでチェックボックスの複数選択にした（本人の指示・2026-08-24）。
        選んだ父の**いずれか**に当てはまる馬が残る（OR）。1つも選ばなければ全頭のまま。
        数十種類あって全部並べると絞り込みの箱が父だけで埋まるので <details> に畳み、
        選んでいる数は畳んだままでも分かるよう summary に出す（絞り込み全体の
        「N件の条件」と同じ考え方 ―― 効いている条件が画面から読み取れない状態を作らない）。
      */}
      <details class="multi-filter" id="filter-sire-details">
        <summary>
          父（種牡馬）
          <span class="multi-filter-state" id="filter-sire-state">すべて</span>
        </summary>
        <div class="multi-filter-options" role="group" aria-label="父（種牡馬）">
          {
            sires.map((s) => (
              <label class="checkbox-label">
                <input type="checkbox" class="filter-sire" value={s} />
                <span>
                  {s}
                  <span class="multi-filter-n">{sireCounts[s]}</span>
                </span>
              </label>
            ))
          }
        </div>
      </details>
      <label>
        馬名
        <input type="text" id="filter-name" placeholder="部分一致" />
      </label>
      <label>
        母父
        <input type="text" id="filter-bms" placeholder="部分一致" />
      </label>
      <label>
        厩舎
        <select id="filter-stable">
          <option value="">すべて</option>
          {stables.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
      {/* 性別も複数選択にした（牡とセをまとめて見る、という使い方があるため）。
          父と同じく「1つも選ばなければ全頭」。その年にいない性別は選択肢に出さない。 */}
      <div class="field-group">
        <span class="field-group-label" id="sex-filter-label">性別</span>
        <div class="field-group-options" role="group" aria-labelledby="sex-filter-label">
          {
            sexOptions.map((s) => (
              <label class="checkbox-label">
                <input type="checkbox" class="filter-sex" value={s} />
                {s}
              </label>
            ))
          }
        </div>
      </div>
      {/* 「母優先のみ」のチェックから3択に変えた（本人の指示・2026-08-23）。
          優先枠に取られにくい馬を探す＝「なし」で絞りたい、という使い方があるため。
          他の絞り込みと同じ <select> なので「すべて（空値）」は条件に数えられない。 */}
      <label>
        母優先
        <select id="filter-dam-priority">
          <option value="">すべて</option>
          <option value="has">あり</option>
          <option value="none">なし</option>
        </select>
      </label>
      {/* 母齢（出産時点の母の年齢）。若い母の初期産駒に寄せる／高齢の母を避ける、といった
          絞り方をするためのもの。他の測尺と同じ下限〜上限の形にそろえる。 */}
      <label>
        母齢 (歳)
        <span class="range">
          <input type="number" id="filter-dam-age-min" min={damAgeMin} max={damAgeMax} placeholder="下限" />
          〜
          <input type="number" id="filter-dam-age-max" min={damAgeMin} max={damAgeMax} placeholder="上限" />
        </span>
      </label>
      <label>
        一口 (万円)
        <span class="range">
          <input type="number" id="filter-price-min" placeholder="下限" />
          〜
          <input type="number" id="filter-price-max" placeholder="上限" />
        </span>
      </label>
      <label>
        体高 (cm)
        <span class="range">
          <input type="number" id="filter-height-min" placeholder="下限" />
          〜
          <input type="number" id="filter-height-max" placeholder="上限" />
        </span>
      </label>
      <label>
        管囲 (cm)
        <span class="range">
          <input type="number" id="filter-caret-min" step="0.1" placeholder="下限" />
          〜
          <input type="number" id="filter-caret-max" step="0.1" placeholder="上限" />
        </span>
      </label>
      <label>
        馬体重 (kg)
        <span class="range">
          <input type="number" id="filter-weight-min" placeholder="下限" />
          〜
          <input type="number" id="filter-weight-max" placeholder="上限" />
        </span>
      </label>

      <!--
        自分が付けたA〜Eでの絞り込み。複数選べて、選んだもののどれかが付いていれば残る（OR）。
        印の色は表の評価セレクトと同じ --rating-*-bg を使う（同じAが別の色に見えると迷う）。
        1つも選んでいない状態が既定＝全頭表示なので、「未選択なら全頭」を添えて
        「押していないから絞れていない」ことが分かるようにしている。
      -->
      <div class="rating-filters" role="group" aria-labelledby="rating-filters-label">
        <span class="rating-filters-label" id="rating-filters-label">自分の評価</span>
        {
          RATINGS.map((r) => (
            <label class="checkbox-label rating-option">
              <input type="checkbox" class="filter-rating" value={r} />
              <span class="rating-chip" data-rating={r}>{r}</span>
            </label>
          ))
        }
        <label class="checkbox-label rating-option">
          <input type="checkbox" class="filter-rating" value={UNRATED} />
          <span class="rating-chip rating-chip-unrated">未評価</span>
        </label>
        <span class="rating-filters-hint">未選択なら全頭</span>
      </div>

      <div class="toggles">
        <label class="checkbox-label">
          <input type="checkbox" id="filter-exclude-surgery" />
          手術・既往ありを除く
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="filter-hide-skip" />
          消を付けた馬を隠す
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="filter-favorite-only" />
          お気に入りのみ
        </label>
        <button type="button" id="filter-reset">条件をクリア</button>
        {/* 条件が次に開いたときも残ることを書いておく。黙って残ると「頭数が合わない」と見える */}
        <p class="filter-persist-note">絞り込みと並び順はこの端末に保存され、次に開いたときも残ります。</p>
      </div>
    </div>
  </details>

  <!--
    絞り込みフォームの直下（表の上）の広告枠。忍者AdMaxはPC/SPで枠コードが別なので
    2つ置いて `.ad-slot-sp` / `.ad-slot-pc`（BaseLayout の is:global CSS）で出し分ける。
    フッターの枠（BaseLayout の `showAds`）とも記事用の枠とも別コードなので混同しないこと。
  -->
  <div class="ad-slot ad-slot-sp">
    <!-- admax -->
    <script is:inline src="https://adm.shinobi.jp/s/dfe9af84d9224f830432d2f925ac402d"></script>
    <!-- admax -->
  </div>
  <div class="ad-slot ad-slot-pc">
    <!-- admax -->
    <script is:inline src="https://adm.shinobi.jp/s/b2b04d2af29b3c00936214b62e84900a"></script>
    <!-- admax -->
  </div>

  <!--
    メモは評価の隣の列にあり、既定では📝アイコンだけが出ている（本人の指示・2026-08-25）。
    アイコンを押すとその行だけ入力欄に入れ替わるので、1頭だけ書きたいときはこの
    チェックボックスを使わなくてよい。ここは「全頭ぶんをいっせいに開く／閉じる」ための
    ショートカットとして残している。絞り込み条件ではなく表示の切り替えなので、
    畳んである絞り込みフォームの中ではなく表のすぐ上に置く（押した結果がその場で見える）。
  -->
  <div class="table-options">
    <p id="result-count" class="result-count">{total} / {total} 頭</p>
    <label class="checkbox-label show-memo-toggle">
      <input type="checkbox" id="toggle-show-memo" />
      メモをすべて開く
    </label>
  </div>
  <p class="scroll-hint">
    表は横スクロールで全{columns.length}列が見られます（父・母父・測尺・厩舎・netkeibaリンクなど）。
    画面が広いときは <strong>No・馬名・評価</strong> の3列が左端に残るので、スクロールしても
    どの馬に評価を入れているか分かります。
  </p>

  <div class="table-wrap">
    <table id="horse-table">
      <caption class="visually-hidden">
        2025年募集馬{total}頭の血統・測尺・一口価格・厩舎の一覧（評価欄つき）
      </caption>
      <thead>
        <tr>
          {
            columns.map((col) => (
              <th class:list={[col.align === 'num' && 'num', col.cls]}>
                {col.sortKey ? (
                  <button type="button" class="sort-btn" data-sort-key={col.sortKey}>{col.label}</button>
                ) : (
                  col.label
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody id="horse-tbody" set:html={initialRowsHtml} />
    </table>
  </div>

  {/* 表のすぐ下に置く。評価を入れ終えた直後が「別の端末でも見たい」と思う場所なので */}
  <SyncPanel recruitYear={2025} />

  <h2>このツールでできること</h2>
  <p>
    {total}頭を1つの表で並べ替え・絞り込みしながら比較できます。次のことができます。
  </p>
  <ul>
    <li>列見出しをクリックして並べ替える（もう一度押すと昇順・降順が入れ替わります）</li>
    <li>馬名・母父・厩舎で絞り込む</li>
    <li>父（種牡馬）と性別は複数選べる（選んだうちのどれかに当てはまる馬が残ります）</li>
    <li>母齢・一口価格・体高・管囲・馬体重を下限〜上限の範囲で絞り込む</li>
    <li>「母優先」（あり／なし）「手術・既往ありを除く」で候補を狭める</li>
    <li>各馬にA〜Eの評価・お気に入り（★）・消・メモを付け、「お気に入りのみ」「消を付けた馬を隠す」で見直す（メモ欄は表の上の「メモを表示」を入れると出ます。入っている馬は評価欄に📝が付きます）</li>
    <li>自分が付けたA〜Eで絞り込む（A・Bのように複数選べ、まだ印を付けていない「未評価」も選べます）</li>
    <li>気になった馬はその場で netkeiba の個体ページや X の検索結果を開いて調べる</li>
  </ul>

  <h2>使い方</h2>
  <ol>
    <li>まず「一口 (万円)」で出せる予算に絞り、頭数を減らします。</li>
    <li>父・母父・厩舎など、自分が重視する条件で並べ替えて上から眺めます（父は「父（種牡馬）」から気になる種牡馬をまとめて選べます）。</li>
    <li>気になった馬の <strong>評価欄（馬名のすぐ右）</strong> でA〜Eを選ぶか、★を押します。</li>
    <li>検討から外した馬は「消」にチェックを入れ、「消を付けた馬を隠す」で視界から外します。</li>
    <li>
      ひと通り印を付けたら、絞り込みの <strong>「自分の評価」</strong> でA・Bだけにチェックを入れて
      上位だけを見比べます（複数選べます）。「未評価」を選べば、まだ印を付けていない馬の
      取りこぼしも確認できます。
    </li>
    <li>最後に「お気に入りのみ」にチェックを入れると、残った候補だけを見比べられます。</li>
  </ol>
  <p class="note">
    条件を全部戻したいときは「条件をクリア」を押してください。評価・お気に入り・消・メモは
    クリアされません。
  </p>

  <h2>測尺（体高・胸囲・管囲・馬体重）の見方</h2>
  <p>
    測尺は募集時点で計測された馬体のサイズです。単体の数値だけでは判断しづらいので、
    このツールでは同じ年の募集馬{total}頭の中での位置を見るために使えます
    （下の範囲は掲載データを集計した実測値です）。
  </p>
  <dl class="measure-list">
    {
      measurements.map((m) => (
        <div class="measure-item">
          <dt>{m.term}</dt>
          <dd>
            <p class="measure-meaning">{m.meaning}</p>
            <p class="measure-stat">
              {total}頭では {m.stat.min}〜{m.stat.max}{m.unit}（平均 {m.stat.avg}{m.unit}）
            </p>
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="note">
    数値の大小がそのまま良し悪しを表すわけではないため、このツールでは測尺に対する
    点数付けや推奨は行っていません。どこを重視するかは利用者が決めるものとしています。
  </p>

  <h2>「母優先」とは</h2>
  <p>
    その馬の母（繁殖牝馬）に出資している会員に優先枠がある、というクラブの制度上の区分です。
    一覧の「母優」列に◯が付いている馬が該当し、2025年募集馬では{total}頭中{damPriorityCount}頭が該当します。
    絞り込みの「母優先」で「あり」を選ぶと該当馬だけ、「なし」を選ぶと該当しない馬だけに絞り込めます。
  </p>

  <h2>掲載しているデータ</h2>
  <p>
    2025年募集馬の確定リストに載っている客観情報だけを収録しています（{total}頭・
    牡{maleCount}頭／牝{femaleCount}頭）。個人の評価・見送り判断は含みません。
  </p>
  <ul>
    <li>父は{sireKinds}種類、母父は{bmsKinds}種類、厩舎の記載は{stableKinds}通り</li>
    <li>一口価格は{priceRange.min}万円〜{priceRange.max}万円（中央値{priceRange.median}万円）</li>
    <li>手術・既往の記載がある馬は{surgeryCount}頭（一覧の「手術・既往」列に赤い◯を付けています。記載の全文は各馬の個別ページに載せています）</li>
    <li>兄弟欄に記載のない馬は{noSiblingCount}頭</li>
  </ul>
  <p class="note">
    データは募集馬確定リスト時点のものです。最新の情報や実際の募集条件は必ずクラブ公式でご確認ください。
  </p>

  <h2>よくある質問</h2>
  <div class="faq">
    {
      faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

  <style>
    .lead { color: var(--muted); margin-top: 0; }
    /* 年度切り替えの導線。本文より弱く、でも見落とさない程度に */
    /* margin(3値)は左右マージンを暗黙に0にし、main.is-wideの子に効かせている
       margin-inline: autoに詳細度で勝ってしまう（[[20260824-astro-scoped-css-margin-shorthand-beats-global-centering]]）。
       margin-blockで左右に触れないようにする。 */
    .year-switch { margin-block: 0 0.5rem; font-size: 0.875rem; color: var(--muted); }
    .note { color: var(--muted); font-size: 0.875rem; }

    .unofficial {
      margin: 0 0 0.5rem;
      padding: 0.6rem 0.8rem;
      border-left: 3px solid var(--accent);
      background: var(--accent-weak);
      font-size: 0.8125rem;
    }

    /* 枠線・背景は <details> 側に持たせ、開閉しても外形が変わらない1つの箱に見せる。
       .filters（中身）は枠を持たず、閉じているときは箱＝見出し行だけになる。 */
    .filter-details {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-block: 1.25rem 0.75rem;
      font-size: 0.875rem;
    }
    .filter-details > summary {
      cursor: pointer;
      padding: 0.7rem 1rem;
      font-weight: 600;
      /* 三角マーカーを内側に置く（既定の list-item 表示だと箱の外にはみ出す） */
      list-style-position: inside;
    }
    .filter-details > summary:hover { color: var(--accent); }
    .filter-details[open] > summary { border-bottom: 1px solid var(--border); }
    /* 畳んだまま条件が効いていることに気づけるよう、件数を見出しに出す */
    .filter-active-count {
      margin-left: 0.5rem;
      padding: 0.05rem 0.45rem;
      border-radius: 999px;
      background: var(--accent);
      color: var(--surface);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem 1.1rem;
      align-items: end;
      padding: 1rem;
      font-size: 0.875rem;
    }
    .filters label {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      color: var(--muted);
    }
    .filters input[type='text'],
    .filters input[type='number'],
    .filters select {
      font: inherit;
      padding: 0.4rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: var(--bg);
      color: var(--text);
      max-width: 11rem;
    }
    .filters .range {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      color: var(--muted);
    }
    .filters .range input { width: 4.5rem; }

    .toggles {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.9rem;
      width: 100%;
      border-top: 1px solid var(--border);
      padding-top: 0.9rem;
    }

    /* 入力欄の行とチェックボックスの行の区切りは .toggles と同じ扱いにして、
       「条件の種類が変わった」ことを罫線1本だけで示す（枠や背景は重ねない）。 */
    .rating-filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.9rem;
      width: 100%;
      border-top: 1px solid var(--border);
      padding-top: 0.9rem;
    }
    .rating-filters-label { color: var(--muted); }
    .rating-filters-hint {
      color: var(--muted);
      font-size: 0.8125rem;
      margin-left: auto;
    }
    /* チェックボックスと印は一体で押したいので、他のトグルより間隔を詰める */
    .rating-option { gap: 0.3rem !important; }
    .rating-chip {
      display: inline-block;
      min-width: 1.6rem;
      padding: 0.1rem 0.4rem;
      border: 1px solid transparent; /* 未評価だけ枠線を出すので、幅を揃えるために全員に持たせる */
      border-radius: 4px;
      text-align: center;
      font-weight: 600;
      font-size: 0.8125rem;
      line-height: 1.4;
    }
    /* 色は表の評価セレクト（BaseLayout の --rating-*）と同じものを使う */
    .rating-chip[data-rating='A'] { background: var(--rating-a-bg); color: var(--rating-a-fg); }
    .rating-chip[data-rating='B'] { background: var(--rating-b-bg); color: var(--rating-b-fg); }
    .rating-chip[data-rating='C'] { background: var(--rating-c-bg); color: var(--rating-c-fg); }
    .rating-chip[data-rating='D'] { background: var(--rating-d-bg); color: var(--rating-d-fg); }
    .rating-chip[data-rating='E'] { background: var(--rating-e-bg); color: var(--rating-e-fg); }
    /* 未評価は「印が無い」状態なので色を持たせない。表の未評価セレクトと同じ地の見た目にする。 */
    .rating-chip-unrated {
      border-color: var(--border);
      color: var(--muted);
      font-weight: 400;
    }
    /* 父（種牡馬）の複数選択。選択肢が数十種類あるので既定は畳んでおき、開いたときだけ
       絞り込みの箱いっぱいに広げる（幅を取らせないと1列に数十行並んで縦に伸びる）。 */
    .multi-filter {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: var(--bg);
    }
    .multi-filter > summary {
      cursor: pointer;
      padding: 0.4rem 0.6rem;
      color: var(--muted);
      /* 三角マーカーを内側に置く（既定の list-item 表示だと枠の外にはみ出す） */
      list-style-position: inside;
    }
    .multi-filter-state {
      margin-left: 0.3rem;
      color: var(--text);
      font-weight: 600;
    }
    .multi-filter-options {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
      gap: 0.4rem 0.6rem;
      /* 全部見せると絞り込みの箱が父だけで画面を埋めるので、高さを切って中でスクロールさせる */
      max-height: 14rem;
      overflow-y: auto;
      padding: 0.6rem;
      border-top: 1px solid var(--border);
    }
    .multi-filter-n {
      margin-left: 0.3rem;
      color: var(--muted);
      font-size: 0.75rem;
    }
    /* <label>＋<input> ではなくチェックボックスの群れを1つの項目として見せるための入れ物。
       見た目（ラベルが上・中身が下）は .filters label に合わせる。 */
    .field-group {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      color: var(--muted);
    }
    .field-group-options {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      /* 隣の <select> と高さをそろえて、同じ行の項目が下端で揃うようにする */
      padding-block: 0.4rem;
    }
    .checkbox-label {
      flex-direction: row !important;
      align-items: center;
      gap: 0.35rem !important;
      color: var(--text) !important;
    }
    #filter-reset {
      font: inherit;
      font-size: 0.8125rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      color: var(--text);
      margin-left: auto;
    }
    #filter-reset:hover { border-color: var(--accent); color: var(--accent); }
    /* 「条件をクリア」の下に回り込ませる（ボタンは margin-left:auto で右端） */
    .filter-persist-note {
      flex-basis: 100%;
      margin: 0.25rem 0 0;
      text-align: right;
      font-size: 0.75rem;
      color: var(--muted);
    }

    /* 横スクロール用に overflow-x を持たせている時点で、この要素はスクロールコンテナに
       なっている。つまり中の thead の `position: sticky; top: 0` はページではなく
       **この箱**を基準にする。高さを縦に伸ばしっぱなし（scrollHeight == clientHeight）に
       していると縦方向には一度もスクロールしないので、見出し行は固定されない
       ―― 実測でもページを600pxスクロールすると thead は画面外(-599px)へ消えていた。
       高さを画面内に収めて縦スクロールもこの箱に持たせることで、見出し行が箱の上端に
       張り付く。100dvh はSPのURLバー伸縮に追従させるため（未対応ブラウザ用に vh も併記）。 */
    .table-wrap {
      overflow: auto;
      max-height: calc(100vh - 2rem);
      max-height: calc(100dvh - 2rem);
      /* 端まで来たらページ側のスクロールへ引き継ぐ（contain にすると表で指が止まる） */
      overscroll-behavior: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
    }

    /* 頭数（左）と表示の切り替え（右）を同じ行に載せる */
    .table-options {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.25rem 1rem;
      margin-block: 0 0.25rem;
    }
    .result-count {
      color: var(--muted);
      font-size: 0.8125rem;
      margin: 0;
    }
    /* .checkbox-label は .filters の中の flex 前提のスタイルなので、ここでは自前で横並びにする */
    .show-memo-toggle {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8125rem;
      color: var(--muted);
      cursor: pointer;
    }

    /* 表幅が画面に収まらないことに気づかず、評価欄（右方向）を見落とす人がいたため明示する */
    .scroll-hint {
      color: var(--muted);
      font-size: 0.8125rem;
      margin: 0 0 0.5rem;
    }
    .scroll-hint strong { color: var(--text); }

    .measure-list { margin-block: 0.75rem 0; }
    .measure-item {
      display: grid;
      grid-template-columns: 5rem 1fr;
      gap: 0.5rem 1rem;
      padding: 0.6rem 0;
      border-top: 1px solid var(--border);
    }
    .measure-item dt { font-weight: 600; }
    .measure-item dd { margin: 0; }
    .measure-meaning { margin: 0; }
    .measure-stat { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.875rem; }
    @media (max-width: 32rem) {
      .measure-item { grid-template-columns: 1fr; gap: 0.15rem; }

      /* 幅の狭い画面では .filters label が max-width: 11rem のまま伸びず、
         右半分が空いた状態で1列ずつ折り返してしまう。各項目を横幅いっぱいにする。 */
      .filters label { flex: 1 1 100%; min-width: 0; }
      /* ただし評価の印は中身が1文字なので、横幅いっぱいにすると6行を占有してしまう。
         ここだけは内容幅のまま横に並べる。性別（牡/牝/セ）も同じ理由で横並びのままにする。 */
      .filters .rating-filters label { flex: 0 0 auto; }
      .filters .field-group-options label { flex: 0 0 auto; }
      /* 父のチェックリストは1列（幅いっぱい）にして、名前が折り返さないようにする */
      .multi-filter-options { grid-template-columns: 1fr; }
      /* 印を折り返した行に「未選択なら全頭」が取り残されないよう、右寄せをやめる */
      .rating-filters-hint { margin-left: 0; flex-basis: 100%; }
      .filters input[type='text'],
      .filters input[type='number'],
      .filters select {
        max-width: none;
        width: 100%;
      }
      /* .range 自体に幅を明示しないと、中の input(flex:1 1 0) が親(label)の幅ではなく
         自分たちの内容サイズを基準に広がり、ラベルより広くなって画面右にはみ出していた。 */
      .filters .range { width: 100%; min-width: 0; }
      .filters .range input { width: auto; flex: 1 1 0; min-width: 0; }
    }

    .faq-item { border-top: 1px solid var(--border); padding-top: 0.75rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.25rem; }
    .faq-item p { margin: 0 0 1rem; }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  </style>

  <!--
    表の行はクライアント側の script が innerHTML で描き直すため、Astro のスコープ属性が
    付かない。スコープ付き <style> のセレクタは一致せず無効になるので、表まわりだけは
    is:global にする（誤爆を避けるため全セレクタを #horse-table 配下に限定する）。
  -->
  <style is:global>
    #horse-table {
      border-collapse: collapse;
      width: 100%;
      font-size: 0.8125rem;
      white-space: nowrap;
    }
    #horse-table th,
    #horse-table td {
      padding: 0.4rem 0.55rem;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: middle;
    }
    #horse-table thead th {
      background: var(--accent-weak);
      position: sticky;
      top: 0;
      z-index: 2;
    }
    #horse-table th.num,
    #horse-table td.num { text-align: right; }
    #horse-table tbody tr:hover td { background: var(--accent-weak); }

    /* 左端3列（No・馬名・評価）は固定するので、幅を固定して left オフセットと一致させる。
       auto レイアウトのままだと中身に応じて列幅が伸び、固定位置とずれて列が重なる。
       3.5rem + 12.5rem = 16rem が評価列の左オフセットになる。 */
    #horse-table th:nth-child(1),
    #horse-table td:nth-child(1) {
      width: 3.5rem;
      min-width: 3.5rem;
      max-width: 3.5rem;
    }
    #horse-table th:nth-child(2),
    #horse-table td:nth-child(2) {
      width: 12.5rem;
      min-width: 12.5rem;
      max-width: 12.5rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* 評価列は 10rem（メモの📝を隣のメモ列へ移したので、11.5rem まで広げなくてよくなった）。 */
    #horse-table th:nth-child(3),
    #horse-table td:nth-child(3) {
      width: 10rem;
      min-width: 10rem;
      max-width: 10rem;
    }

    /* 表は画面幅に収まらない（実データで約2000px）。評価欄を操作している間もどの馬か
       分かるように、馬名は画面幅を問わず常に左端に固定する。No・評価まで固定するのは
       狭い画面では表示領域をほぼ使い切ってしまうため、広い画面だけに追加で固定する。
       固定列は背景を塗らないと、下を流れる列が透けて重なって見える。 */
    #horse-table th:nth-child(2),
    #horse-table td:nth-child(2) {
      position: sticky;
      left: 0;
      background: var(--surface);
      z-index: 1;
      /* 固定列とスクロール部分の境目。罫線だと表の他の線と紛れるので、
         「この下を内容が流れている」ことが分かる弱い影にする（枠線との二重使いはしない）。 */
      box-shadow: 6px 0 5px -5px rgb(0 0 0 / 0.28);
    }
    #horse-table thead th:nth-child(2) {
      background: var(--accent-weak);
      z-index: 3; /* 縦横どちらの固定にも勝つ必要がある */
    }
    #horse-table tbody tr:hover td:nth-child(2) { background: var(--accent-weak); }

    @media (min-width: 56rem) {
      #horse-table th:nth-child(1),
      #horse-table td:nth-child(1) {
        position: sticky;
        left: 0;
        background: var(--surface);
        z-index: 1;
      }
      /* 広い画面では No 列が左端に来るため、馬名列は No 列の幅ぶん右にずらし、
         境目の影は評価列側（新しい右端）に移す。 */
      #horse-table th:nth-child(2),
      #horse-table td:nth-child(2) {
        left: 3.5rem;
        box-shadow: none;
      }
      #horse-table th:nth-child(3),
      #horse-table td:nth-child(3) {
        position: sticky;
        left: 16rem;
        background: var(--surface);
        z-index: 1;
        box-shadow: 6px 0 5px -5px rgb(0 0 0 / 0.28);
      }
      #horse-table thead th:nth-child(1),
      #horse-table thead th:nth-child(3) {
        background: var(--accent-weak);
        z-index: 3;
      }
      #horse-table tbody tr:hover td:nth-child(1),
      #horse-table tbody tr:hover td:nth-child(3) { background: var(--accent-weak); }
    }

    #horse-table .sort-btn {
      font: inherit;
      font-weight: 600;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--text);
      padding: 0;
      white-space: nowrap;
    }
    #horse-table .sort-btn:hover { color: var(--accent); }
    #horse-table .sort-btn[data-active='true'] { color: var(--accent); }

    #horse-table .horse-name { font-weight: 600; }
    #horse-table .sibling,
    #horse-table .surgery {
      max-width: 12rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #horse-table .surgery { color: var(--danger); }
    #horse-table .dam-priority { color: var(--accent); font-weight: 600; }

    #horse-table .links a {
      margin-right: 0.35rem;
      font-size: 0.75rem;
    }

    /* <td> 自体を flex にするとテーブルの縦位置計算が壊れるので、必ず内側の div に当てる */
    #horse-table .eval-cell {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    #horse-table .rating-select {
      font: inherit;
      font-size: 0.8125rem;
      padding: 0.2rem 0.3rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--text);
    }
    #horse-table .favorite-btn {
      font-size: 0.9rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      width: 1.7rem;
      height: 1.7rem;
      cursor: pointer;
      color: var(--border);
      line-height: 1;
      flex: none;
    }
    #horse-table .favorite-btn[aria-pressed='true'] {
      color: var(--accent);
      border-color: var(--accent);
    }
    #horse-table .skip-label {
      display: flex;
      align-items: center;
      gap: 0.2rem;
      color: var(--muted);
    }
    /* ---- メモ列（評価の隣・2026-08-25） ----
       セルの中はアイコンと入力欄の排他表示。既定はアイコンだけで、`is-open` が付いた
       セルだけ入力欄に入れ替わる。列ごと消していたころ（〜2026-08-24）と違い列は常に出す
       ―― 空欄の馬でもアイコンを押せば書き始められるようにするため。
       アイコンだけのときの列幅は1文字ぶんなので、出したままでも表はほとんど広がらない。 */
    #horse-table .memo-col { white-space: nowrap; }
    #horse-table .memo-flag {
      position: relative;
      font-size: 0.875rem;
      line-height: 1;
      padding: 0.2rem 0.25rem;
      background: transparent;
      border: none;
      cursor: pointer;
    }
    #horse-table .memo-flag:hover { background: var(--accent-weak); border-radius: 4px; }
    /* メモが入っている馬だけ通知ドットを付ける。アイコン自体は空の馬にも出しているので、
       「押せる場所」と「中身がある馬」をこの点で描き分ける。 */
    #horse-table .memo-flag[data-has-memo='true']::after {
      content: '';
      position: absolute;
      top: 0.05rem;
      right: 0.05rem;
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: var(--accent);
      /* 隣の文字と地続きに見えないよう、行の背景色で細く縁取る */
      box-shadow: 0 0 0 1px var(--surface);
    }
    /* アイコン⇔入力欄の排他表示。開いているセルだけ入力欄を出す。 */
    #horse-table .memo-col .memo-input { display: none; }
    #horse-table .memo-col.is-open .memo-flag { display: none; }
    #horse-table .memo-col.is-open .memo-input { display: inline-block; }

    #horse-table .memo-input {
      font: inherit;
      font-size: 0.8125rem;
      padding: 0.25rem 0.4rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--text);
      width: 11rem;
    }
    #horse-table tr[data-skip='true'] { opacity: 0.4; }

    /* 馬名セルに重ねてある SP 用の行は、広い画面では列として並んでいるので出さない */
    #horse-table .sp-no,
    #horse-table .sp-line { display: none; }

    /* ---- 狭い画面（SP）: 1行を3行ぶんの高さにして、馬の素性を左端にまとめる ----
       表は横スクロールのまま（本人の指示）。ただし No・父・母父・性・厩舎は
       画面幅の外に出てしまい、スクロールしないと分からなかった。左端に固定される
       馬名セルへこの5つをまとめ、元の列は重複するので隠す。
       結果として、横スクロールで測尺（体高〜馬体重）まで届く距離も短くなる。 */
    @media (max-width: 40rem) {
      #horse-table .sp-no {
        display: inline;
        color: var(--muted);
        margin-right: 0.2rem;
      }
      #horse-table .sp-line {
        display: block;
        font-size: 0.6875rem;
        font-weight: 400;
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
      }
      /* 馬名セルにまとめた列（No・父・母父・性・厩舎）は隠す。
         並べ替えは見出しのボタンだけで行うので、隠した5列はSPでは並べ替えられなくなる
         （本人了承済み・2026-08-23。SP専用の並び替えバーは元のUIに戻すため取りやめた）。
         列番号は COLUMNS の並び順に対応する（メモを4列目に移したぶん、以前の 5/6/7/15 から
         1つずつ後ろにずれている。horse-row.test.ts に番号を突き合わせるテストがある）。 */
      #horse-table th:nth-child(1),
      #horse-table td:nth-child(1),
      #horse-table th:nth-child(6),
      #horse-table td:nth-child(6),
      #horse-table th:nth-child(7),
      #horse-table td:nth-child(7),
      #horse-table th:nth-child(8),
      #horse-table td:nth-child(8),
      #horse-table th:nth-child(16),
      #horse-table td:nth-child(16) { display: none; }
      /* 3行になるぶん、行の高さを稼ぐ余白は上下に薄く取る */
      #horse-table td { padding-top: 0.35rem; padding-bottom: 0.35rem; }
      #horse-table td:nth-child(2) { vertical-align: top; }
    }
  </style>

  <script>
    import { horses2025 } from '../../data/horses2025.ts';
    import {
      sortHorses,
      filterHorses,
      type DamPriorityFilter,
      type Sex,
      type SortKey,
      type SortDirection,
      type HorseFilter,
      type RatingFilterValue,
    } from '../../lib/horses.ts';
    import {
      loadEvaluations,
      saveEvaluations,
      getEvaluation,
      updateEvaluation,
      ratingsByHorseId,
      storageKeyForYear,
      type Evaluation,
      type EvaluationMap,
    } from '../../lib/evaluations.ts';
    // 行のマークアップはビルド時と共有する。ここで別に組み立てると二重管理になり、
    // 初期HTML（＝クローラーが見る内容）と描き直した後の表がずれる。
    import { COLUMNS, horseRowHtml } from '../../lib/horse-row.ts';
    import { queueEvaluationSync } from '../../lib/evaluation-client.ts';
    import { EVALUATIONS_RESTORED_EVENT } from '../../lib/sync.ts';
    import {
      countActiveFilters,
      filterStorageKeyForYear,
      loadFilterState,
      parseMultiValue,
      saveFilterState,
      serializeMultiValue,
      type FilterState,
    } from '../../lib/filter-state.ts';
    // 表示の切り替え（メモ列を出すか）は絞り込み条件とは別に覚える。混ぜると
    // 「N件の条件」に数えられ、「条件をクリア」でも消えてしまうため（view-options.ts参照）。
    import {
      loadShowMemo,
      saveShowMemo,
      showMemoStorageKeyForYear,
    } from '../../lib/view-options.ts';

    // frontmatter の定数はクライアント側から参照できないので同じ値をここにも置く
    const DETAIL_BASE_PATH = '/2025/horses/';
    const RECRUIT_YEAR = 2025;

    const table = document.getElementById('horse-table') as HTMLTableElement;
    const tbody = document.getElementById('horse-tbody') as HTMLTableSectionElement;
    const resultCount = document.getElementById('result-count') as HTMLElement;
    const sortButtons = document.querySelectorAll<HTMLButtonElement>('.sort-btn');

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const filterName = el<HTMLInputElement>('filter-name');
    const filterBms = el<HTMLInputElement>('filter-bms');
    const filterStable = el<HTMLSelectElement>('filter-stable');
    const filterPriceMin = el<HTMLInputElement>('filter-price-min');
    const filterPriceMax = el<HTMLInputElement>('filter-price-max');
    const filterHeightMin = el<HTMLInputElement>('filter-height-min');
    const filterHeightMax = el<HTMLInputElement>('filter-height-max');
    const filterCaretMin = el<HTMLInputElement>('filter-caret-min');
    const filterCaretMax = el<HTMLInputElement>('filter-caret-max');
    const filterWeightMin = el<HTMLInputElement>('filter-weight-min');
    const filterWeightMax = el<HTMLInputElement>('filter-weight-max');
    const filterDamAgeMin = el<HTMLInputElement>('filter-dam-age-min');
    const filterDamAgeMax = el<HTMLInputElement>('filter-dam-age-max');
    // 母優先は「すべて / あり / なし」の3択（空値＝すべて）。他のセレクトと同じ扱いにする。
    const filterDamPriority = el<HTMLSelectElement>('filter-dam-priority');
    const filterExcludeSurgery = el<HTMLInputElement>('filter-exclude-surgery');
    const filterHideSkip = el<HTMLInputElement>('filter-hide-skip');
    const filterFavoriteOnly = el<HTMLInputElement>('filter-favorite-only');
    const filterResetBtn = el<HTMLButtonElement>('filter-reset');
    // 絞り込みは既定で畳んでいるので、効いている条件の数を見出し（summary）に出す
    const filterActiveCount = el<HTMLElement>('filter-active-count');
    // A〜E＋未評価。個別にidを振らず、値（value）をそのままフィルタ条件に使う
    const ratingCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-rating'));
    // 父・性別も同じく値をそのまま条件に使うチェックボックス群（複数選択）。
    // 保存は「群のid → 選んだ値をカンマで繋いだ1つの文字列」にしてあるので、1つしか選べない
    // <select> だったころの保存データ（値が1つだけの文字列）もそのまま復元できる。
    const SIRE_FILTER_KEY = 'filter-sire';
    const SEX_FILTER_KEY = 'filter-sex';
    const sireCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-sire'));
    const sexCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-sex'));
    // 父のチェックリストは畳んであるので、選んだ数を見出しに出す
    const sireDetails = document.getElementById('filter-sire-details') as HTMLDetailsElement;
    const sireState = el<HTMLElement>('filter-sire-state');

    const checkedValues = (boxes: HTMLInputElement[]) =>
      boxes.filter((c) => c.checked).map((c) => c.value);
    // 絞り込みではなく表示の切り替え（全頭ぶんのメモ欄をまとめて開く）。表のすぐ上に置いてある。
    const showMemoToggle = el<HTMLInputElement>('toggle-show-memo');

    const textInputs = [filterName, filterBms, filterDamAgeMin, filterDamAgeMax, filterPriceMin, filterPriceMax, filterHeightMin, filterHeightMax, filterCaretMin, filterCaretMax, filterWeightMin, filterWeightMax];
    const selects = [filterStable, filterDamPriority];
    // 評価・父・性別のチェックボックスもここに混ぜる。listener登録と「条件をクリア」の
    // 対象が同じで済む。
    const toggles = [
      filterExcludeSurgery,
      filterHideSkip,
      filterFavoriteOnly,
      ...ratingCheckboxes,
      ...sireCheckboxes,
      ...sexCheckboxes,
    ].filter((t): t is HTMLInputElement => t !== null);

    let sortKey: SortKey = 'id';
    let sortDirection: SortDirection = 'asc';
    // 保存キーは募集年ごとに分ける。ルート（2026年）と共有すると、馬IDが年ごとに1から
    // 振り直される都合で別の馬の評価が出てしまう。2025年は従来どおりのキーを使い続ける。
    const storageKey = storageKeyForYear(2025);
    let evaluations: EvaluationMap = loadEvaluations(window.localStorage, storageKey);

    // 評価・父・性別のチェックボックスは value で見分けるのでidを持たない（群としてまとめて
    // 保存する）。条件の保存はidを鍵にするので、idを持つチェックだけ分けておく。
    const namedToggles = toggles.filter((t) => t.id !== '');
    const filterDetails = document.querySelector('.filter-details') as HTMLDetailsElement;
    // 絞り込み条件の保存キーも評価と同じく年度ごとに分ける（父の選択肢も頭数も年で違うため、
    // 共有すると別の年の条件が復元されて頭数が合わなくなる）。
    const filterStorageKey = filterStorageKeyForYear(RECRUIT_YEAR);

    /** 今の入力内容を保存用の形にまとめる。 */
    function currentFilterState(): FilterState {
      const values: Record<string, string> = {};
      for (const input of [...textInputs, ...selects]) {
        if (input.value.trim() !== '') values[input.id] = input.value;
      }
      // 複数選択は「1つの絞り込み」として1項目にまとめる（父を5つ選んでも条件は1件）
      const sires = checkedValues(sireCheckboxes);
      if (sires.length > 0) values[SIRE_FILTER_KEY] = serializeMultiValue(sires);
      const sexes = checkedValues(sexCheckboxes);
      if (sexes.length > 0) values[SEX_FILTER_KEY] = serializeMultiValue(sexes);
      const toggleState: Record<string, boolean> = {};
      for (const toggle of namedToggles) {
        if (toggle.checked) toggleState[toggle.id] = true;
      }
      return {
        values,
        toggles: toggleState,
        ratings: selectedRatings(),
        sortKey,
        sortDirection,
      };
    }

    /**
     * 保存しておいた条件を入力欄に戻す。
     * 知らないidや、その年に無くなった父・厩舎の値は入らない（`value` に無い値は空になる）ので、
     * 古い保存データが残っていても条件が化けたまま残ることはない。
     */
    function applyFilterState(state: FilterState) {
      for (const input of [...textInputs, ...selects]) input.value = state.values[input.id] ?? '';
      for (const toggle of namedToggles) toggle.checked = state.toggles[toggle.id] === true;
      for (const checkbox of ratingCheckboxes) checkbox.checked = state.ratings.includes(checkbox.value);
      const sires = parseMultiValue(state.values[SIRE_FILTER_KEY]);
      for (const checkbox of sireCheckboxes) checkbox.checked = sires.includes(checkbox.value);
      const sexes = parseMultiValue(state.values[SEX_FILTER_KEY]);
      for (const checkbox of sexCheckboxes) checkbox.checked = sexes.includes(checkbox.value);
      sortKey = state.sortKey;
      sortDirection = state.sortDirection;
    }

    function numberValue(input: HTMLInputElement): number | undefined {
      return input.value === '' ? undefined : Number(input.value);
    }

    function currentFilter(): HorseFilter {
      const filter: HorseFilter = {};
      if (filterName.value.trim()) filter.name = filterName.value.trim();
      if (filterBms.value.trim()) filter.broodmareSire = filterBms.value.trim();
      if (filterStable.value) filter.stable = filterStable.value;
      // 父・性別は複数選択。1つも選んでいないときは条件自体を積まない（＝全頭表示のまま）。
      const sires = checkedValues(sireCheckboxes);
      if (sires.length > 0) filter.sires = sires;
      const sexes = checkedValues(sexCheckboxes);
      if (sexes.length > 0) filter.sexes = sexes as Sex[];
      filter.minDamAge = numberValue(filterDamAgeMin);
      filter.maxDamAge = numberValue(filterDamAgeMax);
      filter.minPrice = numberValue(filterPriceMin);
      filter.maxPrice = numberValue(filterPriceMax);
      filter.minHeight = numberValue(filterHeightMin);
      filter.maxHeight = numberValue(filterHeightMax);
      filter.minCaretGirth = numberValue(filterCaretMin);
      filter.maxCaretGirth = numberValue(filterCaretMax);
      filter.minWeight = numberValue(filterWeightMin);
      filter.maxWeight = numberValue(filterWeightMax);
      if (filterDamPriority.value) filter.damPriority = filterDamPriority.value as DamPriorityFilter;
      if (filterExcludeSurgery.checked) filter.excludeSurgery = true;
      // 自分の評価は端末ごとの状態なので、Horse ではなく「馬ID→印」の対応表として渡す。
      // 1つも選んでいないときは条件自体を積まない（＝全頭表示のまま）。
      const ratings = selectedRatings();
      if (ratings.length > 0) {
        filter.ratings = ratings;
        filter.ratingByHorseId = ratingsByHorseId(evaluations);
      }
      return filter;
    }

    function selectedRatings(): RatingFilterValue[] {
      return ratingCheckboxes.filter((c) => c.checked).map((c) => c.value as RatingFilterValue);
    }

    /**
     * 入っている条件の数を数えて summary に出す。
     * 絞り込みを畳んだまま条件が効いていると、頭数が減った理由が画面から読み取れないため。
     * 0件のときは何も出さない（既定＝全頭表示に余計な装飾を足さない）。
     */
    function updateActiveFilterCount(state: FilterState) {
      const count = countActiveFilters(state);
      filterActiveCount.hidden = count === 0;
      filterActiveCount.textContent = count === 0 ? '' : `${count}件の条件`;
    }

    /**
     * 父のチェックリストは畳んだままでも使えるので、選んだ数を見出しに出す。
     * 0件のときは「すべて」＝絞っていないことを言葉で出す（空欄だと未設定か読み取れない）。
     */
    function updateSireSummary() {
      const count = checkedValues(sireCheckboxes).length;
      sireState.textContent = count === 0 ? 'すべて' : `${count}件選択`;
    }

    function render() {
      let list = filterHorses(horses2025, currentFilter());
      // 評価はユーザーごとの状態なので、客観データのフィルタとは分けてここで適用する
      if (filterHideSkip.checked) {
        list = list.filter((h) => !getEvaluation(evaluations, h.id).skip);
      }
      if (filterFavoriteOnly.checked) {
        list = list.filter((h) => getEvaluation(evaluations, h.id).favorite);
      }
      list = sortHorses(list, sortKey, sortDirection);

      tbody.innerHTML =
        list.length === 0
          ? `<tr><td colspan="${COLUMNS.length}">条件に一致する馬がいません。</td></tr>`
          : list
              .map((h) => horseRowHtml(h, getEvaluation(evaluations, h.id), DETAIL_BASE_PATH))
              .join('');
      resultCount.textContent = `${list.length} / ${horses2025.length} 頭`;
      // 行を作り直すとメモ欄の開閉状態も消えるので、一括表示がONのときだけ開き直す
      // （個別に開いていた行は閉じた状態に戻る）。
      if (showMemoToggle.checked) applyShowMemo(true);

      // 次に開いたときも同じ条件で見られるように、条件と並び順をこの端末に覚えさせる。
      // 保存先は localStorage だけで、サーバーには送らない（filter-state.ts のコメント参照）。
      const state = currentFilterState();
      updateActiveFilterCount(state);
      updateSireSummary();
      saveFilterState(window.localStorage, filterStorageKey, state);

      for (const btn of sortButtons) {
        const active = btn.dataset.sortKey === sortKey;
        btn.setAttribute('data-active', String(active));
        const label = btn.textContent!.replace(/\s*[▲▼]$/u, '');
        btn.textContent = active ? `${label} ${sortDirection === 'asc' ? '▲' : '▼'}` : label;
      }
    }

    /**
     * localStorage（正本）に保存し、同じ内容を端末間同期のキューへ回す。
     * 送信は evaluation-client 側で少しまとめられ、失敗しても握りつぶされる
     * （手元の表示は常に localStorage の内容なので、通信状況に左右されない）。
     */
    function persistEvaluation(horseId: string, patch: Partial<Evaluation>) {
      evaluations = updateEvaluation(evaluations, horseId, patch);
      saveEvaluations(window.localStorage, storageKey, evaluations);
      queueEvaluationSync(RECRUIT_YEAR, horseId, getEvaluation(evaluations, horseId));
    }

    for (const btn of sortButtons) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sortKey as SortKey;
        if (sortKey === key) {
          sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
          sortKey = key;
          sortDirection = 'asc';
        }
        render();
      });
    }

    for (const input of textInputs) input.addEventListener('input', render);
    for (const select of selects) select.addEventListener('change', render);
    for (const toggle of toggles) toggle.addEventListener('change', render);

    /**
     * メモの一括開閉。全行のメモ欄に `is-open` を付け外しするだけで、行のHTMLには
     * 手を入れない（メモの中身はDOMに残るので、閉じても入力途中の内容が消えない）。
     *
     * 個別に開いた行も一括OFFでまとめて閉じる（開閉状態を2か所で持たない）。
     * 覚えておくのはこのチェックボックスのON/OFFだけで、個別に開いた行は再描画・再読み込みで
     * 閉じた状態に戻る。保存先は絞り込みとは別キー（view-options.ts のコメント参照）。
     */
    const showMemoStorageKey = showMemoStorageKeyForYear(RECRUIT_YEAR);
    function applyShowMemo(show: boolean) {
      for (const cell of table.querySelectorAll<HTMLTableCellElement>('tbody td.memo-col')) {
        cell.classList.toggle('is-open', show);
      }
    }
    showMemoToggle.addEventListener('change', () => {
      applyShowMemo(showMemoToggle.checked);
      saveShowMemo(window.localStorage, showMemoStorageKey, showMemoToggle.checked);
    });

    filterResetBtn.addEventListener('click', () => {
      for (const input of textInputs) input.value = '';
      for (const select of selects) select.value = '';
      for (const toggle of toggles) toggle.checked = false;
      render();
    });

    // 評価UIの変更はイベント委譲で拾う（再描画のたびに listener を付け直さなくて済む）。
    // メモ欄は blur を待たず入力のたびに保存する（'change' は blur/Enter まで発火しないため、
    // 入力途中で離脱するとメモが失われてしまう）。
    tbody.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (target.getAttribute('data-field') !== 'memo') return;
      const row = target.closest('tr[data-horse-id]') as HTMLTableRowElement | null;
      if (!row) return;
      const memo = (target as HTMLInputElement).value;
      persistEvaluation(row.dataset.horseId!, { memo });
      // 閉じたあとも有無が分かるよう、同じセルのアイコンの印もその場で追随させる
      // （行は描き直さないので、ここで更新しないと次の再描画まで印が付かない）。
      const flag = row.querySelector('.memo-flag') as HTMLElement | null;
      if (flag) {
        flag.dataset.hasMemo = String(memo !== '');
        flag.title = memo ? `メモ: ${memo}` : '';
      }
    });

    tbody.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      const row = target.closest('tr[data-horse-id]') as HTMLTableRowElement | null;
      if (!row) return;
      const horseId = row.dataset.horseId!;
      const field = target.getAttribute('data-field');

      if (field === 'rating') {
        const value = (target as HTMLSelectElement).value;
        // 背景色はCSSの [data-rating] で当てているので、選択のたびに属性も更新する
        target.setAttribute('data-rating', value);
        const rating = value ? (value as Evaluation['rating']) : null;
        persistEvaluation(horseId, { rating });
        // 評価で絞り込んでいる最中に印を変えると、その馬が条件から外れる（入る）ので描き直す。
        // 消・★のトグルと同じ扱い。
        if (selectedRatings().length > 0) render();
      } else if (field === 'skip') {
        const checked = (target as HTMLInputElement).checked;
        persistEvaluation(horseId, { skip: checked });
        row.dataset.skip = String(checked);
        if (filterHideSkip.checked) render();
      }
    });

    tbody.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const field = target.getAttribute('data-field');
      const row = target.closest('tr[data-horse-id]') as HTMLTableRowElement | null;
      if (!row) return;

      if (field === 'favorite') {
        const pressed = target.getAttribute('aria-pressed') === 'true';
        target.setAttribute('aria-pressed', String(!pressed));
        persistEvaluation(row.dataset.horseId!, { favorite: !pressed });
        if (filterFavoriteOnly.checked) render();
      } else if (field === 'memo-toggle') {
        // 📝を押した行だけメモ欄に入れ替えて、そのまま打てるようにフォーカスまで移す。
        const cell = target.closest('td.memo-col') as HTMLTableCellElement | null;
        if (!cell) return;
        cell.classList.add('is-open');
        (cell.querySelector('.memo-input') as HTMLInputElement | null)?.focus();
      }
    });

    /**
     * 開いたメモ欄は、そこから離れたら閉じてアイコンに戻す（他の列が押し出されたままに
     * ならないように）。アイコンは開くと隠れるので、閉じる操作はここに寄せている。
     * 一括で開いているあいだは閉じない（チェックボックスの状態と食い違わせない）。
     */
    tbody.addEventListener('focusout', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList?.contains('memo-input')) return;
      if (showMemoToggle.checked) return;
      target.closest('td.memo-col')?.classList.remove('is-open');
    });

    // Enter / Escape でも閉じられるようにする（書き終わりにマウスへ戻らなくて済む）。
    // 中身は打鍵のたびに保存済みなので、どちらで閉じてもメモは残る。
    tbody.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList?.contains('memo-input')) return;
      if (e.key !== 'Escape' && e.key !== 'Enter') return;
      target.blur();
    });

    // 同期パネルが別の端末の評価を取り込むと localStorage だけが新しくなる。
    // この表はメモリ上のマップを持っているので、合図を受けて読み直す。
    document.addEventListener(EVALUATIONS_RESTORED_EVENT, () => {
      evaluations = loadEvaluations(window.localStorage, storageKey);
      render();
    });

    // 前回の絞り込み・並び順を戻してから描く（毎回入れ直さなくて済むように）。
    // 条件が入っているときは絞り込みを開いた状態にする。畳んだままだと、頭数が減っている
    // 理由が「前回の条件が残っているから」だと画面から読み取れないため。
    const restoredState = loadFilterState(window.localStorage, filterStorageKey);
    applyFilterState(restoredState);
    if (countActiveFilters(restoredState) > 0) filterDetails.open = true;
    // 父も同じ理由で開く。「3件選択」だけ見えてもどの父かが分からないため。
    if (checkedValues(sireCheckboxes).length > 0) sireDetails.open = true;

    // メモを一括で開いていたかも前回のままにする（既定は閉じてアイコンだけ）。
    // 実際に開くのは直後の render()（行を作り直したあとに開き直す）。
    showMemoToggle.checked = loadShowMemo(window.localStorage, showMemoStorageKey);

    // 初期HTMLは未評価の状態なので、保存済みの評価を反映するために一度描き直す。
    render();
  </script>
</BaseLayout>
